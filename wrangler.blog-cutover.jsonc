// Prepared configuration only. Do not deploy this file until the Medium
// custom-domain detachment and blog cutover have been explicitly approved.
{
	"name": "tinkercademy-dot-com",
	"main": "./worker.mjs",
	"account_id": "b8b1032c61d9475cd00229c74db7ec72",
	"compatibility_date": "2026-04-22",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "tinkercademy.com", "custom_domain": true },
		{ "pattern": "blog.tinkercademy.com", "custom_domain": true }
	]
}
