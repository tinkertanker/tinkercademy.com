---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getSiteData } from '../lib/data.js';

const site = getSiteData();
const {
	title = site.siteSettings?.default_seo?.title ?? 'Tinkercademy',
	description = site.siteSettings?.default_seo?.description ?? '',
	canonical = null,
	image = site.siteSettings?.default_seo?.openGraph?.image ?? null,
	ogType = 'website',
	noindex = false,
	/* Optional LCP hero image preload: { src, srcset?, sizes? } */
	preloadHero = null,
} = Astro.props;

const siteUrl = site.siteSettings?.base_url ?? Astro.site?.href ?? 'https://tinkercademy.com';
const gaMeasurementId = 'G-8PXL6RTPR4';
const socialLinks = (site.socialLinks ?? []) as Array<{ url?: unknown }>;

/* og:image must be an absolute URL for social previews. Resolve relative
   paths against the canonical URL when available, else the site setting. */
const ogImageBase = canonical ?? Astro.site?.href ?? site.siteSettings?.base_url;
let ogImage: string | null = null;
if (image) {
	ogImage = /^https?:\/\//i.test(image) || !ogImageBase
		? image
		: new URL(image, ogImageBase).toString();
}

const siteName = site.siteSettings?.site_name ?? 'Tinkercademy';
const twitterCard = ogImage ? 'summary_large_image' : 'summary';
const organisationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: siteName,
	url: siteUrl,
	logo: new URL('/favicon.png', siteUrl).toString(),
	sameAs: socialLinks
		.map((link) => link?.url)
		.filter((url): url is string => typeof url === 'string' && /^https?:\/\//i.test(url)),
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		{noindex && <meta name="robots" content="noindex,nofollow" />}

		<link rel="preconnect" href="https://www.googletagmanager.com" />
		<link rel="dns-prefetch" href="https://www.google-analytics.com" />

		{/* Above-the-fold fonts (headings + body); the rest load on demand. */}
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/s/ibmplexserif/v20/ibm-plex-serif-500-latin.woff2"
			crossorigin
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/s/rubik/v31/iJWZBXyIfDnIV5PNhY1KTN7Z-Yh-B4i1VU80V4bVkA.woff2"
			crossorigin
		/>

		{preloadHero && (
			<link
				rel="preload"
				as="image"
				href={preloadHero.src}
				imagesrcset={preloadHero.srcset}
				imagesizes={preloadHero.sizes}
				fetchpriority="high"
			/>
		)}

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}

		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
		<link rel="alternate icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
		<script is:inline define:vars={{ gaMeasurementId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', gaMeasurementId);
		</script>
		<script is:inline type="application/ld+json" set:html={JSON.stringify(organisationSchema)}></script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<SiteHeader navigation={site.siteSettings?.navigation ?? []} />
		<main id="main-content" tabindex="-1">
			<slot />
		</main>
		<SiteFooter
			contacts={site.contacts}
			locations={site.locations}
			socialLinks={site.socialLinks ?? []}
		/>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'IBM Plex Serif';
		font-style: normal;
		font-weight: 500;
		font-display: swap;
		src: url('/fonts/s/ibmplexserif/v20/ibm-plex-serif-500-latin.woff2') format('woff2');
	}

	@font-face {
		font-family: 'IBM Plex Serif';
		font-style: normal;
		font-weight: 600;
		font-display: swap;
		src: url('/fonts/s/ibmplexserif/v20/ibm-plex-serif-600-latin.woff2') format('woff2');
	}

	@font-face {
		font-family: 'Lora Ampersand';
		font-style: normal;
		font-weight: 500;
		font-display: swap;
		src: url('/fonts/s/lora/v37/lora-italic-500-ampersand.woff2') format('woff2');
		unicode-range: U+0026;
		size-adjust: 95%;
	}

	@font-face {
		font-family: 'Rubik';
		font-style: normal;
		font-weight: 400;
		font-display: swap;
		src: url('/fonts/s/rubik/v31/iJWZBXyIfDnIV5PNhY1KTN7Z-Yh-B4i1VU80V4bVkA.woff2') format('woff2');
	}

	@font-face {
		font-family: 'Rubik';
		font-style: normal;
		font-weight: 500;
		font-display: swap;
		src: url('/fonts/s/rubik/v31/iJWZBXyIfDnIV5PNhY1KTN7Z-Yh-NYiFV0U1.woff2') format('woff2');
	}

	@font-face {
		font-family: 'Rubik';
		font-style: normal;
		font-weight: 600;
		font-display: swap;
		src: url('/fonts/s/rubik/v31/iJWZBXyIfDnIV5PNhY1KTN7Z-Yh-2Y-1VU80V4bVkA.woff2') format('woff2');
	}

	@font-face {
		font-family: 'Rubik';
		font-style: normal;
		font-weight: 700;
		font-display: swap;
		src: url('/fonts/s/rubik/v31/iJWZBXyIfDnIV5PNhY1KTN7Z-Yh-4I-1VU80V4bVkA.woff2') format('woff2');
	}

	@font-face {
		font-family: 'Rubik';
		font-style: italic;
		font-weight: 400 700;
		font-display: swap;
		src: url('/fonts/s/rubik/v31/iJWEBXyIfDnIV7nEnX661A.woff2') format('woff2');
	}

	@font-face {
		font-family: 'Fragment Mono';
		font-style: normal;
		font-weight: 400;
		font-display: swap;
		src: url('/fonts/s/fragmentmono/v6/4iCr6K5wfMRRjxp0DA6-2CLnN4FNh4UI_1U.woff2') format('woff2');
	}

	:root {
		--accent: #f05d57;
		/* Darkened from #ca433d so accent text on tinted chips and white
		   text on accent-dark buttons both clear WCAG AA (4.5:1). */
		--accent-dark: #bd3a34;
		--heading: 'IBM Plex Serif', Georgia, serif;
		--page-title-font-size: clamp(2rem, 4.5vw, 3.2rem);
		--meta: 'Rubik', sans-serif;
		--text: rgb(51, 51, 51);

		/* Body typography tokens.
		   Any body copy, paragraph, or lead/subtitle should prefer these
		   over hardcoded sizes/line-heights so the shared shell (header,
		   footer, CTA banner, prose) and every page render at the same
		   rhythm. */
		--body-font-size: 1rem;
		--body-line-height: 1.5;
		--body-line-height-tight: 1.35;
		--body-weight: 400;
		--body-weight-medium: 500;
		--lead-font-size: clamp(1rem, 1.4vw, 1.1rem);
		--lead-line-height: 1.6;
	}

	* {
		box-sizing: border-box;
	}

	html {
		font-family: 'Rubik', sans-serif;
		background: #ffffff;
		color: rgb(23, 23, 23);
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}

	.skip-link {
		position: absolute;
		left: 0;
		top: 0;
		padding: 0.6rem 1rem;
		background: rgb(23, 23, 23);
		color: #fff;
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
		border-radius: 0 0 8px 0;
		transform: translateY(-110%);
		transition: transform 0.15s ease;
		z-index: 1000;
	}

	.skip-link:focus {
		transform: translateY(0);
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	main:focus {
		outline: none;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: #ffffff;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		font-weight: var(--body-weight);
	}

	a {
		color: inherit;
	}

	img {
		display: block;
		max-width: 100%;
	}

	.shell {
		width: min(1160px, calc(100vw - 1.5rem));
		margin: 0 auto;
	}

	/* Site-wide: don't shout. Override scoped page styles that set uppercase. */
	h1, h2, h3, h4, h5, h6 {
		text-transform: none !important;
	}

	/* ── Prose (used by sub-pages) ── */
	.prose h1,
	.prose h2,
	.prose h3,
	.prose h4 {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-weight: 500;
	}

	.hero {
		padding: 4rem 0 2.5rem;
	}

	.hero-inner {
		display: grid;
		gap: 1rem;
	}

	.eyebrow,
	.section-label {
		font-family: 'Rubik', sans-serif;
		font-size: 0.82rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent-dark);
	}

	.hero h1 {
		margin: 0;
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 0.95;
		max-width: 12ch;
		text-transform: uppercase;
	}

	.lead {
		max-width: 68ch;
		font-size: 1.15rem;
		line-height: var(--body-line-height);
		color: rgb(110, 110, 110);
	}

	.badge-row {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.badge-row li {
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		background: rgba(240, 93, 87, 0.1);
		color: var(--accent-dark);
		font-size: 0.92rem;
	}

	.prose {
		padding-bottom: 3rem;
	}

	.prose h2,
	.prose h3,
	.prose h4 {
		margin-top: 2rem;
		margin-bottom: 0.5rem;
	}

	.prose p,
	.prose li {
		max-width: 70ch;
		line-height: var(--body-line-height);
	}

	.prose ul {
		padding-left: 1.2rem;
	}

	.rich-content {
		display: grid;
		gap: 2rem;
	}

	.content-image img {
		border-radius: 1.25rem;
		border: 1px solid rgba(0, 0, 0, 0.08);
		background: #ffffff;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
		padding-bottom: 3rem;
	}

	.card {
		padding: 1.25rem;
		border-radius: 1.25rem;
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(0, 0, 0, 0.08);
		text-decoration: none;
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
	}

	.card h3 {
		margin: 0 0 0.5rem;
	}

	.card p {
		margin: 0;
		color: rgb(110, 110, 110);
		line-height: var(--body-line-height);
	}

	.section {
		padding-bottom: 3rem;
	}

	.section-title {
		margin: 0 0 1rem;
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 2rem;
		font-weight: 500;
		text-transform: uppercase;
	}
</style>
