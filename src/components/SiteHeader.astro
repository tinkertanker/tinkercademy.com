---
import { toSiteHref } from '../lib/links.js';
import { LOGO_BLACK, LOGO_BLACK_SIZE } from '../lib/site-media.js';

type NavLink = { label: string; href: string; hasDropdown?: boolean };

const props = Astro.props as { navigation?: NavLink[] };
const rawNav = props.navigation ?? [];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

/* Inject "COURSES" as first nav item with a dropdown chevron if not already present */
const coursesItem: NavLink = { label: 'COURSES', href: '/courses-all/', hasDropdown: true };
const navigation: NavLink[] = rawNav.some((n) => n.label.toUpperCase() === 'COURSES')
	? rawNav
	: [coursesItem, ...rawNav];

/* Dropdown sub-links for COURSES */
const coursesDropdown = [
	{ label: 'All Courses', href: '/courses-all/' },
	{ label: 'Professionals', href: '/professionals/' },
	{ label: 'Schools', href: '/schools/' },
	{ label: 'Individuals', href: '/individuals/' },
	{ label: 'Micro:Bit', href: '/microbit/' },
	{ label: 'Tinker X', href: '/tinker-x/' },
	{ label: 'Infocomm Club', href: '/infocomm-club/' },
];

const coursePaths = new Set(coursesDropdown.map((item) => normalisePath(item.href)).concat([
	'/courses',
	'/courses-professionals',
	'/courses-schools',
]));

function normalisePath(href: string) {
	return toSiteHref(href).replace(/\/$/, '') || '/';
}

function isExternalLink(href: string) {
	return toSiteHref(href) === href && /^https?:\/\//.test(href);
}

function isActiveLink(href: string) {
	const path = normalisePath(href);
	if (path === '/courses-all') {
		return coursePaths.has(currentPath);
	}
	return currentPath === path;
}

function toNavHref(href: string) {
	const siteHref = toSiteHref(href);
	if (
		siteHref === '/' ||
		siteHref.startsWith('#') ||
		!siteHref.startsWith('/') ||
		/[?#]/.test(siteHref) ||
		/\.[^/]+$/.test(siteHref)
	) {
		return siteHref;
	}
	return siteHref.endsWith('/') ? siteHref : `${siteHref}/`;
}
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/">
			<img
				src={LOGO_BLACK}
				alt="Tinkercademy"
				class="brand__logo"
				width={LOGO_BLACK_SIZE.width}
				height={LOGO_BLACK_SIZE.height}
			/>
		</a>

		<nav class="nav-desktop" aria-label="Primary">
			<ul>
				{navigation.map((link) => (
					<li class={link.hasDropdown ? 'has-dropdown' : ''}>
						<a
							href={toNavHref(link.href)}
							target={isExternalLink(link.href) ? '_blank' : undefined}
							rel={isExternalLink(link.href) ? 'noopener' : undefined}
							class:list={{ 'is-active': isActiveLink(link.href) }}
							aria-current={isActiveLink(link.href) ? 'page' : undefined}
						>
							{link.label}
							{isExternalLink(link.href) && (
								<svg class="nav-external" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M7 17L17 7M17 7H7M17 7V17"/>
								</svg>
							)}
							{link.hasDropdown && (
								<svg class="nav-chevron" width="10" height="10" viewBox="0 0 10 10" fill="currentColor">
									<path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							)}
						</a>
						{link.hasDropdown && (
							<ul class="dropdown">
								{coursesDropdown.map((sub) => (
									<li><a href={toNavHref(sub.href)}>{sub.label}</a></li>
								))}
							</ul>
						)}
					</li>
				))}
			</ul>
		</nav>

		<button type="button" class="nav-search" aria-label="Open search" aria-expanded="false" aria-controls="site-search-overlay">
			<svg viewBox="0 0 256 256" width="18" height="18" fill="currentColor" aria-hidden="true">
				<path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z" />
			</svg>
		</button>

		<button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
			<span class="nav-toggle__bar"></span>
			<span class="nav-toggle__bar"></span>
			<span class="nav-toggle__bar"></span>
		</button>
	</div>

	<nav class="nav-mobile" aria-label="Primary mobile" hidden>
		<ul>
			{navigation.map((link) => (
				<li class={link.hasDropdown ? 'has-dropdown-mobile' : ''}>
					{link.hasDropdown ? (
						<button class="mobile-dropdown-toggle" type="button">
							{link.label}
							<svg class="nav-chevron" width="10" height="10" viewBox="0 0 10 10" fill="currentColor">
								<path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</button>
					) : (
						<a
							href={toNavHref(link.href)}
							target={isExternalLink(link.href) ? '_blank' : undefined}
							rel={isExternalLink(link.href) ? 'noopener' : undefined}
							class:list={{ 'is-active': isActiveLink(link.href) }}
							aria-current={isActiveLink(link.href) ? 'page' : undefined}
						>
							{link.label}
							{isExternalLink(link.href) && (
								<svg class="nav-external" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M7 17L17 7M17 7H7M17 7V17"/>
								</svg>
							)}
						</a>
					)}
					{link.hasDropdown && (
						<ul class="mobile-dropdown" hidden>
							{coursesDropdown.map((sub) => (
								<li><a href={toNavHref(sub.href)}>{sub.label}</a></li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
	</nav>

	<div
		class="search-overlay"
		id="site-search-overlay"
		hidden
		role="dialog"
		aria-modal="true"
		aria-label="Search programmes"
	>
		<button type="button" class="search-overlay__backdrop" tabindex="-1" aria-label="Close search" data-search-close />
		<div class="search-overlay__panel shell">
			<div class="search-overlay__top">
				<label class="search-overlay__field" for="site-search-input">
					<svg viewBox="0 0 256 256" width="22" height="22" fill="currentColor" aria-hidden="true">
						<path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z" />
					</svg>
					<input
						id="site-search-input"
						type="search"
						placeholder="Search"
						autocomplete="off"
						data-site-search-input
					/>
				</label>
				<button type="button" class="search-overlay__close" data-search-close aria-label="Close search">
					<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
						<path d="M208.49,191.51a12,12,0,0,1-17,17L128,145,64.49,208.49a12,12,0,0,1-17-17L111,128,47.51,64.49a12,12,0,0,1,17-17L128,111l63.51-63.52a12,12,0,0,1,17,17L145,128Z" />
					</svg>
				</button>
			</div>
			<ul class="search-overlay__results" data-site-search-results></ul>
			<p class="search-overlay__empty" data-site-search-empty hidden>No programmes match that search.</p>
		</div>
	</div>
</header>

<script>
	type ProgrammeSearchEntry = {
		slug: string;
		title: string;
		audienceLabel: string;
		audienceId: string;
		topicLabel: string;
		duration: string;
		searchText: string;
	};

	const SEARCH_INDEX_URL = '/programme-search-index.json';

	const AUDIENCE_COLOURS: Record<string, string> = {
		students: 'var(--accent-dark)',
		teachers: 'var(--accent-dark)',
		businesses: 'var(--accent-dark)',
		public: 'var(--accent-dark)',
	};

	let programmesCache: ProgrammeSearchEntry[] | null = null;
	let programmesLoad: Promise<ProgrammeSearchEntry[]> | null = null;

	function loadProgrammes(): Promise<ProgrammeSearchEntry[]> {
		if (programmesCache !== null) return Promise.resolve(programmesCache);
		if (!programmesLoad) {
			programmesLoad = fetch(SEARCH_INDEX_URL)
				.then((r) => (r.ok ? r.json() : []))
				.then((data) => {
					const list = Array.isArray(data) ? (data as ProgrammeSearchEntry[]) : [];
					programmesCache = list;
					return list;
				})
				.catch(() => {
					programmesCache = [];
					return programmesCache;
				});
		}
		return programmesLoad;
	}

	function badgeColour(audienceId: string) {
		return AUDIENCE_COLOURS[audienceId] ?? 'var(--accent-dark)';
	}
	const overlay = document.getElementById('site-search-overlay');
	const openBtn = document.querySelector('.nav-search');
	const input = document.querySelector('[data-site-search-input]') as HTMLInputElement | null;
	const resultsEl = document.querySelector('[data-site-search-results]') as HTMLUListElement | null;
	const emptyEl = document.querySelector('[data-site-search-empty]') as HTMLElement | null;

	let previouslyFocusedElement: HTMLElement | null = null;

	function getFocusableElements(container: HTMLElement): HTMLElement[] {
		const sel =
			'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
		return Array.from(container.querySelectorAll<HTMLElement>(sel)).filter((el) => {
			if (el.hasAttribute('hidden')) return false;
			if (el.getAttribute('aria-hidden') === 'true') return false;
			if (el.closest('[hidden]')) return false;
			return true;
		});
	}

	function handleSearchOverlayKeydown(event: KeyboardEvent) {
		if (!overlay || overlay.hidden) return;

		if (event.key === 'Escape') {
			event.preventDefault();
			setOpen(false);
			return;
		}

		if (event.key !== 'Tab') return;

		const focusableElements = getFocusableElements(overlay);
		if (focusableElements.length === 0) {
			event.preventDefault();
			input?.focus();
			return;
		}

		const first = focusableElements[0];
		const last = focusableElements[focusableElements.length - 1];
		const activeElement = document.activeElement;

		if (!overlay.contains(activeElement)) {
			event.preventDefault();
			first.focus();
			return;
		}

		if (event.shiftKey) {
			if (activeElement === first) {
				event.preventDefault();
				last.focus();
			}
			return;
		}

		if (activeElement === last) {
			event.preventDefault();
			first.focus();
		}
	}

	function setOpen(open: boolean) {
		if (!overlay || !openBtn || !(openBtn instanceof HTMLButtonElement)) return;

		if (open) {
			previouslyFocusedElement =
				document.activeElement instanceof HTMLElement ? document.activeElement : openBtn;
		}

		overlay.hidden = !open;
		openBtn.setAttribute('aria-expanded', String(open));
		document.body.style.overflow = open ? 'hidden' : '';

		if (open) {
			requestAnimationFrame(() => {
				const focusTarget = input ?? getFocusableElements(overlay)[0] ?? overlay;
				focusTarget.focus();
			});
			void renderResults(input?.value ?? '');
		} else {
			if (input) {
				input.value = '';
			}
			const focusTarget =
				previouslyFocusedElement && document.contains(previouslyFocusedElement)
					? previouslyFocusedElement
					: openBtn;
			previouslyFocusedElement = null;
			requestAnimationFrame(() => focusTarget.focus());
		}
	}

	async function renderResults(query: string) {
		if (!resultsEl || !emptyEl) return;
		const programmes = await loadProgrammes();
		const q = query.trim().toLowerCase();
		const max = 12;
		let list = programmes;
		if (q) {
			list = programmes.filter((p) => p.searchText.toLowerCase().includes(q));
		}
		const slice = list.slice(0, max);
		resultsEl.innerHTML = '';
		for (const p of slice) {
			const li = document.createElement('li');
			const a = document.createElement('a');
			a.href = `/programmes/${p.slug}/`;
			a.className = 'search-result';
			const badge = document.createElement('span');
			badge.className = 'search-result__badge';
			badge.style.backgroundColor = badgeColour(p.audienceId);
			badge.textContent = p.audienceLabel;
			const title = document.createElement('span');
			title.className = 'search-result__title';
			title.textContent = p.title;
			const meta = document.createElement('span');
			meta.className = 'search-result__meta';
			const parts = [p.topicLabel, p.duration].filter(Boolean);
			meta.textContent = parts.join(' · ');
			a.append(badge, title, meta);
			li.append(a);
			resultsEl.append(li);
			a.addEventListener('click', () => setOpen(false));
		}
		emptyEl.hidden = slice.length > 0 || programmes.length === 0;
	}

	openBtn?.addEventListener('click', async () => {
		const isOpen = overlay && !overlay.hidden;
		if (isOpen) {
			setOpen(false);
			return;
		}
		await loadProgrammes();
		setOpen(true);
	});

	document.querySelectorAll('[data-search-close]').forEach((btn) => {
		btn.addEventListener('click', () => setOpen(false));
	});

	input?.addEventListener('input', () => void renderResults(input.value));

	document.addEventListener('keydown', handleSearchOverlayKeydown);

	/* Hamburger toggle */
	const toggle = document.querySelector('.nav-toggle');
	const mobileNav = document.querySelector('.nav-mobile');
	if (toggle && mobileNav) {
		toggle.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!isOpen));
			(mobileNav as HTMLElement).hidden = isOpen;
		});
	}

	/* Mobile dropdown toggles */
	document.querySelectorAll('.mobile-dropdown-toggle').forEach((btn) => {
		btn.addEventListener('click', () => {
			const submenu = btn.nextElementSibling;
			if (submenu && submenu.classList.contains('mobile-dropdown')) {
				const isOpen = !(submenu as HTMLElement).hidden;
				(submenu as HTMLElement).hidden = isOpen;
				btn.classList.toggle('is-open', !isOpen);
			}
		});
	});
</script>

<style>
	.site-header {
		--nav-font-size: calc(0.8125rem + 1pt);
		position: relative;
		z-index: 20;
		background: rgb(255, 255, 255);
		border-bottom: 1px solid rgb(181, 181, 181);
		box-shadow: 0px 4px 12px 0px rgba(0, 0, 0, 0.05);
		font-family: 'Rubik', sans-serif;
		font-size: 16px;
		line-height: normal;
		color: rgb(23, 23, 23);
		text-rendering: auto;
		-webkit-font-smoothing: auto;
		-moz-osx-font-smoothing: auto;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 1.5rem;
		width: min(1160px, calc(100vw - 1.5rem));
		margin: 0 auto;
		min-height: 64px;
		padding: 0;
	}

	.brand__logo {
		display: block;
		width: 195px;
		height: 29px;
		object-fit: cover;
		object-position: center;
	}

	.brand {
		display: flex;
		align-items: center;
		line-height: 0;
		flex-shrink: 0;
	}

	/* ── Desktop nav ── (direct child only — nested .dropdown must not inherit row flex) */
	.nav-desktop > ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		align-items: center;
		gap: 1.55rem;
	}

	.nav-desktop a {
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: var(--nav-font-size);
		font-weight: 400;
		letter-spacing: 0;
		text-transform: uppercase;
		color: rgb(74, 74, 74);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		line-height: 1.6;
		white-space: nowrap;
		transition: color 0.15s ease;
	}

	/* Narrow desktop band (just above the mobile breakpoint): the full-size
	   nav + logo would otherwise overflow and wrap a long label like
	   "OPEN SOURCE" onto two lines. Tighten the row slightly so it stays on
	   one line without collapsing to the mobile menu. */
	@media (min-width: 810px) and (max-width: 980px) {
		.nav-desktop > ul {
			gap: 0.75rem;
		}
	}

	.nav-desktop a[target="_blank"] {
			gap: 0.2rem;
		}

		.nav-desktop a:hover,
		.nav-desktop a.is-active {
			color: rgb(255, 89, 89);
		}

		.nav-external {
			flex-shrink: 0;
			opacity: 0.6;
		}

		.nav-chevron {
		flex-shrink: 0;
		margin-top: 0;
		color: rgb(170, 170, 170);
		transition: transform 0.2s;
	}

	/* ── Desktop dropdown ──
	   The dropdown sits inside the trigger's <li>, so the <li>'s hover
	   state keeps it open. We extend the trigger's hittable area down
	   to meet the panel (via the header-inner min-height and a gap that
	   belongs to the panel as padding, not margin) so the cursor never
	   crosses "dead space" between trigger and panel. */
	.has-dropdown {
		position: relative;
	}

	.dropdown {
		/* Keep the element in the DOM so the pointer can enter it from
		   the trigger without crossing dead space; toggle visibility and
		   opacity rather than display to avoid a hover/repaint race. */
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		transform: translateY(-4px);
		transition: opacity 0.12s ease, transform 0.12s ease, visibility 0s linear 0.12s;
		position: absolute;
		/* Visually drop the panel 2pt below the trigger's baseline; the
		   ::before rule below extends the hit area back up over the gap
		   so hover doesn't drop on the way down. */
		top: calc(100% + 2pt);
		left: -16px;
		list-style: none;
		margin: 0;
		/* Top padding acts as a "bridge" from the trigger into the menu
		   body — the cursor stays inside the dropdown's hit area the
		   whole way down, so hover never drops between trigger and
		   items. */
		padding: 1rem 0 0.7rem;
		background: #fff;
		border: 1px solid rgb(229, 229, 229);
		border-radius: 14px;
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
		min-width: 232px;
		z-index: 30;
	}

	.dropdown::before {
		/* Invisible bridge covering the 2pt visual gap above the panel.
		   Keeps the cursor inside a hoverable region the entire journey
		   from trigger to first menu item. */
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: -2pt;
		height: 2pt;
	}

	.dropdown li {
		padding: 0;
	}

	.dropdown a {
		display: block;
		padding: 0.6rem 1rem;
		font-size: var(--nav-font-size);
		font-weight: 400;
		white-space: nowrap;
	}

	.dropdown a:hover {
		background: rgb(250, 250, 250);
		color: rgb(255, 89, 89);
	}

	.has-dropdown:hover .dropdown,
	.has-dropdown:focus-within .dropdown {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
		transition: opacity 0.12s ease, transform 0.12s ease, visibility 0s linear 0s;
	}

	.has-dropdown:hover .nav-chevron,
	.has-dropdown:focus-within .nav-chevron {
		transform: rotate(180deg);
	}

	/* ── Search icon ── */
	.nav-search {
		display: flex;
		align-items: center;
		justify-content: center;
		margin-left: 1rem;
		width: 40px;
		height: 40px;
		border: none;
		border-radius: 10px;
		background: none;
		cursor: pointer;
		color: rgb(74, 74, 74);
		transition: color 0.15s;
	}

	.nav-search:hover {
		color: rgb(255, 89, 89);
	}

	/* ── Search overlay ──
	   The overlay markup is rendered by this Astro component, but some
	   inner elements (runtime-generated result rows) don't get Astro's
	   scoped data-astro-cid-* attr.
	   We therefore style those nodes as :global() from here — that keeps
	   these rules in this component's bundle without requiring a scoped
	   attr on runtime-generated nodes. */
	.search-overlay {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}

	.search-overlay[hidden] {
		display: none;
	}

	.search-overlay__backdrop {
		position: absolute;
		inset: 0;
		border: none;
		padding: 0;
		margin: 0;
		background: rgba(10, 10, 14, 0.55);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		cursor: pointer;
	}

	.search-overlay__panel {
		position: relative;
		z-index: 1;
		width: min(720px, calc(100vw - 2rem));
		max-width: 720px;
		margin: clamp(3rem, 10vh, 6rem) auto 2rem;
		padding: 0;
		max-height: min(86vh, 720px);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		overflow: hidden;
		pointer-events: none;
	}

	.search-overlay__panel > * {
		pointer-events: auto;
	}

	.search-overlay__top {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-shrink: 0;
	}

	.search-overlay__field {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.9rem 1.15rem;
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.9);
		border: 1px solid rgba(255, 255, 255, 0.3);
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.18);
		color: rgb(240, 93, 87);
		transition: box-shadow 0.15s ease, border-color 0.15s ease;
	}

	.search-overlay__field:focus-within {
		border-color: rgba(240, 93, 87, 0.5);
		box-shadow: 0 12px 44px rgba(0, 0, 0, 0.22), 0 0 0 3px rgba(240, 93, 87, 0.18);
	}

	.search-overlay__field svg {
		flex-shrink: 0;
	}

	.search-overlay__field input {
		flex: 1;
		border: 0;
