---
/**
 * Unattributed participant quotes, two at a time with previous/next
 * controls. Every quote is in the HTML; the script only hides the ones
 * outside the current pair, so crawlers and no-JS readers see them all.
 */
import testimonials from '../data/testimonials.json';

interface Props {
	set: 'schools' | 'adults';
}

const { set } = Astro.props;
const quotes = testimonials[set];
const PER_PAGE = 2;
const pageCount = Math.ceil(quotes.length / PER_PAGE);
const pages = Array.from({ length: pageCount }, (_, index) => quotes.slice(index * PER_PAGE, (index + 1) * PER_PAGE));
---

{quotes.length > 0 && (
	<section class="quotes" data-quotes aria-roledescription="carousel" aria-label="What people say about our courses">
		<div class="quotes__header">
			<h2 class="quotes__heading">What people say about our courses</h2>
			{pageCount > 1 && (
				<div class="quotes__controls" hidden data-quotes-controls>
					<button type="button" class="quotes__button" data-quotes-prev aria-label="Previous quotes">
						<span aria-hidden="true">←</span>
					</button>
					<span class="quotes__status" aria-live="polite" data-quotes-status>1 / {pageCount}</span>
					<button type="button" class="quotes__button" data-quotes-next aria-label="Next quotes">
						<span aria-hidden="true">→</span>
					</button>
				</div>
			)}
		</div>
		<div class="quotes__list">
			{pages.map((quotes) => (
				<div class="quotes__page" data-quotes-page>
					{quotes.map(({ quote }) => (
						<figure class="quotes__item">
							<blockquote>
								<p>{quote}</p>
							</blockquote>
						</figure>
					))}
				</div>
			))}
		</div>
	</section>
)}

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-quotes]')) {
		const pages = [...root.querySelectorAll<HTMLElement>('[data-quotes-page]')];
		const controls = root.querySelector<HTMLElement>('[data-quotes-controls]');
		const status = root.querySelector<HTMLElement>('[data-quotes-status]');
		const pageCount = pages.length;
		if (!controls || pageCount < 2) continue;

		let page = 0;
		const show = (next: number) => {
			page = (next + pageCount) % pageCount;
			pages.forEach((item, index) => {
				item.hidden = index !== page;
			});
			if (status) status.textContent = `${page + 1} / ${pageCount}`;
		};

		root.querySelector('[data-quotes-prev]')?.addEventListener('click', () => show(page - 1));
		root.querySelector('[data-quotes-next]')?.addEventListener('click', () => show(page + 1));
		root.dataset.quotesReady = '';
		controls.hidden = false;
		show(0);
	}
</script>

<style>
	.quotes {
		margin-top: 2.5rem;
	}

	.quotes__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.quotes__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.35rem;
		font-weight: 500;
		color: var(--theme-heading, rgb(51, 51, 51));
		margin: 0;
	}

	.quotes__controls {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.quotes__controls[hidden] {
		display: none;
	}

	.quotes__button {
		width: 36px;
		height: 36px;
		display: inline-grid;
		place-items: center;
		border: 1px solid var(--theme-control-border, rgba(0, 0, 0, 0.2));
		border-radius: 999px;
		background: transparent;
		color: var(--theme-heading, rgb(51, 51, 51));
		font-size: 1rem;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}

	.quotes__button:hover {
		background: var(--theme-surface-muted, rgb(243, 243, 243));
		border-color: var(--theme-heading, rgb(51, 51, 51));
	}

	.quotes__button:focus-visible {
		outline: 2px solid var(--accent-dark);
		outline-offset: 2px;
	}

	.quotes__status {
		min-width: 3.5em;
		text-align: center;
		font-family: 'Rubik', sans-serif;
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
		color: var(--theme-muted, rgb(90, 90, 90));
	}

	.quotes__list {
		display: grid;
		gap: 1rem;
	}

	.quotes__page {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	/* Overlapping pages size the grid to the tallest pair, including after
	   wrapping or font changes. Without JS, all pages remain in normal flow. */
	[data-quotes-ready] .quotes__page {
		grid-area: 1 / 1;
	}

	.quotes__page[hidden] {
		display: grid;
		visibility: hidden;
	}

	.quotes__item {
		margin: 0;
		padding: 1.25rem 1.4rem;
		border-radius: 12px;
		background: var(--theme-surface-muted, rgb(247, 247, 247));
	}

	.quotes__item blockquote {
		margin: 0;
		padding: 0;
		border: 0;
	}

	.quotes__item p {
		margin: 0;
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size, 1rem);
		line-height: var(--body-line-height, 1.6);
		color: var(--theme-text, rgb(51, 51, 51));
	}

	.quotes__item p::before {
		content: '“';
	}

	.quotes__item p::after {
		content: '”';
	}

	@media (max-width: 720px) {
		.quotes__page {
			grid-template-columns: 1fr;
		}
	}
</style>
