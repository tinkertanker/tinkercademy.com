---
/**
 * Compact segmented control for a programme series.
 * Sits on the meta bar next to audiences; current course is marked.
 */
interface Course {
	slug: string;
	title: string;
	shortTitle: string;
	href: string;
	current: boolean;
}

interface Props {
	label: string;
	courses: Course[];
}

const { label, courses } = Astro.props;
---

{courses.length > 0 && (
	<nav class="series-seg" aria-label={`${label} series`}>
		{courses.map((course) =>
			course.current ? (
				<span
					class="series-seg__item series-seg__item--current"
					aria-current="page"
					title={course.title}
				>
					{course.shortTitle}
				</span>
			) : (
				<a class="series-seg__item" href={course.href} title={course.title}>
					{course.shortTitle}
				</a>
			),
		)}
	</nav>
)}

<style>
	.series-seg {
		display: inline-flex;
		align-items: stretch;
		margin-inline-start: 0.35rem;
		border: 1px solid rgba(0, 0, 0, 0.12);
		border-radius: 6px;
		overflow: hidden;
		background: #fff;
	}

	.series-seg__item {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		padding: 5px 10px;
		border-right: 1px solid rgba(0, 0, 0, 0.1);
		font-family: 'Rubik', sans-serif;
		font-size: 12px;
		font-weight: 500;
		line-height: 1;
		color: rgb(51, 51, 51);
		text-decoration: none;
		white-space: nowrap;
		background: #fff;
	}

	.series-seg__item:last-child {
		border-right: 0;
	}

	.series-seg__item:hover {
		color: var(--accent-dark);
	}

	.series-seg__item--current {
		background: rgba(189, 58, 52, 0.1);
		color: rgb(51, 51, 51);
		font-weight: 600;
	}

	.series-seg__item--current:hover {
		color: rgb(51, 51, 51);
	}
</style>
