---
/**
 * CourseGrid — programme card grid with page title, search placeholder,
 * and the "Let's Work Together!" nav pill section at the bottom.
 *
 * Props:
 *   programmes     — array of { slug, title, heroImage, audienceLabel, audienceId, duration, shortDescription }
 *   pageTitle      — heading above the grid (e.g. "All Courses")
 *   navPills?      — array of { label, url } for the bottom navigation row
 */
import ProgrammeCard from './ProgrammeCard.astro';

interface Programme {
	slug: string;
	title: string;
	heroImage?: string | null;
	audienceLabel?: string;
	audienceId?: string;
	audienceIds?: string[];
	domainIds?: string[];
	platformIds?: string[];
	duration?: string;
	shortDescription?: string;
	searchText?: string;
	badgeHref?: string | null;
}

interface NavPill {
	label: string;
	url: string;
}

interface Props {
	programmes: Programme[];
	pageTitle?: string;
	navPills?: NavPill[];
	pagePath?: string;
	filterLabels?: {
		audience: Record<string, string>;
		domain: Record<string, string>;
		platform: Record<string, string>;
	};
}

const {
	programmes,
	pageTitle = 'All Courses',
	navPills = [],
	pagePath = '/courses-all',
	filterLabels = { audience: {}, domain: {}, platform: {} },
} = Astro.props;
const searchId = `course-search-${pageTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section
	class="course-listing"
	data-course-listing
	data-page-path={pagePath}
	data-filter-labels={JSON.stringify(filterLabels)}
>
	<div class="shell">
		{/* Heading + search bar */}
		<div class="course-listing__header">
			<h2 class="course-listing__title">{pageTitle}</h2>
			<label class="course-listing__search" for={searchId}>
				<svg viewBox="0 0 256 256" width="20" height="20" fill="currentColor">
					<path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z" />
				</svg>
				<input id={searchId} type="search" placeholder="Search" autocomplete="off" data-course-search />
			</label>
		</div>

		<div class="course-listing__filters" data-course-filters hidden>
			<div class="course-listing__filter-list" data-course-filter-list></div>
			<a class="course-listing__clear" href={pagePath} data-course-clear>Clear filters</a>
		</div>

		{/* Card grid */}
		<div class="course-listing__grid" data-course-grid>
			{programmes.map((prog) => (
				<ProgrammeCard
					slug={prog.slug}
					title={prog.title}
					heroImage={prog.heroImage}
					audienceLabel={prog.audienceLabel}
					audienceId={prog.audienceId}
					audienceIds={prog.audienceIds}
					domainIds={prog.domainIds}
					platformIds={prog.platformIds}
					duration={prog.duration}
					shortDescription={prog.shortDescription}
					searchText={prog.searchText}
					badgeHref={prog.badgeHref}
				/>
			))}
		</div>
		<p class="course-listing__empty" data-course-empty hidden>No courses match that search yet.</p>
	</div>
</section>

{/* Bottom "Let's Work Together!" nav section */}
{navPills.length > 0 && (
	<section class="pivot-section">
		<div class="shell">
			<h2 class="pivot-section__heading">Let's Work Together!</h2>
			<div class="pivot-section__pills">
				{navPills.map((pill) => (
					<a class="pivot-pill" href={pill.url}>{pill.label}</a>
				))}
			</div>
		</div>
	</section>
)}

<style>
	/* ─── Header ─────────────────────────────────────────── */
	.course-listing {
		padding: 2rem 0 0;
	}

	.course-listing__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}

	.course-listing__title {
		font-family: 'Oswald', sans-serif;
		font-weight: 500;
		font-size: 1.6rem;
		color: rgb(51, 51, 51);
		margin: 0;
	}

	.course-listing__search {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: rgb(247, 247, 247);
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 999px;
		padding: 0.5rem 0.9rem;
		font-family: 'Rubik', sans-serif;
		font-size: 14px;
		color: rgb(117, 117, 117);
		min-width: min(100%, 18rem);
	}

	.course-listing__search svg {
		color: rgb(240, 93, 87);
		flex-shrink: 0;
	}

	.course-listing__search input {
		border: 0;
		background: transparent;
		font: inherit;
		color: rgb(51, 51, 51);
		width: 100%;
		outline: none;
	}

	.course-listing__filters {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.course-listing__filter-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.course-listing__filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		background: rgba(240, 93, 87, 0.1);
		color: rgb(121, 49, 46);
		font-family: 'Rubik', sans-serif;
		font-size: 0.82rem;
		line-height: 1;
	}

	.course-listing__clear {
		/* accent-dark, not accent: text on white needs 4.5:1 (WCAG AA) */
		color: var(--accent-dark);
		font-family: 'Rubik', sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
	}

	.course-listing__clear:hover {
		text-decoration: underline;
	}

	.course-listing__search input::placeholder {
		color: rgb(117, 117, 117);
	}

	/* ─── Grid ───────────────────────────────────────────── */
	.course-listing__grid {
		display: grid;
		gap: 20px;
		grid-template-columns: repeat(4, minmax(200px, 1fr));
	}

	.course-listing__empty {
		margin: 1rem 0 0;
		font-family: 'Rubik', sans-serif;
		color: rgb(117, 117, 117);
	}

	@media (min-width: 1600px) {
		.course-listing__grid {
			grid-template-columns: repeat(5, minmax(200px, 1fr));
		}
	}

	@media (max-width: 1199px) {
		.course-listing__grid {
			grid-template-columns: repeat(2, minmax(200px, 1fr));
		}
	}

	@media (max-width: 809px) {
		.course-listing__grid {
			grid-template-columns: repeat(1, minmax(200px, 1fr));
		}

		.course-listing__filters {
			align-items: flex-start;
		}
	}

	/* ─── Pivot / Nav Section ────────────────────────────── */
	.pivot-section {
		padding: 3rem 0;
	}

	.pivot-section__heading {
		font-family: 'Oswald', sans-serif;
		font-weight: 500;
		font-size: 1.6rem;
		color: rgb(51, 51, 51);
		text-align: center;
		margin: 0 0 1.25rem;
	}

	.pivot-section__pills {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
	}

	.pivot-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 40px;
		padding: 10px 20px;
		border-radius: 30px;
		background-color: var(--accent-dark);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
		color: #fff;
		font-family: 'Rubik', sans-serif;
		font-size: 0.85rem;
		font-weight: 400;
		text-decoration: none;
		cursor: pointer;
		transition: opacity 0.15s;
	}

	.pivot-pill:hover {
		opacity: 0.85;
	}

	@media (max-width: 809px) {
		.pivot-section__pills {
			flex-direction: column;
			align-items: center;
		}
	}
</style>

<script>
	type FilterKey = 'audience' | 'domain' | 'platform';
	type FilterLabels = Record<FilterKey, Record<string, string>>;
	type ActiveFilters = Record<FilterKey, string | null>;

	const FILTER_KEYS: FilterKey[] = ['audience', 'domain', 'platform'];
	const FILTER_TITLES = {
		audience: 'Audience',
		domain: 'Domain',
		platform: 'Platform',
	} satisfies Record<FilterKey, string>;

	function getCardValues(card: Element, key: string) {
		return (card.getAttribute(key) ?? '')
			.split(' ')
			.map((value: string) => value.trim())
			.filter(Boolean);
	}

	function getValidFilters(search: string, labels: FilterLabels): ActiveFilters {
		const params = new URLSearchParams(search);
		const filter: ActiveFilters = {
			audience: null,
			domain: null,
			platform: null,
		};

		for (const key of FILTER_KEYS) {
			const value = params.get(key);
			filter[key] = value && labels?.[key]?.[value] ? value : null;
		}

		return filter;
	}

	function matchesActiveFilters(card: Element, filters: ActiveFilters) {
		if (filters.audience && !getCardValues(card, 'data-audiences').includes(filters.audience)) return false;
		if (filters.domain && !getCardValues(card, 'data-domains').includes(filters.domain)) return false;
		if (filters.platform && !getCardValues(card, 'data-platforms').includes(filters.platform)) return false;
		return true;
	}

	const listings = document.querySelectorAll('[data-course-listing]');

	listings.forEach((section) => {
		const grid = section.querySelector('[data-course-grid]');
		const input = section?.querySelector('[data-course-search]');
		const emptyState = section?.querySelector('[data-course-empty]');
		const filtersWrap = section?.querySelector('[data-course-filters]');
		const filterList = section?.querySelector('[data-course-filter-list]');
		const clearLink = section?.querySelector('[data-course-clear]');
		if (
			!(grid instanceof HTMLElement) ||
			!(input instanceof HTMLInputElement) ||
			!(emptyState instanceof HTMLElement) ||
			!(filtersWrap instanceof HTMLElement) ||
			!(filterList instanceof HTMLElement) ||
			!(clearLink instanceof HTMLAnchorElement)
		) {
			section?.setAttribute('data-course-state', 'ready');
			return;
		}

		const cards = [...grid.querySelectorAll('[data-programme-card]')];
		const filterLabels = JSON.parse(
			section.getAttribute('data-filter-labels') ?? '{}',
		) as FilterLabels;
		const activeFilters = getValidFilters(window.location.search, filterLabels);
		const pagePath = section.getAttribute('data-page-path') ?? window.location.pathname;

		clearLink.href = pagePath;

		const filterEntries = FILTER_KEYS.flatMap((key) =>
			activeFilters[key] ? ([[key, activeFilters[key]]] as const) : [],
		);
		if (filterEntries.length > 0) {
			filterList.replaceChildren();
			filterEntries.forEach(([key, value]) => {
				const chip = document.createElement('span');
				chip.className = 'course-listing__filter-chip';
				chip.textContent = `${FILTER_TITLES[key]}: ${filterLabels[key][value]}`;
				filterList.append(chip);
			});
			filtersWrap.hidden = false;
		}

		const render = () => {
			const query = input.value.trim().toLowerCase();
			let visibleCount = 0;

			cards.forEach((card) => {
				const haystack = (card.getAttribute('data-search') ?? '').toLowerCase();
				const matchesFilters = matchesActiveFilters(card, activeFilters);
				const isVisible = matchesFilters && (query === '' || haystack.includes(query));
				(card as HTMLElement).hidden = !isVisible;
				if (isVisible) visibleCount += 1;
			});

			emptyState.hidden = visibleCount > 0;
		};

		input.addEventListener('input', render);
		render();
	});
</script>
