---
/**
 * ProgrammeCard — a single programme card matching the Framer design.
 *
 * Shows: hero image, audience badge (colour-coded), title,
 * audience + duration + short description metadata rows.
 */

interface Props {
	slug: string;
	title: string;
	heroImage?: string | null;
	audienceLabel?: string;
	audienceId?: string;
	audienceIds?: string[];
	domainIds?: string[];
	platformIds?: string[];
	duration?: string;
	shortDescription?: string;
	searchText?: string;
	badgeHref?: string | null;
}

const {
	slug,
	title,
	heroImage,
	audienceLabel = 'Programme',
	audienceId = '',
	audienceIds = [],
	domainIds = [],
	platformIds = [],
	duration = '',
	shortDescription = '',
	searchText = '',
	badgeHref = null,
} = Astro.props;

const href = `/programmes/${slug}/`;

// Audience badge colour:  Students / Teachers → brand red,  Businesses / Public → blue
const AUDIENCE_COLOURS: Record<string, string> = {
	students: 'rgb(240, 93, 87)',
	teachers: 'rgb(240, 93, 87)',
	businesses: '#DF675D',
	public: '#DF675D',
};
const badgeColour = AUDIENCE_COLOURS[audienceId] ?? 'rgb(240, 93, 87)';
---

<article
	class="prog-card"
	data-programme-card
	data-search={searchText.toLowerCase()}
	data-audiences={audienceIds.join(' ')}
	data-domains={domainIds.join(' ')}
	data-platforms={platformIds.join(' ')}
>
	<div class="prog-card__inner">
		{/* Audience badge */}
		{badgeHref ? (
			<a class="prog-card__badge" href={badgeHref} style={`background-color: ${badgeColour}`}>
				{audienceLabel}
			</a>
		) : (
			<span class="prog-card__badge" style={`background-color: ${badgeColour}`}>
				{audienceLabel}
			</span>
		)}

		<a class="prog-card__link" href={href}>
			{/* Hero image */}
			<div class="prog-card__image">
				{heroImage ? (
					<img src={heroImage} alt={title} loading="lazy" />
				) : (
					<div class="prog-card__image-placeholder" />
				)}
			</div>

			{/* Text content */}
			<div class="prog-card__body">
				<h2 class="prog-card__title">{title}</h2>
				<div class="prog-card__divider" />
				<div class="prog-card__meta">
					{/* Audience row */}
					<div class="prog-card__meta-row">
						<svg class="prog-card__icon" viewBox="0 0 256 256" width="16" height="16" fill="currentColor">
							<path d="M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.78,40.31,185.66,25.08,212a8,8,0,1,0,13.85,8C55.71,192.94,78.38,176,128,176s72.29,16.94,89.07,44a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z" />
						</svg>
						<span>{audienceLabel}</span>
					</div>

					{/* Duration row */}
					{duration && (
						<div class="prog-card__meta-row">
							<svg class="prog-card__icon" viewBox="0 0 256 256" width="16" height="16" fill="currentColor">
								<path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm64-88a8,8,0,0,1-8,8H128a8,8,0,0,1-8-8V72a8,8,0,0,1,16,0v48h48A8,8,0,0,1,192,128Z" />
							</svg>
							<span>{duration}</span>
						</div>
					)}

					{/* Description row */}
					{shortDescription && (
						<div class="prog-card__meta-row">
							<svg class="prog-card__icon" viewBox="0 0 256 256" width="16" height="16" fill="currentColor">
								<path d="M200,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V40A16,16,0,0,0,200,24Zm0,192H56V40H200ZM176,88a8,8,0,0,1-8,8H88a8,8,0,0,1,0-16h80A8,8,0,0,1,176,88Zm0,40a8,8,0,0,1-8,8H88a8,8,0,0,1,0-16h80A8,8,0,0,1,176,128Zm0,40a8,8,0,0,1-8,8H88a8,8,0,0,1,0-16h80A8,8,0,0,1,176,168Z" />
							</svg>
							<span>{shortDescription}</span>
						</div>
					)}
				</div>
			</div>
		</a>
	</div>
</article>

<style>
	.prog-card {
		display: flex;
		flex-flow: column wrap;
		background-color: #fafafa;
		cursor: pointer;
		text-decoration: none;
		color: inherit;
		width: 100%;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.prog-card__link {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.prog-card__inner {
		position: relative;
		display: flex;
		flex-flow: column;
		border: 1px solid #e3e3e3;
		border-radius: 20px;
		overflow: hidden;
		height: 100%;
		background: #fff;
	}

	.prog-card__badge {
		position: absolute;
		top: 8px;
		left: 8px;
		z-index: 1;
		border-radius: 5px;
		padding: 4px 6px;
		font-family: 'Rubik', sans-serif;
		font-size: 12px;
		font-weight: 400;
		color: #fff;
		line-height: 1;
		text-decoration: none;
	}

	.prog-card__image {
		width: 100%;
		height: 180px;
		position: relative;
		overflow: hidden;
		flex-shrink: 0;
		background: linear-gradient(135deg, rgba(240, 93, 87, 0.12), rgba(0, 153, 255, 0.08));
	}

	.prog-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.3s ease;
	}

	.prog-card__image-placeholder {
		width: 100%;
		height: 100%;
		background: #e0e0e0;
	}

	.prog-card__body {
		display: flex;
		flex-flow: column;
		gap: 10px;
		padding: 0 18px 24px;
		flex: 1;
	}

	.prog-card__title {
		margin: 15px 0 0;
		min-height: 50px;
		font-family: 'Rubik', sans-serif;
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.35;
		color: rgb(51, 51, 51);
	}

	.prog-card__divider {
		width: 100%;
		height: 0;
		border: none;
	}

	.prog-card__meta {
		display: flex;
		flex-flow: column wrap;
		gap: 10px;
	}

	.prog-card__meta-row {
		display: flex;
		flex-flow: row;
		align-items: flex-start;
		gap: 10px;
		font-family: 'Rubik', sans-serif;
		font-size: 14px;
		color: rgb(117, 117, 117);
		line-height: var(--body-line-height);
	}

	.prog-card__meta-row:last-child span {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.prog-card__icon {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
		margin-top: 2px;
		color: rgb(117, 117, 117);
	}

	.prog-card:hover {
		transform: translateY(-4px);
	}

	.prog-card:hover .prog-card__inner {
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
		border-color: rgba(240, 93, 87, 0.28);
	}

	.prog-card:hover .prog-card__image img {
		transform: scale(1.04);
	}

	.prog-card:hover .prog-card__title {
		color: rgb(240, 93, 87);
	}
</style>
