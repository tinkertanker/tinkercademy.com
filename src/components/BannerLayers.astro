---
import { getBannerAsset } from '../lib/banner-assets';

interface Props {
	src: string;
}

const { src } = Astro.props;
const asset = getBannerAsset(src);
---

{asset ? (
	<div class="banner-layers" aria-hidden="true">
		<img
			class="banner-layers__background"
			src={asset.background}
			width={asset.backgroundWidth}
			height={asset.backgroundHeight}
			alt=""
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		<img
			class="banner-layers__foreground"
			src={asset.foreground}
			width={asset.foregroundWidth}
			height={asset.foregroundHeight}
			alt=""
			loading="eager"
			fetchpriority="low"
			decoding="async"
		/>
	</div>
) : (
	<img
		class="banner-layers__background"
		src={src}
		alt=""
		loading="eager"
		fetchpriority="high"
		decoding="async"
	/>
)}

<style>
	.banner-layers {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.banner-layers__background {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.banner-layers__foreground {
		position: absolute;
		top: 50%;
		right: clamp(0rem, 2vw, 2rem);
		width: auto;
		height: 92%;
		max-width: min(58vw, 58rem);
		object-fit: contain;
		transform: translateY(-50%);
	}

	@media (max-width: 809px) {
		.banner-layers__foreground {
			top: clamp(1rem, 5vw, 2rem);
			left: 50%;
			right: auto;
			width: 80vw;
			height: auto;
			max-width: none;
			transform: translateX(-50%);
		}
	}
</style>
