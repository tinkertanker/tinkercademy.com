---
import { BLOG_TITLE, blogHref } from '../../lib/blog';

const { active = null } = Astro.props as { active?: 'stories' | 'archives' | null };
---

<nav class="blog-nav" aria-label="Build Log">
	<div class="blog-nav__inner shell">
		<a class="blog-nav__brand" href={blogHref('/')}>{BLOG_TITLE}</a>
		<div class="blog-nav__links">
			<a href={blogHref('/')} aria-current={active === 'stories' ? 'page' : undefined}>All stories</a>
			<a href={blogHref('/#archives')} aria-current={active === 'archives' ? 'page' : undefined}>Archives</a>
			<a href={blogHref('/feed')}>RSS</a>
		</div>
	</div>
</nav>

<style>
	.blog-nav {
		border-top: 1px solid rgba(0, 0, 0, 0.08);
		border-bottom: 1px solid rgba(0, 0, 0, 0.1);
		background: #fff;
	}

	.blog-nav__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 4rem;
	}

	.blog-nav__brand {
		font-family: var(--heading);
		font-size: 1.1rem;
		font-weight: 600;
		text-decoration: none;
	}

	.blog-nav__links {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 2rem);
		font-size: 0.88rem;
		font-weight: 500;
	}

	.blog-nav__links a {
		padding: 0.35rem 0;
		text-decoration: none;
	}

	.blog-nav__links a:hover,
	.blog-nav__links a:focus-visible,
	.blog-nav__links a[aria-current='page'] {
		color: var(--accent-dark);
		text-decoration: underline;
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.3em;
	}

	@media (max-width: 520px) {
		.blog-nav__inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.5rem;
			padding-top: 0.85rem;
			padding-bottom: 0.85rem;
		}

		.blog-nav__links {
			width: 100%;
			justify-content: space-between;
		}
	}
</style>
