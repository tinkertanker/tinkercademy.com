---
const props = Astro.props as { src?: string | null; video?: string; alt?: string; compact?: boolean };
const src = props.src ?? null;
const video = props.video;
const alt = props.alt ?? '';
const compact = props.compact ?? false;
---

{
	src && (
		<section class:list={['hero-media', compact && 'hero-media--compact']}>
			<div class="shell">
				{video ? (
					<video data-hero-video poster={src} aria-label={alt} muted loop playsinline controls preload="metadata">
						<source src={video} type="video/mp4" />
						<a href={src}>View {alt}</a>
					</video>
				) : <img src={src} alt={alt} loading="eager" />}
			</div>
		</section>
	)
}

<script>
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	document.querySelectorAll<HTMLVideoElement>('[data-hero-video]').forEach((video) => {
		const syncMotion = () => {
			video.muted = true;
			if (reducedMotion.matches) video.pause();
			else void video.play().catch(() => { /* Native controls remain available if autoplay is blocked. */ });
		};
		syncMotion();
		reducedMotion.addEventListener('change', syncMotion);
	});
</script>

<style>
	.hero-media {
		padding-bottom: 2rem;
	}

	.hero-media .shell {
		border-radius: 1.5rem;
		overflow: hidden;
		box-shadow: 0 22px 44px rgba(45, 42, 38, 0.12);
		border: 1px solid var(--theme-border, rgba(45, 42, 38, 0.12));
	}

	.hero-media img,
	.hero-media video {
		display: block;
		width: 100%;
		height: clamp(280px, 48vw, 560px);
		object-fit: cover;
	}

	.hero-media--compact img,
	.hero-media--compact video {
		height: clamp(220px, 34vw, 420px);
	}
</style>
