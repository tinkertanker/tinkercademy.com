---
/**
 * / — homepage, Astro-native rebuild of the live tinkercademy.com homepage.
 *
 * Sections (top → bottom):
 *   1. Hero (full-bleed image + title + lead + audience pills)
 *   2. Partner statement strip
 *   3. Qualified educators section (domain chips + proof points + institution logos)
 *   4. Flagship programmes (3-up cards with external CTA)
 *   5. Popular Courses — ProgrammeCard grid from featured_programme_slugs
 *   6. Closing CTA banner
 */
import CtaBanner from '../components/CtaBanner.astro';
import ProgrammeCard from '../components/ProgrammeCard.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getStaticPage } from '../lib/data.js';
import { localiseFramerImage } from '../lib/media.js';
import { getHomeFeaturedProgrammes, toProgrammeCardData } from '../lib/programmes.ts';
import {
	HOME_CERTIFICATION_BADGES,
	HOME_FLAGSHIP_IMAGES,
	HOME_INSTITUTION_LOGOS,
	HOME_PARTNER_LOGOS,
} from '../lib/site-media.js';

const page = getStaticPage('/');
if (!page) return Astro.redirect('/404');

const canonical = 'https://tinkercademy.com/';

const heroImage = localiseFramerImage(page.hero_image ?? '');
const heroTitle = page.hero_title ?? 'Illuminate your journey into tech & AI';
const heroLead =
	page.hero_lead ?? 'Learn coding, digital making, and agentic engineering from expert teachers and builders.';

const partnerStatement =
	page.partner_statement ??
	'Official training partner for tech companies, universities, and the Singapore government.';

const focusAreas: string[] = page.focus_areas ?? [];
const proofPoints: string[] = page.proof_points ?? [];

const flagshipItems: Array<{ title: string; description: string; image?: string }> =
	page.flagship_items ?? [];

/* Map flagship titles → external "Read More" CTA */
const flagshipCtaByTitle: Record<string, { label: string; url: string }> = {
	'Swift Accelerator': { label: 'Read More', url: 'https://swiftinsg.org/' },
	'IMDA LEARN Roadmap': {
		label: 'Read More',
		url: 'https://infocomm.club',
	},
	'Code For Fun': { label: 'Read More', url: 'https://codeforfun.sg/' },
};

const closingStatement =
	page.closing_statement ??
	'Join us for the best coding and digital making experiences for students, teachers, and professionals in Singapore and beyond.';
const closingCtas = (page.closing_ctas ?? []).map((cta: any) => {
	let url = cta.url ?? '/';
	try {
		const parsed = new URL(url, 'https://tinkercademy.com');
		if (parsed.origin === 'https://tinkercademy.com') {
			url = parsed.pathname || '/';
		}
	} catch {
		/* keep as-is */
	}
	return { label: cta.label, url };
});

/* ─── Popular Courses (featured programmes) ─────────────────────────── */
const popularCourses = (await getHomeFeaturedProgrammes()).map((programme) =>
	toProgrammeCardData(programme),
);
---

<ContentLayout
	title="Tinkercademy — Coding and making for schools and professionals"
	description="Singapore-based coders and makers teaching coding and digital making to schools, companies, and individuals. Courses in micro:bit, Swift, Python, and AI."
	canonical={canonical}
	image={heroImage}
>
	{/* ═══════════ 1. Hero ═══════════════════════════════════════════════ */}
	<section class="home-hero">
		{heroImage && (
			<img
				class="home-hero__bg"
				src={heroImage}
				alt=""
				loading="eager"
				fetchpriority="high"
			/>
		)}
		<div class="home-hero__scrim"></div>
		<div class="home-hero__content shell">
			<h1 class="home-hero__title">
				<span class="home-hero__highlight">Illuminate</span> your journey into tech & AI
			</h1>
			<p class="home-hero__lead">Learn coding, digital making, and agentic engineering from expert teachers and builders.</p>
			<div class="home-hero__actions">
				<a class="home-hero__pill home-hero__pill--primary" href="#programmes">Programmes</a>
				<a class="home-hero__pill" href="/professionals">Professionals</a>
				<a class="home-hero__pill" href="/schools">Schools</a>
				<a class="home-hero__pill" href="/individuals">Individuals</a>
			</div>
		</div>
	</section>

	{/* ═══════════ 2. Partner statement strip ════════════════════════════ */}
	<section class="home-partners">
		<div class="shell home-partners__inner">
			<p class="home-partners__statement">{partnerStatement}</p>
			<div class="home-partners__marquee">
				<div class="home-partners__track">
					{[...HOME_PARTNER_LOGOS, ...HOME_PARTNER_LOGOS].map((logo, idx) => (
						<a
							class="home-partners__logo-link"
							href={logo.url}
							target="_blank"
							rel="noopener"
							aria-label={idx < HOME_PARTNER_LOGOS.length ? logo.label : undefined}
							aria-hidden={idx >= HOME_PARTNER_LOGOS.length ? 'true' : undefined}
							tabindex={idx >= HOME_PARTNER_LOGOS.length ? -1 : undefined}
						>
							<img
								class="home-partners__logo"
								src={logo.src}
								alt={idx < HOME_PARTNER_LOGOS.length ? logo.label : ''}
							/>
						</a>
					))}
				</div>
			</div>
		</div>
	</section>

	{/* ═══════════ 3. Educators + focus areas ════════════════════════════ */}
	<section class="home-educators">
		<div class="shell">
			<h2 class="home-educators__heading">
				Learn from qualified educators and engineers.
			</h2>
			<p class="home-educators__sub">
				Courses available in a wide variety of modern, practical domains.
			</p>

			{focusAreas.length > 0 && (
				<ul class="home-educators__chips">
					{focusAreas.map((label) => (
						<li class="home-educators__chip">{label}</li>
					))}
				</ul>
			)}

			{proofPoints.length > 0 && (
				<ul class="home-educators__proof">
					{proofPoints.map((text) => (
						<li class="home-educators__proof-item">{text}</li>
					))}
				</ul>
			)}

			<div class="home-educators__logos">
				{HOME_INSTITUTION_LOGOS.map((logo) => (
					<img
						class="home-educators__inst-logo"
						src={logo.src}
						alt={logo.label}
						loading="lazy"
					/>
				))}
			</div>
		</div>
	</section>

	{/* ═══════════ 3b. Certification badges strip ════════════════════════ */}
	<section class="home-certs">
		<div class="shell home-certs__inner">
			<p class="home-certs__heading">
				Curriculum designed and delivered by officially certified instructors.
			</p>
			<div class="home-certs__marquee">
				<div class="home-certs__track">
					{[...HOME_CERTIFICATION_BADGES, ...HOME_CERTIFICATION_BADGES].map((logo, idx) => (
						<img
							class="home-certs__badge"
							src={logo.src}
							alt={idx < HOME_CERTIFICATION_BADGES.length ? logo.label : ''}
							aria-hidden={idx >= HOME_CERTIFICATION_BADGES.length ? 'true' : undefined}
						/>
					))}
				</div>
			</div>
		</div>
	</section>

	{/* ═══════════ 4. Flagship programmes ════════════════════════════════ */}
	<section class="home-flagship" id="flagship">
		<div class="shell">
			<h2 class="home-flagship__heading">Our Flagship Programmes</h2>
			<div class="home-flagship__grid">
				{flagshipItems.map((item) => {
					const cta = flagshipCtaByTitle[item.title];
					const image = HOME_FLAGSHIP_IMAGES[item.title] ?? localiseFramerImage(item.image ?? '');
					return (
						<article class="flagship-card">
							{cta ? (
								<a class="flagship-card__link" href={cta.url} target="_blank" rel="noopener">
									{image && (
										<div class="flagship-card__image">
											<img src={image} alt={item.title} loading="lazy" />
										</div>
									)}
									<div class="flagship-card__body">
										<h3 class="flagship-card__title">
											{item.title}
											<svg class="flagship-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M7 17L17 7M17 7H7M17 7V17"/>
											</svg>
										</h3>
										<p class="flagship-card__text">{item.description}</p>
									</div>
								</a>
							) : (
								<>
									{image && (
										<div class="flagship-card__image">
											<img src={image} alt={item.title} loading="lazy" />
										</div>
									)}
									<div class="flagship-card__body">
										<h3 class="flagship-card__title">{item.title}</h3>
										<p class="flagship-card__text">{item.description}</p>
									</div>
								</>
							)}
						</article>
					);
				})}
			</div>
		</div>
	</section>

	{/* ═══════════ 5. Popular Courses ════════════════════════════════════ */}
	{popularCourses.length > 0 && (
		<section class="home-popular" id="programmes">
			<div class="shell">
				<h2 class="home-popular__heading">Popular Courses</h2>
				<div class="home-popular__grid">
					{popularCourses.map((prog) => (
						<ProgrammeCard
							slug={prog.slug}
							title={prog.title}
							heroImage={prog.heroImage}
							audienceLabel={prog.audienceLabel}
							audienceId={prog.audienceId}
							audienceIds={prog.audienceIds}
							domainIds={prog.domainIds}
							platformIds={prog.platformIds}
							duration={prog.duration}
							shortDescription={prog.shortDescription}
							searchText={prog.searchText}
							badgeHref={prog.badgeHref}
						/>
					))}
				</div>
			</div>
		</section>
	)}

	{/* ═══════════ 6. Closing CTA banner ═════════════════════════════════ */}
	<CtaBanner text={closingStatement} ctas={closingCtas} />
</ContentLayout>

<style>
	/* ─── Hero ─────────────────────────────────────────────────────────── */
	.home-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: clamp(520px, 72vh, 720px);
		overflow: clip;
		background: #0a0a0a;
	}

	.home-hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
	}

	.home-hero__scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.15) 40%, rgba(0, 0, 0, 0.7) 100%);
	}

	.home-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: inherit;
		padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 5vw, 4rem);
		gap: 1.1rem;
	}

	.home-hero__title {
		font-family: 'Oswald', sans-serif;
		font-size: clamp(2.4rem, 6vw, 4.5rem);
		font-weight: 500;
		line-height: 1;
		text-transform: uppercase;
		color: #fff;
		margin: 0;
		max-width: 16ch;
		text-wrap: balance;
	}

	.home-hero__highlight {
		color: #fff;
		text-shadow: 0 0 20px rgba(240, 93, 87, 0.4), 0 0 40px rgba(240, 93, 87, 0.2);
		animation: highlight-pulse 4s ease-in-out infinite;
	}

	@keyframes highlight-pulse {
		0%, 100% {
			text-shadow: 0 0 16px rgba(240, 93, 87, 0.35), 0 0 32px rgba(240, 93, 87, 0.15);
		}
		50% {
			text-shadow: 0 0 28px rgba(240, 93, 87, 0.55), 0 0 48px rgba(240, 93, 87, 0.3);
		}
	}

	.home-hero__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.92);
		margin: 0;
		max-width: 48ch;
	}

	.home-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 0.75rem;
	}

	.home-hero__pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 42px;
		padding: 0 1.15rem;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.55);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.88rem;
		font-weight: 500;
		transition: background 0.15s ease, border-color 0.15s ease;
	}

	.home-hero__pill--primary {
		background: rgb(240, 93, 87);
		border-color: rgb(240, 93, 87);
		box-shadow: 0 8px 24px rgba(240, 93, 87, 0.28);
	}

	.home-hero__pill:hover {
		background: rgba(255, 255, 255, 0.15);
		border-color: rgba(255, 255, 255, 0.85);
	}

	.home-hero__pill--primary:hover {
		background: rgb(220, 74, 68);
		border-color: rgb(220, 74, 68);
	}

	/* ─── Partner strip ──────────────────────────────────────────────── */
	.home-partners {
		padding: 2.5rem 0;
		background: #fff;
		border-bottom: 1px solid rgb(238, 238, 238);
	}

	.home-partners__inner {
		display: grid;
		gap: 1.5rem;
		justify-items: center;
		text-align: center;
	}

	.home-partners__statement {
		font-family: 'Oswald', sans-serif;
		font-size: clamp(1.05rem, 1.6vw, 1.35rem);
		font-weight: 500;
		color: rgb(51, 51, 51);
		margin: 0;
		max-width: 50rem;
		letter-spacing: 0.01em;
		line-height: 1.35;
	}

	.home-partners__marquee {
		width: 100%;
		overflow: hidden;
		mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
	}

	.home-partners__track {
		display: flex;
		width: max-content;
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3.25rem);
		animation: home-marquee 45s linear infinite;
		will-change: transform;
	}

	.home-partners__logo-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		opacity: 0.8;
		transition: opacity 0.15s;
	}

	.home-partners__logo-link:hover {
		opacity: 1;
	}

	.home-partners__logo {
		max-height: 44px;
		max-width: 140px;
		width: auto;
		height: auto;
		object-fit: contain;
	}

	@keyframes home-marquee {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	@media (prefers-reduced-motion: reduce) {
		.home-partners__track,
		.home-certs__track {
			animation: none;
		}
	}

	/* ─── Educators section ───────────────────────────────────────────── */
	.home-educators {
		padding: 3.5rem 0;
	}

	.home-educators .shell {
		text-align: center;
	}

	.home-educators__heading {
		font-family: 'Oswald', sans-serif;
		font-size: clamp(1.6rem, 3.2vw, 2.3rem);
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0 0 0.75rem;
	}

	.home-educators__sub {
		font-family: 'Rubik', sans-serif;
		font-size: 1rem;
		color: rgb(110, 110, 110);
		margin: 0 0 1.5rem;
	}

	.home-educators__chips {
		list-style: none;
		padding: 0;
		margin: 0 0 2rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 0.7rem;
	}

	.home-educators__chip {
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		background: rgba(240, 93, 87, 0.09);
		color: rgb(202, 67, 61);
		font-family: 'Rubik', sans-serif;
		font-size: 0.88rem;
		font-weight: 500;
		line-height: 1.2;
	}

	.home-educators__proof {
		list-style: none;
		padding: 0;
		margin: 0 0 2rem;
		display: grid;
		gap: 0.5rem;
		max-width: 60rem;
		justify-items: center;
		margin-inline: auto;
	}

	.home-educators__proof-item {
		font-family: 'Rubik', sans-serif;
		font-size: 1rem;
		line-height: 1.6;
		color: rgb(51, 51, 51);
	}

	.home-educators__logos {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: clamp(1rem, 2.5vw, 2rem);
		padding-top: 1rem;
	}

	.home-educators__inst-logo {
		max-height: 48px;
		max-width: 140px;
		width: auto;
		height: auto;
		object-fit: contain;
		opacity: 0.75;
		filter: grayscale(0.25);
	}

	/* ─── Certification badges ────────────────────────────────────────── */
	.home-certs {
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		padding: 3rem 0;
		background: linear-gradient(180deg, rgb(50, 50, 50) 0%, rgb(20, 20, 20) 100%);
	}

	.home-certs__heading {
		font-family: 'Rubik', sans-serif;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		text-align: center;
		color: rgba(255, 255, 255, 0.92);
		margin: 0 0 2rem;
	}

	.home-certs__inner {
		/* match shell width of the text blocks above */
	}

	.home-certs__marquee {
		width: 100%;
		overflow: hidden;
		mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%);
	}

	.home-certs__track {
		display: flex;
		width: max-content;
		align-items: center;
		gap: clamp(1.5rem, 3vw, 2.75rem);
		animation: home-marquee 55s linear infinite;
		will-change: transform;
	}

	.home-certs__badge {
		max-height: 88px;
		max-width: 160px;
		width: auto;
		height: auto;
		object-fit: contain;
		flex: 0 0 auto;
	}

	/* ─── Flagship ───────────────────────────────────────────────────── */
	.home-flagship {
		padding: 3.5rem 0;
		background: #fafafa;
	}

	.home-flagship__heading {
		font-family: 'Oswald', sans-serif;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(23, 23, 23);
		margin: 0 0 1.5rem;
	}

	.home-flagship__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.flagship-card {
		display: flex;
		flex-direction: column;
		background: #fff;
		border: 1px solid rgb(229, 229, 229);
		border-radius: 18px;
		overflow: hidden;
	}

	.flagship-card__link {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.flagship-card__link,
	.flagship-card__link:visited,
	.flagship-card__link:hover,
	.flagship-card__link:active {
		color: inherit;
		text-decoration: none;
	}

	.flagship-card:has(.flagship-card__link:hover) {
		transform: translateY(-4px);
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
		border-color: rgba(240, 93, 87, 0.28);
	}

	.flagship-card__image {
		width: 100%;
		aspect-ratio: 25 / 16;
		overflow: hidden;
		background: rgb(245, 245, 245);
	}

	.flagship-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.flagship-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.2rem 1.25rem 1.4rem;
		flex: 1;
	}

	.flagship-card__title {
		font-family: 'Oswald', sans-serif;
		font-size: 1.25rem;
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(23, 23, 23);
		margin: 0;
	}

	.flagship-card__title {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
		}

		.flagship-card__arrow {
			flex-shrink: 0;
			opacity: 0.6;
			transform: translateY(15%);
		}

	.flagship-card__text {
		font-family: 'Rubik', sans-serif;
		font-size: 0.92rem;
		line-height: 1.6;
		color: rgb(90, 90, 90);
		margin: 0;
		flex: 1;
	}

	.flagship-card:has(.flagship-card__link:hover) .flagship-card__image img {
		transform: scale(1.04);
	}

	.flagship-card:has(.flagship-card__link:hover) .flagship-card__title {
		color: rgb(240, 93, 87);
	}

	@media (max-width: 560px) {
		.home-flagship__grid {
			grid-template-columns: 1fr;
		}
	}

	/* ─── Popular ────────────────────────────────────────────────────── */
	.home-popular {
		padding: 3.5rem 0;
		scroll-margin-top: 80px;
	}

	.home-popular__heading {
		font-family: 'Oswald', sans-serif;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(23, 23, 23);
		margin: 0 0 1.5rem;
	}

	.home-popular__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	@media (max-width: 560px) {
		.home-popular__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
