---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData, getStaticPage } from '../lib/data.js';
import { toSiteHref } from '../lib/links.js';
import {
	HOME_CERTIFICATION_BADGES,
	HOME_PARTNER_LOGOS,
	HOME_POPULAR_COURSE_ICONS,
} from '../lib/site-media.js';

const site = getSiteData();
const page = getStaticPage('/');
const featuredProgrammeOrder = new Map((page?.featured_programme_slugs ?? []).map((slug, index) => [slug, index]));
const featuredProgrammes =
	featuredProgrammeOrder.size > 0
		? site.programmes
				.filter((programme) => featuredProgrammeOrder.has(programme.slug))
				.sort(
					(left, right) =>
						(featuredProgrammeOrder.get(left.slug) ?? 0) - (featuredProgrammeOrder.get(right.slug) ?? 0),
				)
		: site.programmes.slice(0, 5);
const heroActions = page?.hero_actions ?? [];
const flagshipItems = page?.flagship_items ?? [];
const proofPoints = page?.proof_points ?? [];
const closingCtas = page?.closing_ctas ?? [];
const partnerLogos = [...HOME_PARTNER_LOGOS, ...HOME_PARTNER_LOGOS];
const popularCourseThumbs = featuredProgrammes.map((programme) => {
	const mapped = HOME_POPULAR_COURSE_ICONS[programme.slug];
	if (mapped) {
		return { ...programme, thumb: { kind: 'icon', src: mapped } };
	}

	if (programme.slug === 'building-agents-with-openclaw' && programme.hero_image) {
		return { ...programme, thumb: { kind: 'hero', src: programme.hero_image } };
	}

	return { ...programme, thumb: { kind: 'label', label: programme.title.split(/\s+/).slice(0, 2).join(' ') } };
});

const flagshipLinks: Record<string, string> = {
	'Swift Accelerator': 'https://swiftinsg.org/',
	'IMDA LEARN Roadmap':
		'https://www.imda.gov.sg/how-we-can-help/infocomm-media-clubs/learn-roadmaps',
	'Code For Fun': 'https://codeforfun.sg/',
};
const flagshipCards = flagshipItems.map((item) => ({
	...item,
	url: flagshipLinks[item.title] ?? null,
}));
---

<BaseLayout
	title={page?.seo?.title ?? 'Tinkercademy'}
	description={page?.seo?.description ?? ''}
	canonical="https://tinkercademy.com/"
	image={page?.hero_image ?? undefined}
>
	<section class="home-hero">
		{page?.hero_image && (
			<img
				class="home-hero__image"
				src={page.hero_image}
				alt={page?.hero_title ?? page?.title ?? 'Tinkercademy'}
			/>
		)}
		<div class="home-hero__overlay">
			<div class="shell home-hero__inner">
				<h1>{page?.hero_title ?? page?.title ?? 'Tinkercademy'}</h1>
				<p class="lead">
					{page?.hero_lead ?? page?.description ?? 'Coding and digital making for schools and professionals.'}
				</p>
				{
					heroActions.length > 0 && (
						<div class="home-hero__actions">
							{heroActions.map((cta) => (
								<a class="home-pill" href={toSiteHref(cta.url)}>
									{cta.label}
								</a>
							))}
						</div>
					)
				}
			</div>
		</div>
	</section>

	<section class="partner-marquee">
		<div class="shell partner-marquee__inner">
			<p class="partner-marquee__copy">
				{page?.partner_statement ?? 'Official training partner for tech companies, universities, and the Singapore government.'}
			</p>
			<div class="logo-marquee" aria-label="Training partners">
				<div class="logo-marquee__track">
					{partnerLogos.map((logo, index) => (
						<img
							class="logo-marquee__logo"
							src={logo.src}
							alt={index < HOME_PARTNER_LOGOS.length ? logo.label : ''}
							aria-hidden={index >= HOME_PARTNER_LOGOS.length ? 'true' : undefined}
							loading="lazy"
						/>
					))}
				</div>
			</div>
			{proofPoints[0] && <p class="partner-marquee__proof">{proofPoints[0]}</p>}
		</div>
	</section>

	<section class="credential-band">
		<div class="shell credential-band__inner">
			{proofPoints[1] && <p class="credential-band__copy">{proofPoints[1]}</p>}
			<div class="credential-band__grid">
				{HOME_CERTIFICATION_BADGES.map((badge) => (
					<figure class="credential-card">
						<img src={badge.src} alt={badge.label} loading="lazy" />
					</figure>
				))}
			</div>
		</div>
	</section>

	{flagshipCards.length > 0 && (
		<section class="shell flagship-section">
			<div class="flagship-section__intro">
				<p class="section-kicker">Our Flagship Programmes</p>
			</div>
			<div class="flagship-section__stack">
				{flagshipCards.map((item) => (
					<article class="flagship-row">
						{item.image && (
							<img
								class="flagship-row__image"
								src={item.image}
								alt={item.title}
								loading="lazy"
							/>
						)}
						<div class="flagship-row__copy">
							<h2>{item.title}</h2>
							<p>{item.description}</p>
							{item.url && <a class="flagship-row__link" href={item.url}>Read more</a>}
						</div>
					</article>
				))}
			</div>
		</section>
	)}

	<section class="shell popular-section" id="programmes">
		<p class="section-kicker">Popular Courses</p>
		<div class="popular-grid">
			{popularCourseThumbs.map((programme) => (
				<a class="popular-card" href={`/programmes/${programme.slug}`}>
					<div class="popular-card__thumb">
						{
							programme.thumb.kind === 'label' ? (
								<span>{programme.thumb.label}</span>
							) : (
								<img
									class:list={[
										'popular-card__thumb-image',
										programme.thumb.kind === 'hero' && 'popular-card__thumb-image--hero',
									]}
									src={programme.thumb.src}
									alt={programme.title}
									loading="lazy"
								/>
							)
						}
					</div>
					<p class="popular-card__meta">{programme.audiences[0]?.label ?? 'Programme'}</p>
					<h2>{programme.title}</h2>
				</a>
			))}
		</div>
	</section>

	{page?.closing_statement && (
		<section class="shell home-cta">
			<div class="home-cta__inner">
				<p class="home-cta__copy">{page.closing_statement}</p>
				<div class="home-cta__actions">
					{closingCtas.map((cta) => (
						<a class="home-pill home-pill--solid" href={toSiteHref(cta.url)}>
							{cta.label}
						</a>
					))}
				</div>
			</div>
		</section>
	)}
</BaseLayout>

<style>
	.home-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: clamp(430px, 62svh, 620px);
		overflow: clip;
		background: #111;
	}

	.home-hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.home-hero__overlay {
		position: relative;
		min-height: inherit;
		background:
			linear-gradient(90deg, rgba(9, 9, 12, 0.7) 0%, rgba(9, 9, 12, 0.3) 44%, rgba(9, 9, 12, 0.08) 100%),
			linear-gradient(180deg, rgba(9, 9, 12, 0.08) 0%, rgba(9, 9, 12, 0.4) 100%);
	}

	.home-hero__inner {
		display: grid;
		align-content: end;
		gap: 0.85rem;
		min-height: inherit;
		padding: clamp(2rem, 5vw, 4rem) 0;
		color: #fffdf8;
	}

	.home-hero h1 {
		max-width: 6.5ch;
		margin: 0;
		font-family: var(--heading);
		font-size: clamp(3rem, 7vw, 6.1rem);
		line-height: 0.88;
		text-transform: uppercase;
	}

	.home-hero .lead {
		max-width: 34rem;
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.6;
		color: rgba(255, 253, 248, 0.85);
	}

	.home-hero__actions,
	.home-cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.home-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem 0.8rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 253, 248, 0.25);
		background: rgba(255, 253, 248, 0.14);
		color: #fffdf8;
		text-decoration: none;
		font-size: 0.78rem;
		backdrop-filter: blur(8px);
	}

	.home-pill--solid {
		border-color: transparent;
		background: var(--accent);
	}

	.partner-marquee {
		padding: 1.75rem 0 3.5rem;
		background: #fff;
	}

	.partner-marquee__inner {
		display: grid;
		gap: 1.85rem;
	}

	.partner-marquee__copy,
	.partner-marquee__proof,
	.credential-band__copy {
		margin: 0;
		font-size: 0.72rem;
		font-family: var(--meta);
		letter-spacing: 0.03em;
		text-align: center;
		color: #7b756e;
	}

	.partner-marquee__proof {
		color: #8a847d;
	}

	.logo-marquee {
		overflow: clip;
		mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
	}

	.logo-marquee__track {
		display: flex;
		align-items: center;
		gap: 4.5rem;
		width: max-content;
		animation: home-marquee 42s linear infinite;
		opacity: 0.12;
	}

	.logo-marquee__logo {
		flex: none;
		width: auto;
		height: clamp(36px, 4vw, 62px);
		object-fit: contain;
	}

	.credential-band {
		background: linear-gradient(180deg, #272522 0%, #3a352e 100%);
		color: #fffdf8;
	}

	.credential-band__inner {
		display: grid;
		gap: 1.35rem;
		padding: 1.3rem 0 1.5rem;
	}

	.credential-band__copy {
		color: rgba(255, 253, 248, 0.72);
	}

	.credential-band__grid {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 0.85rem;
		align-items: center;
	}

	.credential-card {
		display: grid;
		place-items: center;
		padding: 0.35rem;
		margin: 0;
		border-radius: 0.4rem;
	}

	.credential-card img {
		width: 100%;
		height: clamp(44px, 6vw, 76px);
		object-fit: contain;
	}

	.flagship-section {
		display: grid;
		grid-template-columns: 190px minmax(0, 1fr);
		gap: 1.5rem;
		padding: 2.85rem 0 2.4rem;
	}

	.section-kicker {
		margin: 0;
		max-width: 8ch;
		font-family: var(--heading);
		font-size: clamp(1.9rem, 3.4vw, 2.8rem);
		line-height: 0.92;
		text-transform: uppercase;
		color: var(--accent);
	}

	.flagship-section__stack {
		display: grid;
		gap: 1rem;
	}

	.flagship-row {
		display: grid;
		grid-template-columns: 150px minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
		padding: 0.8rem;
		border-radius: 0.9rem;
		background: #fff;
		border: 1px solid rgba(45, 42, 38, 0.08);
		box-shadow: 0 16px 32px rgba(45, 42, 38, 0.06);
	}

	.flagship-row__image {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 0.35rem;
	}

	.flagship-row__copy {
		display: grid;
		gap: 0.45rem;
	}

	.flagship-row__copy h2,
	.popular-card h2 {
		margin: 0;
		font-family: var(--heading);
		font-size: 1.4rem;
		line-height: 1;
		text-transform: uppercase;
	}

	.flagship-row__copy p {
		margin: 0;
		color: var(--muted);
		line-height: 1.65;
	}

	.flagship-row__link {
		width: fit-content;
		margin-top: 0.2rem;
		padding: 0.4rem 0.7rem;
		border-radius: 999px;
		border: 1px solid rgba(240, 93, 87, 0.18);
		background: rgba(240, 93, 87, 0.08);
		color: var(--accent-dark);
		text-decoration: none;
		font-size: 0.76rem;
	}

	.popular-section {
		padding-bottom: 2.4rem;
	}

	.popular-grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.1rem;
	}

	.popular-card {
		display: grid;
		gap: 0.7rem;
		text-decoration: none;
	}

	.popular-card__thumb {
		display: grid;
		place-items: center;
		aspect-ratio: 1 / 1;
		padding: 0.65rem;
		border-radius: 0.45rem;
		background: #0f0f12;
		overflow: clip;
	}

	.popular-card__thumb span {
		padding: 0 0.4rem;
		font-family: var(--heading);
		font-size: 1rem;
		line-height: 0.95;
		text-align: center;
		text-transform: uppercase;
		color: #fffdf8;
	}

	.popular-card__thumb-image {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.popular-card__thumb-image--hero {
		object-fit: cover;
	}

	.popular-card__meta {
		margin: 0;
		font-family: var(--meta);
		font-size: 0.68rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #8a847d;
	}

	.popular-card h2 {
		font-size: 1rem;
	}

	.home-cta {
		padding-bottom: 2.8rem;
	}

	.home-cta__inner {
		display: grid;
		gap: 1rem;
		padding: 1.25rem 1.35rem;
		border-radius: 1rem;
		background: linear-gradient(135deg, #3a352e 0%, #52493d 100%);
		color: #fffdf8;
	}

	.home-cta__copy {
		max-width: 42rem;
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.7;
	}

	@keyframes home-marquee {
		from {
			transform: translateX(0);
		}

		to {
			transform: translateX(calc(-50% - 1.75rem));
		}
	}

	@media (max-width: 980px) {
		.credential-band__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.flagship-section {
			grid-template-columns: 1fr;
		}

		.section-kicker {
			max-width: none;
		}

		.popular-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.home-hero {
			min-height: 480px;
		}

		.home-hero h1 {
			max-width: 6ch;
		}

		.credential-band__grid,
		.popular-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.flagship-row {
			grid-template-columns: 1fr;
		}
	}
</style>
