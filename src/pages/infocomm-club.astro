---
/**
 * /infocomm-club — Infocomm Club courses listing (IMDA LEARN Roadmaps 2027).
 * infocomm.club redirects here.
 */
import CtaBanner from '../components/CtaBanner.astro';
import BannerLayers from '../components/BannerLayers.astro';
import HeroEmailAction from '../components/HeroEmailAction.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getBannerAsset } from '../lib/banner-assets';
import { getStaticPage } from '../lib/data.js';
import { localiseFramerImage } from '../lib/media.js';

const page = getStaticPage('/infocomm-club');
if (!page) return Astro.redirect('/404');

const canonical = 'https://tinkercademy.com/infocomm-club/';

const heroImage = localiseFramerImage(page.hero_image ?? '');
const heroBanner = getBannerAsset(heroImage);
const heroTitle = page.hero_title ?? 'Infocomm Club Courses';
const heroLead =
	'IMDA LEARN Roadmaps 2027 programmes for school Infocomm Clubs — app development, UI/UX, and AI product design, fully funded by IMDA.';

const tracks = [
	{
		brand: 'Canva',
		heading: 'AI Product Design',
		note: 'AI-assisted product design that keeps human judgement at the centre — students explain what they intend to build before they prompt.',
		courses: [
			{
				title: 'AI Product Design with Canva Code',
				level: 'Secondary 1–5, JC 1–2',
				duration: '26 hours',
				body: 'Build a working digital product through structured prompting, user-centred interface design, structured data, and dashboards in Canva.',
				href: '/programmes/imda-canva-2027-sec/',
				image: '/images/banners/imda-canva-2027-sec.webp',
			},
		],
	},
	{
		brand: 'Apple',
		heading: 'App Development',
		note: 'Design and build apps on iPad. Two tracks, each 26 hours — pick Track A for design-first prototyping, Track B for Swift development, or run both across the year.',
		courses: [
			{
				title: 'Track A — App Design & Prototyping',
				level: 'Primary 4–6',
				duration: '26 hours',
				body: 'Identify user needs, plan screens and user flows, then build and present a clickable app prototype in Keynote on iPad.',
				href: '/programmes/imda-apple-2027-tracka-pri/',
				image: '/images/banners/imda-apple-2027-tracka-pri.webp',
			},
			{
				title: 'Track A — App Design & Prototyping',
				level: 'Secondary 1–5, JC 1–2',
				duration: '26 hours',
				body: 'Frame problems, design user flows with accessibility in mind, and build a high-fidelity prototype connected to Swift programming concepts.',
				href: '/programmes/imda-apple-2027-tracka-sec/',
				image: '/images/banners/imda-apple-2027-tracka-sec.webp',
			},
			{
				title: 'Track B — Swift App Development',
				level: 'Primary 4–6',
				duration: '26 hours',
				body: 'Move from prototype thinking into real app development: layouts, buttons, state, and navigation through guided SwiftUI mini-projects in Swift Playgrounds.',
				href: '/programmes/imda-apple-2027-trackb-pri/',
				image: '/images/banners/imda-apple-2027-trackb-pri.webp',
			},
			{
				title: 'Track B — Swift App Development',
				level: 'Secondary 1–5, JC 1–2',
				duration: '26 hours',
				body: 'Build working apps in Swift Playgrounds: SwiftUI views, state, navigation, and data modelling, ending in a capstone app presented to the class.',
				href: '/programmes/imda-apple-2027-trackb-sec/',
				image: '/images/banners/imda-apple-2027-trackb-sec.webp',
			},
		],
	},
	{
		brand: 'Figma',
		heading: 'UI/UX Design',
		note: 'Industry-grade design thinking and prototyping, on free Figma Education accounts. Secondary and JC students also get a guided introduction to AI-enabled prototyping with Figma Make.',
		courses: [
			{
				title: 'UI/UX Design',
				level: 'Primary 4–6',
				duration: '26 hours',
				body: 'Turn a school, home, or community problem into a persona, screen flow, and clickable Figma prototype — from idea canvas to presentation.',
				href: '/programmes/imda-figma-2027-pri/',
				image: '/images/banners/imda-figma-2027-pri.webp',
			},
			{
				title: 'UI/UX Design',
				level: 'Secondary 1–5, JC 1–2',
				duration: '26 hours',
				body: 'User research, wireframes, visual systems, and interactive prototypes — plus a guided lesson exploring AI-enabled prototyping with Figma Make.',
				href: '/programmes/imda-figma-2027-sec/',
				image: '/images/banners/imda-figma-2027-sec.webp',
			},
		],
	},
];
---

<ContentLayout
	title="Infocomm Club courses — Tinkercademy"
	description="IMDA LEARN Roadmaps 2027 courses for MOE Infocomm Clubs: Apple app development, Figma UI/UX design and Canva AI product design, for primary to JC."
	canonical={canonical}
	image={heroImage}
	preloadHero={heroBanner ? { src: heroBanner.background } : null}
>
	<section class="ic-hero">
		{heroImage && (
			<BannerLayers src={heroImage} alt={heroTitle} />
		)}
		<div class="ic-hero__scrim"></div>
		<div class="ic-hero__content shell">
			<h1 class="ic-hero__title">{heroTitle}</h1>
			<p class="ic-hero__lead">{heroLead}</p>
			<HeroEmailAction href="mailto:learn@tinkertanker.com" />
		</div>
	</section>

	<section class="ic-intro">
		<div class="shell">
			<p>
				These courses are held during CCA hours at MOE schools and build fundamental skills
				across app design, development, UI/UX, and AI-assisted product design. Each MOE school
				receives support for up to two classes annually, where
				<a
					href="https://www.imda.gov.sg/how-we-can-help/infocomm-media-clubs/learn-roadmaps"
					target="_blank"
					rel="noopener"
				>
					the training cost is fully funded by IMDA.
				</a>
			</p>
			<p>
				Schools apply through IMDA's LEARN Roadmaps application exercise — we're listed on the
				roadmap as Tinkertanker. To find out more, speak to us at
				<a href="mailto:learn@tinkertanker.com">learn@tinkertanker.com</a>. 🙋🏻‍♀️
			</p>
		</div>
	</section>

	{tracks.map((track, i) => (
		<section class:list={['ic-track', { 'ic-track--alt': i % 2 === 0 }]}>
			<div class="shell">
				<h2 class="ic-track__heading">
					<em class="ic-track__brand">{track.brand}</em> {track.heading}
				</h2>
				<p class="ic-track__note">{track.note}</p>
				<div class="ic-track__grid">
					{track.courses.map((course) => (
						<a class="ic-course-card" href={course.href}>
							<div class="ic-course-card__media">
								<img src={course.image} alt={`${course.title} course`} loading="lazy" />
							</div>
							<div class="ic-course-card__meta">
								<span class="ic-course-card__pill">{course.level}</span>
								<span class="ic-course-card__pill ic-course-card__pill--muted">{course.duration}</span>
							</div>
							<h3 class="ic-course-card__title">{course.title}</h3>
							<p class="ic-course-card__body">{course.body}</p>
							<span class="ic-course-card__cta">Read more →</span>
						</a>
					))}
				</div>
			</div>
		</section>
	))}

	<section class="ic-signup">
		<div class="shell">
			<h2 class="ic-signup__heading">Bring a course to your Infocomm Club</h2>
			<p class="ic-signup__note">
				Apply for these programmes through IMDA's LEARN Roadmaps application exercise, or write to
				us to plan the right track and level for your students.
			</p>
			<div class="ic-signup__grid">
				<a
					class="ic-signup__card"
					href="https://www.imda.gov.sg/how-we-can-help/infocomm-media-clubs/learn-roadmaps"
					target="_blank"
					rel="noopener"
				>
					<span class="ic-signup__label">IMDA LEARN Roadmaps — how funding works</span>
					<span class="ic-signup__arrow">→</span>
				</a>
				<a class="ic-signup__card" href="mailto:learn@tinkertanker.com">
					<span class="ic-signup__label">Enquire — learn@tinkertanker.com</span>
					<span class="ic-signup__arrow">→</span>
				</a>
			</div>
		</div>
	</section>

	<CtaBanner />
</ContentLayout>

<style>
	.ic-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: 480px;
		overflow: clip;
		background: #161111;
	}

	.ic-hero__scrim {
		position: absolute;
		inset: 0;
		background: var(--hero-desktop-scrim);
	}

	@media (max-width: 809px) {
		.ic-hero {
			min-height: var(--hero-mobile-min-height);
			--hero-content-padding-top: var(--hero-mobile-content-top);
		}

		.ic-hero__scrim {
			background: var(--hero-mobile-scrim);
		}
	}

	.ic-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: inherit;
		padding: var(--hero-content-padding-top, clamp(4rem, 8vw, 6rem)) 0 clamp(2.5rem, 4vw, 3.5rem);
		gap: 0.75rem;
	}

	.ic-hero__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 1;
		color: #fff;
		margin: 0;
		max-width: var(--hero-title-max-width);
		text-shadow: var(--hero-title-glow);
	}

	.ic-hero__lead {
		margin: 0;
		max-width: 48ch;
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.92);
	}

	.ic-intro {
		padding: 3rem 0;
	}

	.ic-intro p {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: var(--theme-text, rgb(51, 51, 51));
		margin: 0 0 0.9rem;
		max-width: 70ch;
	}

	.ic-intro a {
		color: var(--theme-link, var(--accent-dark));
	}

	.ic-track {
		padding: 3rem 0;
	}

	.ic-track--alt {
		background: var(--theme-surface-muted, #fafafa);
	}

	.ic-track__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 500;
		color: var(--theme-heading, rgb(23, 23, 23));
		margin: 0 0 0.5rem;
	}

	.ic-track__brand {
		font-style: italic;
		font-weight: 600;
		color: var(--accent, #f05d57);
	}

	.ic-track__note {
		font-family: 'Rubik', sans-serif;
		font-size: 0.98rem;
		line-height: var(--body-line-height);
		color: var(--theme-muted, rgb(110, 110, 110));
		margin: 0 0 1.5rem;
		max-width: 70ch;
	}

	.ic-course-card__media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 12px;
		background: rgb(245, 245, 245);
		margin: 0 0 0.25rem;
	}

	.ic-course-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.ic-course-card__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.ic-course-card__pill {
		display: inline-block;
		padding: 0.22rem 0.6rem;
		border-radius: 999px;
		background: var(--theme-tint, rgba(240, 93, 87, 0.09));
		color: var(--theme-link, var(--accent-dark));
		font-family: 'Rubik', sans-serif;
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.3;
	}

	.ic-course-card__pill--muted {
		background: rgb(245, 245, 245);
		color: var(--theme-muted, rgb(110, 110, 110));
	}

	.ic-track__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	@media (max-width: 899px) {
		.ic-track__grid {
			grid-template-columns: 1fr;
		}
	}

	.ic-course-card {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		padding: 1.5rem;
		background: var(--theme-surface, #fff);
		border: 1px solid var(--theme-border, rgb(229, 229, 229));
		border-radius: 16px;
		text-decoration: none;
		color: inherit;
		transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
	}

	.ic-course-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.07);
		border-color: rgba(240, 93, 87, 0.3);
	}

	.ic-course-card__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.2rem;
		font-weight: 500;
		color: var(--theme-heading, rgb(23, 23, 23));
		margin: 0;
	}

	.ic-course-card__body {
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		line-height: var(--body-line-height);
		color: var(--theme-text, rgb(51, 51, 51));
		margin: 0;
		flex: 1;
	}

	.ic-course-card__cta {
		font-family: 'Rubik', sans-serif;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--theme-link, var(--accent-dark));
	}

	.ic-signup {
		padding: 3rem 0;
		background: linear-gradient(135deg, #342c68 0%, #453881 100%);
		color: #fff;
	}

	.ic-signup__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 500;
		color: #fff;
		margin: 0 0 0.5rem;
	}

	.ic-signup__note {
		font-family: 'Rubik', sans-serif;
		font-size: 0.98rem;
		line-height: var(--body-line-height);
		color: rgba(255, 255, 255, 0.85);
		margin: 0 0 1.5rem;
		max-width: 70ch;
	}

	.ic-signup__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	@media (max-width: 899px) {
		.ic-signup__grid {
			grid-template-columns: 1fr;
		}
	}

	.ic-signup__card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.25rem 1.5rem;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 14px;
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		transition: background 0.15s, border-color 0.15s;
	}

	.ic-signup__card:hover {
		background: rgba(255, 255, 255, 0.12);
		border-color: rgba(255, 255, 255, 0.5);
	}

	.ic-signup__label {
		font-size: 0.95rem;
		font-weight: 500;
	}

	.ic-signup__arrow {
		font-size: 1.2rem;
		color: rgb(240, 93, 87);
	}
</style>
