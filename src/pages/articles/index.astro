---
import CtaBanner from '../../components/CtaBanner.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getSiteData } from '../../lib/data.js';

const { articles } = getSiteData();
const canonical = 'https://tinkercademy.com/articles/';

const sortedArticles = [...articles].sort((a, b) => {
	const da = a.date ? new Date(a.date).getTime() : 0;
	const db = b.date ? new Date(b.date).getTime() : 0;
	return db - da;
});

function formatDate(dateStr: string | null | undefined) {
	if (!dateStr) return '';
	const d = new Date(dateStr);
	return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<ContentLayout
	title="Articles — Tinkercademy"
	description="Insights and perspectives from the Tinkercademy team on coding education, corporate training, and technology."
	canonical={canonical}
>
	<section class="articles-hero">
		<div class="shell">
			<p class="eyebrow">Blog</p>
			<h1>Articles</h1>
			<p class="articles-hero__lead">
				Insights and perspectives from the Tinkercademy team.
			</p>
		</div>
	</section>

	<section class="articles-grid shell">
		{sortedArticles.map((article) => (
			<a class="article-card" href={`/articles/${article.slug}`}>
				{article.image && (
					<div class="article-card__image">
						<img src={article.image} alt={article.title} loading="lazy" />
					</div>
				)}
				<div class="article-card__body">
					{article.date && (
						<p class="article-card__date">{formatDate(article.date)}</p>
					)}
					<h2 class="article-card__title">{article.title}</h2>
					<p class="article-card__excerpt">
						{article.content_text?.slice(0, 160)}…
					</p>
					<span class="article-card__link">Read more →</span>
				</div>
			</a>
		))}
	</section>

	<CtaBanner />
</ContentLayout>

<style>
	/* ─── Hero ──────────────────────────────────────────────── */
	.articles-hero {
		padding: 3.5rem 0 2rem;
		background:
			radial-gradient(circle at top left, rgba(242, 93, 87, 0.22), transparent 42%),
			linear-gradient(135deg, #342c68 0%, #453881 42%, #251e51 100%);
		color: #fffdf8;
	}

	.articles-hero h1 {
		margin: 0;
		font-family: var(--heading);
		font-size: clamp(2.6rem, 6vw, 4.8rem);
		line-height: 0.95;
		text-transform: uppercase;
	}

	.articles-hero :global(.eyebrow) {
		color: rgba(255, 253, 248, 0.72);
	}

	.articles-hero__lead {
		max-width: 50ch;
		margin: 0.75rem 0 0;
		line-height: var(--body-line-height);
		color: rgba(255, 253, 248, 0.92);
	}

	/* ─── Card grid ────────────────────────────────────────── */
	.articles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2rem;
		padding-top: 2.5rem;
		padding-bottom: 2.5rem;
	}

	.article-card {
		display: flex;
		flex-direction: column;
		border-radius: 16px;
		overflow: hidden;
		background: #fff;
		border: 1px solid rgba(0, 0, 0, 0.08);
		box-shadow: 0 4px 20px rgba(45, 42, 38, 0.06);
		text-decoration: none;
		color: inherit;
		transition: box-shadow 0.2s, transform 0.2s;
	}

	.article-card:hover {
		box-shadow: 0 12px 32px rgba(45, 42, 38, 0.12);
		transform: translateY(-2px);
	}

	.article-card__image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.article-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s;
	}

	.article-card:hover .article-card__image img {
		transform: scale(1.03);
	}

	.article-card__body {
		padding: 1.25rem 1.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

	.article-card__date {
		margin: 0;
		font-family: 'Rubik', sans-serif;
		font-size: 0.8rem;
		font-weight: 400;
		color: rgb(140, 140, 140);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.article-card__title {
		margin: 0;
		font-family: 'Oswald', sans-serif;
		font-size: 1.2rem;
		font-weight: 500;
		line-height: 1.25;
		text-transform: uppercase;
		color: rgb(51, 51, 51);
	}

	.article-card__excerpt {
		margin: 0;
		font-family: 'Rubik', sans-serif;
		font-size: 0.88rem;
		line-height: var(--body-line-height);
		color: rgb(100, 100, 100);
		flex: 1;
	}

	.article-card__link {
		font-family: 'Rubik', sans-serif;
		font-size: 0.88rem;
		font-weight: 500;
		color: rgb(240, 93, 87);
	}

	@media (max-width: 809px) {
		.articles-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
