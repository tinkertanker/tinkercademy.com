---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import BlogNav from '../../../components/articles/BlogNav.astro';
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { BLOG_FEED_URL, BLOG_ORIGIN, BLOG_TITLE, SITE_ORIGIN, blogDateTime, formatBlogDate } from '../../../lib/blog';

export async function getStaticPaths() {
	return (await getCollection('blog')).map((story) => ({
		params: { year: String(story.data.publishedAt.getUTCFullYear()), slug: story.data.slug },
		props: { story },
	}));
}

const { story } = Astro.props as { story: CollectionEntry<'blog'> };
const { Content } = await render(story);
const modifiedAt = story.data.updatedAt ?? story.data.publishedAt;
const absoluteImage = story.data.heroImage ? new URL(story.data.heroImage, SITE_ORIGIN).toString() : undefined;
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: story.data.title,
	description: story.data.description,
	url: story.data.canonicalUrl,
	mainEntityOfPage: story.data.canonicalUrl,
	datePublished: blogDateTime(story.data.publishedAt, story.data.publishedAtPrecision),
	dateModified: modifiedAt.toISOString(),
	author: {
		'@type': 'Person',
		name: story.data.author.name,
		...(story.data.author.profileUrl ? { url: story.data.author.profileUrl } : {}),
	},
	publisher: { '@type': 'Organization', name: 'Tinkertanker Pte Ltd', url: 'https://tinkercademy.com/' },
	...(absoluteImage ? { image: absoluteImage } : {}),
	copyrightNotice: 'All rights reserved. Copyright ownership remains with the applicable rights holder.',
	isPartOf: { '@type': 'Blog', name: BLOG_TITLE, url: `${BLOG_ORIGIN}/` },
};
---

<ContentLayout
	title={`${story.data.title} — ${BLOG_TITLE}`}
	description={story.data.description}
	canonical={story.data.canonicalUrl}
	image={story.data.heroImage}
	ogType="article"
	internalLinkOrigin="https://tinkercademy.com"
	showSearch={false}
	alternateFeed={{ title: `${BLOG_TITLE} RSS feed`, href: BLOG_FEED_URL }}
	structuredData={articleSchema}
>
	<BlogNav />
	<article class="blog-article">
		<header class="blog-article__header">
			<div class="shell blog-article__header-inner">
				<h1>{story.data.title}</h1>
				{story.data.subtitle && <p class="blog-article__subtitle">{story.data.subtitle}</p>}
				<p class="blog-article__byline">
					<span>By </span>
					{story.data.author.profileUrl ? (
						<a href={story.data.author.profileUrl} rel="author">{story.data.author.name}</a>
					) : story.data.author.name}
					<span aria-hidden="true"> · </span>
					<time datetime={blogDateTime(story.data.publishedAt, story.data.publishedAtPrecision)}>{formatBlogDate(story.data.publishedAt, story.data.publishedAtPrecision)}</time>
				</p>
			</div>
		</header>

		<div class="blog-article__body prose shell">
			<Content />
		</div>

		<footer class="blog-article__footer shell">
			{story.data.tags.length > 0 && (
				<ul class="blog-article__tags" aria-label="Topics">
					{story.data.tags.map((tag) => <li>{tag.name}</li>)}
				</ul>
			)}
			<p><strong>{story.data.license}.</strong> Copyright ownership remains with the credited author or other applicable rights holder.</p>
			{story.data.sourceMediumUrl && (
				<p class="blog-article__source"><strong>Source:</strong> <a href={story.data.sourceMediumUrl} rel="alternate">{story.data.title} on Medium</a></p>
			)}
		</footer>
	</article>
</ContentLayout>

<style>
	.blog-article__header {
		background: linear-gradient(145deg, #f2e5de, #e7d6cd);
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
	}

	.blog-article__header-inner {
		max-width: 52rem;
		padding-top: 3.5rem;
		padding-bottom: 3rem;
	}

	.blog-article__header h1 {
		margin: 0;
		font-family: var(--heading);
		font-size: var(--page-title-font-size);
		line-height: 1.05;
	}

	.blog-article__subtitle {
		margin: 1rem 0;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgb(80, 80, 80);
	}

	.blog-article__byline {
		margin: 1rem 0 0;
		color: rgb(85, 85, 85);
	}

	.blog-article__byline a,
	.blog-article__footer a {
		color: var(--accent-dark);
		text-underline-offset: 0.18em;
	}

	.blog-article__body {
		max-width: 52rem;
		padding-top: 1rem;
		padding-bottom: 2rem;
	}

	.blog-article__body :global(p),
	.blog-article__body :global(li),
	.blog-article__body :global(blockquote) {
		max-width: none;
		font-size: 1rem;
		line-height: 1.7;
	}

	.blog-article__body :global(h2) {
		font-size: 1.7rem;
	}

	.blog-article__body :global(h3) {
		font-size: 1.2rem;
		font-weight: 500;
	}

	.blog-article__body :global(img) {
		width: auto;
		max-width: 100%;
		height: auto;
		margin: 1.75rem auto 0.5rem;
		border-radius: 0.5rem;
	}

	.blog-article__body :global(.article-link-card) {
		display: block;
		margin: 1.75rem 0;
		padding: 1.1rem 1.2rem;
		border: 1px solid rgba(0, 0, 0, 0.12);
		border-radius: 0.75rem;
		background: #fffaf7;
		line-height: 1.5;
	}

	.blog-article__body :global(.article-link-card a) {
		color: var(--text);
		text-decoration-color: var(--accent-dark);
		text-underline-offset: 0.2em;
	}

	.blog-article__body :global(blockquote) {
		margin: 1.5rem 0;
		padding-left: 1rem;
		border-left: 4px solid rgba(189, 58, 52, 0.55);
		color: rgb(70, 70, 70);
	}

	.blog-article__body :global(pre) {
		overflow-x: auto;
		padding: 1rem;
		border-radius: 0.5rem;
		background: rgb(35, 35, 35);
		color: #fff;
	}

	.blog-article__body :global(code) {
		font-family: 'Fragment Mono', monospace;
	}

	.blog-article__body :global(:not(pre) > code) {
		overflow-wrap: anywhere;
	}

	.blog-article__footer {
		max-width: 52rem;
		padding-top: 1.5rem;
		padding-bottom: 4rem;
		border-top: 1px solid rgba(0, 0, 0, 0.12);
		font-size: 0.9rem;
		color: rgb(75, 75, 75);
	}

	.blog-article__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
	}

	.blog-article__tags li {
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		background: rgba(189, 58, 52, 0.09);
		color: var(--accent-dark);
		font-size: 0.8rem;
		font-weight: 500;
	}

	.blog-article__source {
		margin-top: 1.25rem;
	}
</style>
