---
/**
 * /open-source — Tinkercademy's free, open-source tools.
 *
 * The small tools we built for our own work (clients, classes, ourselves) and
 * opened up for anyone to use or self-host. Standalone Astro page (no Framer/
 * imported data); the shared tool catalogue is the single source of truth.
 *
 * Framing nods to Vaughn Tan's "boring tiny tools":
 * https://vaughntan.org/boringtinytools
 */
import CtaBanner from '../components/CtaBanner.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { openSourceTools } from '../lib/open-source';

const canonical = 'https://tinkercademy.com/open-source/';

const githubOrg = 'https://github.com/tinkertanker';
---

<ContentLayout
	title="Open source — free tools, built by us | Tinkercademy"
	description="We're a small Singapore team that ships more software than our size suggests. Some of it becomes a tiny tool that does one job well, so we give it away: classroom widgets, a certificate generator, a screen-rewind Mac app, a micro:bit AI assistant, and more."
	canonical={canonical}
>
	<section class="os-hero">
		<div class="os-hero__glow" aria-hidden="true"></div>
		<div class="os-hero__content shell">
			<h1 class="os-hero__title">Built for our work.<br /><span class="os-hero__accent">Shared for yours.</span></h1>
			<p class="os-hero__lead">
				When we're not building curriculum, kits, and the next generation of builders, we love
				building software.
			</p>
			<p class="os-hero__lead">
				We build for ourselves, and for the community:
				<a href="https://vaughntan.org/boringtinytools" target="_blank" rel="noopener">boring tiny tools</a>,
				each of which does one job well. Free! Borrow them, fork them, or just nick the idea.
			</p>
			<div class="os-hero__actions">
				<a class="os-hero__cta" href={githubOrg} target="_blank" rel="noopener">
					Browse our GitHub
				</a>
				<a class="os-hero__cta os-hero__cta--ghost" href="#tools">See the tools ↓</a>
			</div>
		</div>
	</section>

	<section class="os-tools" id="tools">
		<div class="shell">
			<div class="os-grid">
				{openSourceTools.map((tool) => (
					<article class="os-card">
						<div class="os-card__media">
							{tool.image ? (
								<img src={tool.image} alt={`${tool.name} screenshot`} loading="lazy" />
							) : (
								<div class="os-term" role="img" aria-label={`${tool.name} command-line example`}>
									<div class="os-term__bar">
										<span></span><span></span><span></span>
									</div>
									<pre class="os-term__body">{tool.terminal?.join('\n')}</pre>
								</div>
							)}
						</div>

						<div class="os-card__body">
							<h2 class="os-card__name">{tool.name}</h2>
							<p class="os-card__tagline">{tool.tagline}</p>
							<p class="os-card__desc">{tool.description}</p>
							<p class="os-card__handy">
								<span class="os-card__handy-label">For</span>
								{tool.handyFor}
							</p>

							<ul class="os-card__tags">
								<li class="os-card__tag os-card__tag--platform">{tool.platform}</li>
								<li class="os-card__tag">{tool.builtWith}</li>
								<li class="os-card__tag">{tool.access}</li>
							</ul>
						</div>

						<footer class="os-card__footer">
							<a
								class="os-card__primary"
								href={tool.primaryHref}
								target="_blank"
								rel="noopener"
							>
								{tool.primaryLabel}
							</a>
							{tool.primaryHref !== tool.repoUrl && (
								<a class="os-card__source" href={tool.repoUrl} target="_blank" rel="noopener">
									Source ↗
								</a>
							)}
						</footer>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="os-outro">
		<div class="shell os-outro__inner">
			<h2 class="os-outro__heading">Built something with one of these?</h2>
			<p class="os-outro__body">
				It's all on GitHub. File an issue, send a pull request, or go build your own. We don't track
				downloads, so a GitHub star is honestly how we find out anyone's using them.
			</p>
			<a class="os-outro__cta" href={githubOrg} target="_blank" rel="noopener">
				github.com/tinkertanker ↗
			</a>
		</div>
	</section>

	<CtaBanner />
</ContentLayout>

<style>
	/* ── Hero ── */
	.os-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		overflow: clip;
		background: #0a0a0a;
		color: #fff;
	}

	.os-hero__glow {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(60% 80% at 18% 0%, rgba(240, 93, 87, 0.4) 0%, rgba(240, 93, 87, 0) 60%),
			radial-gradient(50% 70% at 100% 100%, rgba(240, 93, 87, 0.18) 0%, rgba(240, 93, 87, 0) 55%);
		opacity: 0.9;
	}

	.os-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 5vw, 4rem);
	}

	.os-hero__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 1;
		color: #fff;
		margin: 0;
		text-wrap: balance;
	}

	.os-hero__accent {
		color: rgb(240, 93, 87);
	}

	.os-hero__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.92);
		margin: 0;
		max-width: 70%;
	}

	@media (max-width: 809px) {
		.os-hero__lead {
			max-width: 100%;
		}
	}

	.os-hero__lead a {
		color: rgba(255, 255, 255, 0.92);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.os-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.os-hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0.7rem 1.3rem;
		border-radius: 999px;
		background: var(--accent-dark);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.92rem;
		font-weight: 500;
		transition: background 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
	}

	.os-hero__cta:hover {
		background: rgb(154, 44, 39);
		transform: translateY(-1px);
	}

	.os-hero__cta--ghost {
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.28);
	}

	.os-hero__cta--ghost:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.5);
	}

	/* ── Tools grid ── */
	.os-tools {
		padding: clamp(2.5rem, 5vw, 4rem) 0 1rem;
	}

	.os-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	@media (max-width: 809px) {
		.os-grid {
			grid-template-columns: 1fr;
		}
	}

	.os-card {
		display: flex;
		flex-direction: column;
		background: #fff;
		border: 1px solid rgb(229, 229, 229);
		border-radius: 18px;
		overflow: hidden;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
	}

	.os-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 18px 44px rgba(0, 0, 0, 0.12);
	}

	.os-card__media {
		position: relative;
		aspect-ratio: 16 / 10;
		background: #f3f3f3;
		overflow: hidden;
		border-bottom: 1px solid rgb(235, 235, 235);
	}

	.os-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.os-card:hover .os-card__media img {
		transform: scale(1.04);
	}

	/* Terminal mock for tools without a screenshot */
	.os-term {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		background: linear-gradient(160deg, #1c1b29 0%, #14131d 100%);
	}

	.os-term__bar {
		display: flex;
		gap: 0.4rem;
		padding: 0.7rem 0.85rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.os-term__bar span {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.22);
	}

	.os-term__bar span:first-child {
		background: rgb(240, 93, 87);
	}

	.os-term__body {
		margin: 0;
		padding: 1rem 1.1rem;
		font-family: 'Fragment Mono', monospace;
		font-size: 0.82rem;
		line-height: 1.55;
		color: rgba(235, 235, 245, 0.92);
		white-space: pre-wrap;
		word-break: break-word;
		overflow: hidden;
	}

	.os-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.35rem 1.4rem 0.5rem;
		flex: 1;
	}

	.os-card__name {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.45rem;
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0;
	}

	.os-card__tagline {
		font-family: 'Rubik', sans-serif;
		font-size: 0.98rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--accent-dark);
		margin: 0;
	}

	.os-card__desc {
		font-family: 'Rubik', sans-serif;
		font-size: 0.92rem;
		line-height: 1.55;
		color: rgb(90, 90, 90);
		margin: 0;
	}

	.os-card__handy {
		font-family: 'Rubik', sans-serif;
		font-size: 0.88rem;
		line-height: 1.45;
		color: rgb(70, 70, 70);
		margin: 0.15rem 0 0;
	}

	.os-card__handy-label {
		display: inline-block;
		margin-right: 0.45rem;
		font-family: 'Rubik', sans-serif;
		font-size: 0.66rem;
		font-weight: 500;
		letter-spacing: 0.035em;
		text-transform: uppercase;
		color: rgb(110, 110, 110);
	}

	.os-card__tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.6rem 0 0;
		padding: 0;
	}

	.os-card__tag {
		font-family: 'Rubik', sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.01em;
		color: rgb(95, 95, 95);
		background: #f3f3f3;
		border-radius: 6px;
		padding: 0.3rem 0.6rem;
	}

	.os-card__tag--platform {
		color: var(--accent-dark);
		background: rgba(240, 93, 87, 0.1);
	}

	.os-card__footer {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.1rem 1.4rem 1.4rem;
		margin-top: auto;
	}

	.os-card__primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 40px;
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		background: var(--accent-dark);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.88rem;
		font-weight: 500;
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.os-card__primary:hover {
		background: rgb(154, 44, 39);
		transform: translateY(-1px);
	}

	.os-card__source {
		font-family: 'Rubik', sans-serif;
		font-size: 0.85rem;
		font-weight: 500;
		color: rgb(90, 90, 90);
		text-decoration: none;
	}

	.os-card__source:hover {
		color: var(--accent-dark);
	}

	/* ── Outro ── */
	.os-outro {
		padding: clamp(2.5rem, 5vw, 4rem) 0;
	}

	.os-outro__inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.8rem;
		padding: clamp(1.8rem, 4vw, 2.8rem);
		border-radius: 20px;
		background: #fafafa;
		border: 1px solid rgb(235, 235, 235);
	}

	.os-outro__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0;
	}

	.os-outro__body {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: rgb(90, 90, 90);
		margin: 0;
		max-width: 60ch;
	}

	.os-outro__cta {
		font-family: 'Rubik', sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--accent-dark);
		text-decoration: none;
		margin-top: 0.4rem;
	}

	.os-outro__cta:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
