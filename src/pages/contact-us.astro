---
import ContentLayout from '../layouts/ContentLayout.astro';
import { getStaticPage } from '../lib/data.js';

const page = getStaticPage('/contact-us');
if (!page) return Astro.redirect('/404');

const canonical = new URL('/contact-us', 'https://tinkercademy.com').toString();

const sectionIcons = {
	address:
		'M12 3.25 18.5 5.6v13.3l-5.35-1.93-2.3.83-5.35-1.93V2.1l5.35 1.93Zm.2 2.2v10.42l3.1 1.12V6.57Zm-4.95.12v10.4l2.95 1.06V6.63Z',
	directions:
		'M11.9 2.8 18.7 9.6l-4.2 4.23-1.8-1.8 1.15-1.17H9.2v3.76H6.65v-6.3h7.17l-1.12-1.13-1.8-1.8Z',
	parking:
		'M7.1 6.2h9.8c.86 0 1.63.54 1.9 1.35l1.25 3.74h.71v2.36h-1.1v2.2H17.1v-2.2H6.9v2.2H4.35v-2.2h-1.1v-2.36h.71L5.2 7.55A2 2 0 0 1 7.1 6.2Zm.28 1.95-.9 2.84h10.98l-.9-2.84ZM7.55 14.4a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2Zm8.9 0a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2Z',
};
---

<>
<ContentLayout
	title={page.seo?.title ?? 'Contact Us — Tinkercademy'}
	description={page.seo?.description ?? page.description ?? ''}
	canonical={canonical}
	image={page.hero_image ?? undefined}
>
	<section class="contact-page">
		<div class="shell contact-page__inner">
			<div class="contact-page__hero">
				<h1>{page.hero_title ?? 'Get in touch'}</h1>
			</div>

			<div class="contact-form-shell">
				<div class="contact-form-card">
					<div class="contact-form-card__header">
						<h2>Tinkercademy Course Enquiry Form</h2>
						<p>
							Please fill in this form, or email us at
							<a href="mailto:hello@tk.sg">hello@tk.sg</a>, and we&apos;ll get back to you
							ASAP!
						</p>
					</div>

					<form
						class="contact-form"
						action="https://submit.jotform.com/submit/251391353870054"
						method="post"
						accept-charset="utf-8"
						autocomplete="on"
					>
						<input type="hidden" name="formID" value="251391353870054" />
						<input type="hidden" name="simple_spc" value="251391353870054-251391353870054" />
						<input type="hidden" name="submitSource" value="direct" />

						<div class="contact-form__grid">
							<label class="contact-field">
								<span>Name <strong>*</strong></span>
								<input type="text" name="q34_name" required />
							</label>

							<label class="contact-field">
								<span>School/Organisation</span>
								<input type="text" name="q31_org" />
							</label>

							<label class="contact-field">
								<span>Email <strong>*</strong></span>
								<input type="email" name="q4_email" placeholder="example@example.com" required />
							</label>

							<label class="contact-field">
								<span>Phone Number</span>
								<input type="tel" name="q42_phoneNumber[full]" inputmode="numeric" placeholder="00000000" />
								<small>Optional, if you prefer to be contacted via phone.</small>
							</label>

							<label class="contact-field contact-field--full">
								<span>Course Name or Topic</span>
								<input type="text" name="q40_course" />
							</label>

							<label class="contact-field contact-field--full">
								<span>Comments/Questions</span>
								<textarea name="q41_comments" rows="7"></textarea>
							</label>
						</div>

						<div class="contact-form__actions">
							<button type="submit">Submit</button>
						</div>

						<div class="contact-form__honeypot" aria-hidden="true">
							<label>
								Should be empty
								<input type="text" name="website" tabindex="-1" autocomplete="off" />
							</label>
						</div>
					</form>
				</div>
			</div>

			<div class="visit-card">
				<h2 class="visit-card__title">Getting here</h2>

				<section class="visit-block visit-block--address">
					<div class="visit-block__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" focusable="false">
							<path d={sectionIcons.address}></path>
						</svg>
					</div>
					<h3>Address</h3>
					<p class="visit-block__lead">
						59 Jalan Pemimpin #04-01, L&amp;Y Building, Singapore 577218
					</p>
					<p>Weekdays: 10 am – 5.30 pm</p>
					<p>Weekends: 10 am – 1 pm</p>
					<div class="visit-block__map">
						<iframe
							src="https://www.google.com/maps?q=Tinkercademy%20(Tinkertanker%20Pte%20Ltd)%2C%2059%20Jalan%20Pemimpin%20%2304-01%2C%20Singapore%20577218&z=16&output=embed"
							title="Tinkercademy on Google Maps"
							loading="lazy"
							allowfullscreen
						></iframe>
					</div>
				</section>

				<section class="visit-block visit-block--directions">
					<div class="visit-block__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" focusable="false">
							<path d={sectionIcons.directions}></path>
						</svg>
					</div>
					<h3>Directions</h3>
					<p class="visit-block__lead">Nearest MRT: Marymount</p>
					<p>
						By Bus: From Bishan MRT and Bus Stop 53239 (Bus 13, 50, 52, 54, 55, 55B, 58,
						71, 88, 156).<br />
						From Bus Stop 53131 (Bus 54, 74, 851, 852).
					</p>
					<p>
						Once you reach the L&amp;Y Building, go around the building to find the entrance.<br />
						Take the lift to the 4th floor and turn right. You made it!
					</p>
					<div class="visit-gallery visit-gallery--stack">
						<img
							src="/images/Y5ckhN7Nwo504xYtcd1f4y6Wy78.png"
							alt="Approaching the L&amp;Y Building entrance"
							loading="lazy"
						/>
						<img
							src="/images/b0uc8kk9c3m8176vXRgsJwEWk.png"
							alt="Walking path towards the entrance"
							loading="lazy"
						/>
						<img
							src="/images/ruSDPHaMjLP5DCdMnqVrqSp0Fs.png"
							alt="Entrance doors at the L&amp;Y Building"
							loading="lazy"
						/>
					</div>
				</section>

				<section class="visit-block visit-block--parking">
					<div class="visit-block__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" focusable="false">
							<path d={sectionIcons.parking}></path>
						</svg>
					</div>
					<h3>Parking</h3>
					<p class="visit-block__lead">
						The car park is accessible from the front entrance, beside Jackie&apos;s yellow
						and blue building.
					</p>
					<div class="visit-gallery visit-gallery--single">
						<img
							src="/images/GcgNecJtTyHUa4L23kutskeQQ.png"
							alt="Parking access guide with nearby landmarks and lift lobby"
							loading="lazy"
						/>
					</div>
					<div class="parking-rates">
						<p>Parking rates:</p>
						<p>Mon – Sat</p>
						<p>8 am – 6 pm</p>
						<p>$1.20 per hour or part thereof</p>
						<p>6 pm – 8 am</p>
						<p>$2.00 per entry</p>
						<p>Sunday &amp; Public Holidays</p>
						<p>$2.00 per entry</p>
					</div>
				</section>
			</div>
		</div>
	</section>
</ContentLayout>

<style>
	.contact-page {
		padding: 3rem 0 0;
	}

	.contact-page__inner {
		display: grid;
		gap: 2.5rem;
	}

	.contact-page__hero {
		text-align: center;
	}

	.contact-page__hero h1,
	.visit-card__title,
	.visit-block h3 {
		margin: 0;
		font-family: var(--heading);
		font-weight: 600;
		line-height: 0.95;
		text-transform: none;
		color: #f5635b;
	}

	.contact-page__hero h1,
	.visit-card__title {
		font-size: clamp(3rem, 5vw, 4.6rem);
	}

	.visit-block h3 {
		font-size: clamp(2.3rem, 4vw, 3.3rem);
	}

	.contact-form-shell {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0.7rem;
		border-radius: 0;
		background: #f2f2ff;
	}

	.contact-form-card,
	.visit-card {
		background: #fff;
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
	}

	.contact-form-card {
		border: 1px solid rgba(0, 0, 0, 0.08);
	}

	.contact-form-card__header {
		padding: 3rem 3rem 2rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.12);
	}

	.contact-form-card__header h2 {
		margin: 0;
		font-family: var(--heading);
		font-size: clamp(2.4rem, 4vw, 3.8rem);
		font-weight: 600;
		line-height: 1.02;
		color: #2f3b54;
	}

	.contact-form-card__header p,
	.visit-block p,
	.contact-field span,
	.contact-field small {
		font-family: var(--meta);
		color: #2f3b54;
		line-height: 1.5;
	}

	.contact-form-card__header p {
		margin: 0.75rem 0 0;
		font-size: 1.15rem;
	}

	.contact-form-card__header a {
		color: inherit;
	}

	.contact-form {
		padding: 3rem;
	}

	.contact-form__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 2.5rem;
	}

	.contact-field {
		display: grid;
		gap: 0.55rem;
	}

	.contact-field--full {
		grid-column: 1 / -1;
	}

	.contact-field span {
		font-size: 1rem;
		font-weight: 500;
	}

	.contact-field strong {
		color: #f5635b;
	}

	.contact-field input,
	.contact-field textarea {
		width: 100%;
		padding: 1rem 1.05rem;
		border: 1px solid #b8c2d6;
		border-radius: 0.45rem;
		background: #fff;
		font-family: var(--meta);
		font-size: 1rem;
		color: #2f3b54;
	}

	.contact-field textarea {
		min-height: 15rem;
		resize: vertical;
	}

	.contact-field input::placeholder {
		color: #92a0bd;
	}

	.contact-field input:focus,
	.contact-field textarea:focus {
		outline: 2px solid rgba(55, 122, 255, 0.16);
		outline-offset: 2px;
		border-color: #97a6c8;
	}

	.contact-field small {
		font-size: 0.92rem;
	}

	.contact-form__actions {
		display: flex;
		justify-content: center;
		padding-top: 2.25rem;
	}

	.contact-form__actions button {
		min-width: 17rem;
		padding: 1rem 1.4rem;
		border: 0;
		border-radius: 0.45rem;
		background: #1fc158;
		color: #fff;
		font-family: var(--meta);
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
	}

	.contact-form__honeypot {
		position: absolute;
		left: -9999px;
	}

	.visit-card {
		max-width: 72rem;
		margin: 0 auto;
		padding: 3rem 2.2rem 3.4rem;
		border-radius: 0 0 1.75rem 1.75rem;
	}

	.visit-card__title {
		text-align: center;
		margin-bottom: 2rem;
	}

	.visit-block {
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.visit-block + .visit-block {
		margin-top: 2.6rem;
	}

	.visit-block__icon {
		width: 4.5rem;
		height: 4.5rem;
		color: #f5635b;
	}

	.visit-block__icon svg {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}

	.visit-block__lead {
		margin-top: 0.9rem;
	}

	.visit-block p {
		margin: 0.35rem 0 0;
		max-width: 54rem;
		font-size: 1.02rem;
		color: #222;
	}

	.visit-block__map,
	.visit-gallery {
		width: 100%;
		max-width: 66rem;
		margin-top: 1.25rem;
		border-radius: 1.6rem;
		overflow: hidden;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
	}

	.visit-block__map iframe {
		display: block;
		width: 100%;
		min-height: 37rem;
		border: 0;
	}

	.visit-gallery--stack {
		display: grid;
		gap: 1rem;
		background: transparent;
		box-shadow: none;
		border-radius: 0;
		overflow: visible;
	}

	.visit-gallery--stack img {
		display: block;
		width: 100%;
		border-radius: 1.6rem;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
	}

	.visit-gallery--single img {
		display: block;
		width: 100%;
	}

	.parking-rates {
		margin-top: 1rem;
		text-align: center;
		font-family: var(--meta);
		font-size: 1.04rem;
		line-height: 1.45;
		color: #222;
	}

	.parking-rates p {
		margin: 0.1rem 0;
	}

	@media (max-width: 900px) {
		.contact-page {
			padding-top: 2rem;
		}

		.contact-form-card__header,
		.contact-form,
		.visit-card {
			padding-left: 1.25rem;
			padding-right: 1.25rem;
		}

		.contact-form__grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.4rem;
		}

		.contact-form-card__header {
			padding-top: 2rem;
			padding-bottom: 1.5rem;
		}

		.contact-form {
			padding-top: 2rem;
			padding-bottom: 2rem;
		}

		.contact-form__actions button {
			width: 100%;
			min-width: 0;
		}

		.visit-card {
			padding-top: 2rem;
			padding-bottom: 2.4rem;
			border-radius: 0 0 1.25rem 1.25rem;
		}

		.visit-block__map iframe {
			min-height: 22rem;
		}
	}
</style>
</>
