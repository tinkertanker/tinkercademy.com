---
import CtaBanner from '../components/CtaBanner.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getStaticPage } from '../lib/data.js';

const page = getStaticPage('/contact-us');
if (!page) return Astro.redirect('/404');

const canonical = new URL('/contact-us', 'https://tinkercademy.com').toString();
---

<>
<ContentLayout
	title={page.seo?.title ?? 'Contact Us — Tinkercademy'}
	description={page.seo?.description ?? page.description ?? ''}
	canonical={canonical}
	image={page.hero_image ?? undefined}
>
	<section class="contact-hero">
		<div class="shell contact-hero__inner">
			<div>
				<p class="contact-hero__eyebrow">Contact</p>
				<h1 class="contact-hero__title">{page.hero_title ?? 'Get in touch'}</h1>
				<p class="contact-hero__lead">
					Visit us for classes, workshops, and meetings. The quickest way to reach us is
					by email at <a href="mailto:hello@tk.sg">hello@tk.sg</a> or by phone at
					<a href="tel:+6569176920"> 6917 6920</a>.
				</p>
			</div>
			<div class="contact-hero__card">
				<h2>{page.hero_lead ?? 'Getting here'}</h2>
				<p>59 Jalan Pemimpin #04-01, L&amp;Y Building, Singapore 577218</p>
				<p>Weekdays: 10 am – 5.30 pm</p>
				<p>Weekends: 10 am – 1 pm</p>
				<a class="contact-hero__cta" href="https://maps.google.com/?q=59+Jalan+Pemimpin+%2304-01+Singapore+577218" target="_blank" rel="noopener noreferrer">
					Open in Maps
				</a>
			</div>
		</div>
	</section>

	<section class="contact-details">
		<div class="shell contact-details__grid">
			<article class="contact-panel">
				<h2>Address</h2>
				<p>59 Jalan Pemimpin #04-01, L&amp;Y Building, Singapore 577218</p>
				<p><strong>Nearest MRT:</strong> Marymount</p>
				<p>
					The entrance is around the building. Take the lift to the 4th floor and turn
					right once you arrive.
				</p>
				<div class="contact-panel__media">
					<img src="/images/remote/ruSDPHaMjLP5DCdMnqVrqSp0Fs.png" alt="Entrance directions" loading="lazy" />
					<img src="/images/remote/b0uc8kk9c3m8176vXRgsJwEWk.png" alt="Building entrance" loading="lazy" />
				</div>
			</article>

			<article class="contact-panel">
				<h2>Directions</h2>
				<p>
					<strong>By bus:</strong> From Bishan MRT and Bus Stop 53239, take 13, 50, 52,
					54, 55, 55B, 58, 71, 88, or 156. From Bus Stop 53131, take 54, 74, 851, or
					852.
				</p>
				<p>
					Once you reach the L&amp;Y Building, head around the side of the building to find
					the entrance, then take the lift up to us.
				</p>
				<div class="contact-map">
					<iframe
						class="contact-map__iframe"
						src="https://maps.google.com/maps?q=Tinkercademy&z=15&output=embed"
						title="Tinkercademy on Google Maps"
						loading="lazy"
						allowfullscreen
					></iframe>
				</div>
			</article>

			<article class="contact-panel contact-panel--wide">
				<h2>Parking</h2>
				<p>
					The car park is accessible from the front entrance, beside Jackie&apos;s yellow and
					blue building.
				</p>
				<div class="parking-grid">
					<div>
						<h3>Mon – Sat</h3>
						<p>8 am – 6 pm: $1.20 per hour or part thereof</p>
						<p>6 pm – 8 am: $2.00 per entry</p>
					</div>
					<div>
						<h3>Sunday &amp; Public Holidays</h3>
						<p>$2.00 per entry</p>
					</div>
				</div>
				<div class="contact-panel__media contact-panel__media--single">
					<img src="/images/remote/GcgNecJtTyHUa4L23kutskeQQ.png" alt="Parking area" loading="lazy" />
				</div>
			</article>
		</div>
	</section>

	<CtaBanner />
</ContentLayout>

<style>
	.contact-hero {
		padding: 3rem 0 2rem;
	}

	.contact-hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
		gap: 1.5rem;
		align-items: start;
	}

	.contact-hero__eyebrow {
		margin: 0 0 0.75rem;
		font-family: 'Fragment Mono', monospace;
		font-size: 0.8rem;
		text-transform: uppercase;
		color: rgb(202, 67, 61);
	}

	.contact-hero__title {
		margin: 0 0 1rem;
		font-family: 'Oswald', sans-serif;
		font-size: clamp(2rem, 5vw, 3.6rem);
		line-height: 0.95;
		text-transform: uppercase;
	}

	.contact-hero__lead,
	.contact-panel p {
		margin: 0;
		font-family: 'Rubik', sans-serif;
		line-height: 1.7;
		color: rgb(51, 51, 51);
	}

	.contact-hero__lead a {
		color: rgb(240, 93, 87);
	}

	.contact-hero__card,
	.contact-panel {
		padding: 1.4rem;
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 24px;
		background: #fff;
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.05);
	}

	.contact-hero__card h2,
	.contact-panel h2,
	.contact-panel h3 {
		margin: 0 0 0.75rem;
		font-family: 'Oswald', sans-serif;
		color: rgb(23, 23, 23);
	}

	.contact-hero__cta {
		display: inline-flex;
		margin-top: 1rem;
		padding: 0.75rem 1rem;
		border-radius: 999px;
		background: rgb(240, 93, 87);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
	}

	.contact-details {
		padding: 0 0 3rem;
	}

	.contact-details__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.contact-panel {
		display: grid;
		gap: 0.85rem;
	}

	.contact-panel--wide {
		grid-column: 1 / -1;
	}

	.contact-panel__media {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 0.5rem;
	}

	.contact-panel__media--single {
		grid-template-columns: minmax(0, 1fr);
		max-width: 520px;
	}

	.contact-panel__media img,
	.contact-map__iframe {
		width: 100%;
		border: 0;
		border-radius: 20px;
	}

	.contact-map__iframe {
		min-height: 300px;
	}

	.parking-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	@media (max-width: 900px) {
		.contact-hero__inner,
		.contact-details__grid,
		.parking-grid,
		.contact-panel__media {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
</>
