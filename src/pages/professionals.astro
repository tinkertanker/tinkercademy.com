---
/**
 * /professionals — Astro-native rebuild of the live tinkercademy.com professionals page.
 *
 * Sections:
 *   1. Hero
 *   2. Our Value Proposition (3-up cards)
 *   3. Our Corporate Clients (logo strip)
 *   4. Let's Work Together! (pivot pills)
 *   5. Professional Courses (programme cards)
 *   6. Closing CTA banner
 */
import CtaBanner from '../components/CtaBanner.astro';
import BannerLayers from '../components/BannerLayers.astro';
import LogoCarouselSection from '../components/LogoCarouselSection.astro';
import ProgrammeCard from '../components/ProgrammeCard.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getBannerAsset } from '../lib/banner-assets';
import { getSiteData, getStaticPage } from '../lib/data.js';
import { getCorporateClientLogoItems } from '../lib/logos';
import { localiseFramerImage } from '../lib/media.js';
import {
	buildProgrammeCardOverrides,
	getProgrammesForSurface,
	toProgrammeCardData,
} from '../lib/programmes.ts';

const page = getStaticPage('/professionals');
if (!page) return Astro.redirect('/404');

const site = getSiteData();
const canonical = 'https://tinkercademy.com/professionals/';

const heroImage = localiseFramerImage(page.hero_image ?? '');
const heroBanner = getBannerAsset(heroImage);
const heroTitle = page.hero_title ?? 'Data, Coding, IoT Tinkering, and Tech Productivity Training';
const heroLead = page.hero_lead ?? 'Real skills for real impact.';

const valueProps = [
	{
		title: 'Customised Tech Upskilling',
		body: 'Your business goals are unique. So is our training. We design learning experiences (GenAI, vibe coding, tech training) precisely for your team and your objectives in Singapore. They get the skills to make a real impact.',
	},
	{
		title: 'Expert Instructors',
		body: "Your team will be guided by experts from the world's top universities and leading tech companies. They bring powerful insights to inspire innovation within your office.",
	},
	{
		title: 'Track Record',
		body: 'Singapore companies trust us. Consistently rated 5 stars. Client partnerships over 8 years strong. We ensure learning turns into action, helping your team meet your business objectives.',
	},
];

const corporateClientLogos = getCorporateClientLogoItems(site.externalLogos);

/* Show every business/public programme; imported cards only override legacy display copy. */
const cardOverrides = buildProgrammeCardOverrides(page.course_cards ?? []);
const cards = (await getProgrammesForSurface('professionals')).map((programme) =>
	toProgrammeCardData(programme, cardOverrides.get(programme.slug)),
);
---

<ContentLayout
	title="Courses for professionals — Tinkercademy"
	description="Expert-led technical training for working professionals in Singapore. Upskill in AI, web and mobile development, data, and digital making."
	canonical={canonical}
	image={heroImage}
	preloadHero={heroBanner ? { src: heroBanner.background } : null}
>
	<section class="aud-hero">
		{heroImage && (
			<BannerLayers src={heroImage} />
		)}
		<div class="aud-hero__scrim"></div>
		<div class="aud-hero__content shell">
			<h1 class="aud-hero__title">{heroTitle}</h1>
			<p class="aud-hero__lead">{heroLead}</p>
		</div>
	</section>

	<section class="aud-section aud-section--muted">
		<div class="shell">
			<h2 class="aud-section__heading">Our Value Proposition</h2>
			<div class="aud-value-grid">
				{valueProps.map((v) => (
					<article class="aud-value-card">
						<h3 class="aud-value-card__title">{v.title}</h3>
						<p class="aud-value-card__body">{v.body}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<LogoCarouselSection
		title="Our Corporate Clients"
		logos={corporateClientLogos}
		minItems={30}
		secondsPerLogo={4}
	/>

	<section class="aud-pivot">
		<div class="shell">
			<h2 class="aud-pivot__heading">Let's Work Together!</h2>
			<div class="aud-pivot__pills">
				<a class="aud-pivot__pill" href="/schools/">Schools</a>
				<a class="aud-pivot__pill" href="/individuals/">Individuals</a>
				<a class="aud-pivot__pill" href="/courses-professionals/">Browse Courses</a>
			</div>
		</div>
	</section>

	{cards.length > 0 && (
		<section class="aud-courses">
			<div class="shell">
				<h2 class="aud-courses__heading">Professional Courses</h2>
				<div class="aud-courses__grid">
					{cards.map((card: any) => (
						<ProgrammeCard
							slug={card.slug}
							title={card.title}
							heroImage={card.heroImage}
							audienceLabel={card.audienceLabel}
							audienceId={card.audienceId}
							audienceIds={card.audienceIds}
							domainIds={card.domainIds}
							platformIds={card.platformIds}
							duration={card.duration}
							shortDescription={card.shortDescription}
							searchText={card.searchText}
							badgeHref={card.badgeHref}
						/>
					))}
				</div>
			</div>
		</section>
	)}

	<CtaBanner />
</ContentLayout>

<style>
	.aud-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: 480px;
		overflow: clip;
		background: #161111;
	}

	.aud-hero__scrim {
		position: absolute;
		inset: 0;
		background: var(--hero-desktop-scrim);
	}

	@media (max-width: 809px) {
		.aud-hero {
			min-height: 420px;
		}

		.aud-hero__scrim {
			background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.72) 100%);
		}
	}

	.aud-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: inherit;
		padding: clamp(4rem, 8vw, 6rem) 0 clamp(2.5rem, 4vw, 3.5rem);
		gap: 0.75rem;
	}

	.aud-hero__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 1.05;
		color: #fff;
		margin: 0;
		max-width: min(22ch, var(--hero-title-max-width));
		text-wrap: balance;
		text-shadow: var(--hero-title-glow);
	}

	.aud-hero__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.92);
		margin: 0;
		max-width: 48ch;
	}

	.aud-section {
		padding: 3rem 0;
	}

	.aud-section--muted {
		background: #fafafa;
	}

	.aud-section__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0 0 1.5rem;
	}

	.aud-value-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.aud-value-card {
		background: #fff;
		border: 1px solid rgb(229, 229, 229);
		border-radius: 18px;
		padding: 1.5rem;
	}

	.aud-value-card__title {
		font-family: 'Rubik', sans-serif;
		font-size: 0.78rem;
		letter-spacing: 0.03em;
		color: var(--accent-dark);
		margin: 0 0 0.75rem;
	}

	.aud-value-card__body {
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin: 0;
	}

	@media (max-width: 899px) {
		.aud-value-grid {
			grid-template-columns: 1fr;
		}
	}

	.aud-pivot {
		padding: 3rem 0;
	}

	.aud-pivot__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.6rem;
		font-weight: 500;
		color: rgb(51, 51, 51);
		text-align: center;
		margin: 0 0 1.25rem;
	}

	.aud-pivot__pills {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
	}

	.aud-pivot__pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 40px;
		padding: 10px 20px;
		border-radius: 30px;
		background: var(--accent-dark);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
		color: #fff;
		font-family: 'Rubik', sans-serif;
		font-size: 0.85rem;
		text-decoration: none;
		transition: opacity 0.15s;
	}

	.aud-pivot__pill:hover {
		background: rgb(154, 44, 39);
	}

	.aud-courses {
		padding: 1rem 0 3rem;
	}

	.aud-courses__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.6rem;
		font-weight: 500;
		color: rgb(51, 51, 51);
		margin: 0 0 1.5rem;
	}

	.aud-courses__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
	}

	@media (max-width: 1199px) {
		.aud-courses__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 809px) {
		.aud-courses__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
