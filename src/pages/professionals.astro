---
import CourseGrid from '../components/CourseGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNavPillsForPage, getProgrammesForPage, getSiteData, getStaticPage } from '../lib/data.js';
import { HOME_PARTNER_LOGOS, HOME_INSTITUTION_LOGOS } from '../lib/site-media.js';

const site = getSiteData();
const page = getStaticPage('/professionals', site);
if (!page) return Astro.redirect('/404');

const canonical = new URL('/professionals', 'https://tinkercademy.com').toString();
const programmes = getProgrammesForPage(page);
const navPills = getNavPillsForPage(page);
const blocks = page.blocks ?? [];

const heroLinks = (page.ctas ?? []).filter((cta) => ['Schools', 'Individuals', 'Browse Courses'].includes(cta.label));
const dynamicLogos = (site.externalLogos ?? []).filter((logo) => logo.active && logo.logo);
const partnerLogos = dynamicLogos.filter((logo) => logo.partner || logo.type === 'Partner');
const clientLogos = dynamicLogos.filter((logo) => !(logo.partner || logo.type === 'Partner'));

const valueStart = blocks.findIndex((block) => block.text === 'Our Value Proposition');
const valueEnd = blocks.findIndex((block, index) => index > valueStart && block.text === 'Our Clients');
const valueBlocks = valueStart >= 0 ? blocks.slice(valueStart + 1, valueEnd === -1 ? blocks.length : valueEnd) : [];
const valueCards = [];
for (let index = 0; index < valueBlocks.length; index += 1) {
	const block = valueBlocks[index];
	const next = valueBlocks[index + 1];
	if (block.tag !== 'h3' || !next || next.tag !== 'p') continue;
	valueCards.push({ title: block.text.replace(/([a-z])([A-Z])/g, '$1 $2'), body: next.text });
	index += 1;
}
---

<BaseLayout
	title={page.seo?.title ?? page.title}
	description={page.seo?.description ?? page.description ?? ''}
	canonical={canonical}
	image={page.hero_image ?? undefined}
>
	<section class="audience-hero">
		<div class="shell audience-hero__inner">
			<div class="audience-hero__copy">
				<p class="audience-hero__eyebrow">For Professionals</p>
				<h1>{page.hero_title}</h1>
				<p class="audience-hero__lead">{page.hero_lead}</p>
				<div class="audience-hero__actions">
					{heroLinks.map((cta) => (
						<a href={cta.url}>{cta.label}</a>
					))}
				</div>
			</div>
			{page.hero_image && <img class="audience-hero__media" src={page.hero_image} alt="Professionals learning together" />}
		</div>
	</section>

	<section class="audience-section">
		<div class="shell">
			<h2>Our Partners</h2>
			<div class="logo-band">
				{partnerLogos.length > 0
					? partnerLogos.map((logo) => (
							<div class="logo-chip">
								<img src={logo.logo} alt={logo.label} loading="lazy" />
							</div>
						))
					: HOME_PARTNER_LOGOS.map((logo) => (
							<a href={logo.url} target="_blank" rel="noopener noreferrer">
								<img src={logo.src} alt={logo.label} loading="lazy" />
							</a>
						))}
			</div>
		</div>
	</section>

	<section class="audience-section audience-section--muted">
		<div class="shell">
			<h2>Our Value Proposition</h2>
			<div class="value-grid">
				{valueCards.map((card) => (
					<article class="value-card">
						<h3>{card.title}</h3>
						<p>{card.body}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="audience-section">
		<div class="shell">
			<h2>Our Clients</h2>
			<div class="logo-band logo-band--clients">
				{clientLogos.length > 0
					? clientLogos.map((logo) => (
							<div class="logo-chip">
								<img src={logo.logo} alt={logo.label} loading="lazy" />
							</div>
						))
					: HOME_INSTITUTION_LOGOS.map((logo) => (
							<div class="logo-chip">
								<img src={logo.src} alt={logo.label} loading="lazy" />
							</div>
						))}
			</div>
		</div>
	</section>

	<CourseGrid programmes={programmes} pageTitle="Professional Courses" navPills={navPills} />
	<CtaBanner />
</BaseLayout>

<style>
	.audience-hero,
	.audience-section {
		padding: 3rem 0;
	}

	.audience-hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
		gap: 2rem;
		align-items: center;
	}

	.audience-hero__eyebrow {
		margin: 0 0 0.75rem;
		font-family: 'Fragment Mono', monospace;
		font-size: 0.8rem;
		text-transform: uppercase;
		color: rgb(202, 67, 61);
	}

	.audience-hero h1,
	.audience-section h2,
	.value-card h3 {
		margin: 0 0 1rem;
		font-family: 'Oswald', sans-serif;
		text-transform: uppercase;
		line-height: 0.98;
	}

	.audience-hero h1 {
		font-size: clamp(2.2rem, 5vw, 4.4rem);
	}

	.audience-hero__lead,
	.value-card p {
		margin: 0;
		font-family: 'Rubik', sans-serif;
		line-height: 1.7;
		color: rgb(51, 51, 51);
	}

	.audience-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.25rem;
	}

	.audience-hero__actions a {
		padding: 0.75rem 1rem;
		border-radius: 999px;
		background: rgb(240, 93, 87);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
	}

	.audience-hero__media {
		width: 100%;
		border-radius: 28px;
		box-shadow: 0 20px 44px rgba(0, 0, 0, 0.08);
	}

	.audience-section--muted {
		background: linear-gradient(180deg, rgba(240, 93, 87, 0.06), transparent);
	}

	.logo-band,
	.value-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1rem;
		align-items: center;
	}

	.logo-band a,
	.logo-chip,
	.value-card {
		display: grid;
		place-items: center;
		padding: 1.25rem;
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 20px;
		background: #fff;
		box-shadow: 0 14px 32px rgba(0, 0, 0, 0.05);
	}

	.value-card {
		place-items: start;
	}

	.logo-band img,
	.logo-chip img {
		max-height: 58px;
		width: auto;
	}

	@media (max-width: 900px) {
		.audience-hero__inner {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
