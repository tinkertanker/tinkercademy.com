---
/**
 * /professionals — Astro-native rebuild of the live tinkercademy.com professionals page.
 *
 * Sections:
 *   1. Hero
 *   2. Our Partners (logo strip)
 *   3. Our Value Proposition (3-up cards)
 *   4. Our Clients (logo strip)
 *   5. Let's Work Together! (pivot pills)
 *   6. Professional Courses (programme cards)
 *   7. Closing CTA banner
 */
import CtaBanner from '../components/CtaBanner.astro';
import ProgrammeCard from '../components/ProgrammeCard.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getSiteData, getStaticPage } from '../lib/data.js';
import { localiseFramerImage } from '../lib/media.js';
import {
	buildProgrammeCardOverrides,
	getProgrammesBySlugs,
	toProgrammeCardData,
} from '../lib/programmes.ts';

const page = getStaticPage('/professionals');
if (!page) return Astro.redirect('/404');

const site = getSiteData();
const canonical = 'https://tinkercademy.com/professionals/';

const heroImage = localiseFramerImage(page.hero_image ?? '');
const heroTitle = page.hero_title ?? 'Data, Coding, IoT Tinkering, and Tech Productivity Training';
const heroLead = page.hero_lead ?? 'Real skills for real impact.';

const valueProps = [
	{
		title: 'Customised Tech Upskilling',
		body: 'Your business goals are unique. So is our training. We design learning experiences (GenAI, vibe coding, tech training) precisely for your team and your objectives in Singapore. They get the skills to make a real impact.',
	},
	{
		title: 'Expert Instructors',
		body: 'Your team will be guided by experts from Ivy-league universities and leading tech companies. They bring powerful insights to inspire innovation within your office.',
	},
	{
		title: 'Track Record',
		body: 'Singapore companies trust us. Consistently rated 5 stars. Client partnerships over 8 years strong. We ensure learning turns into action, helping your team meet your business objectives.',
	},
];

const partnerLogos = site.externalLogos
	.filter((l: any) => l.type === 'Partner' && l.logo)
	.map((l: any) => ({ label: l.label, src: l.logo }));

const corporateLogos = site.externalLogos
	.filter((l: any) => l.type === 'Corporate Client' && l.logo)
	.map((l: any) => ({ label: l.label, src: l.logo }));

const clientLogos = site.externalLogos
	.filter((l: any) => l.type !== 'Partner' && l.logo)
	.map((l: any) => ({ label: l.label, src: l.logo }));

const partnersStrip = partnerLogos.length > 0 ? partnerLogos : corporateLogos;
const partnersDoubled = [...partnersStrip, ...partnersStrip];
const clientsDoubled = [...clientLogos, ...clientLogos];

const cardOverrides = buildProgrammeCardOverrides(page.course_cards ?? []);
const cardSlugs = (page.course_cards ?? []).map((card: any) => card.slug);
const cards = (await getProgrammesBySlugs(cardSlugs)).map((programme) =>
	toProgrammeCardData(programme, cardOverrides.get(programme.slug)),
);
---

<ContentLayout
	title="Courses for professionals — Tinkercademy"
	description="Expert-led technical training for working professionals in Singapore. Upskill in AI, web and mobile development, data, and digital making."
	canonical={canonical}
	image={heroImage}
>
	<section class="aud-hero">
		{heroImage && (
			<img class="aud-hero__bg" src={heroImage} alt="" loading="eager" fetchpriority="high" />
		)}
		<div class="aud-hero__scrim"></div>
		<div class="aud-hero__content shell">
			<h1 class="aud-hero__title">{heroTitle}</h1>
			<p class="aud-hero__lead">{heroLead}</p>
		</div>
	</section>

	{partnersStrip.length > 0 && (
		<section class="aud-section">
			<div class="shell">
				<h2 class="aud-section__heading">Our Partners</h2>
				<div class="aud-logo-marquee">
					<div class="aud-logo-track aud-logo-track--partners">
						{partnersDoubled.map((logo, idx) => (
							<img
								class="aud-logo aud-logo--partner"
								src={logo.src}
								alt={idx < partnersStrip.length ? logo.label : ''}
								aria-hidden={idx >= partnersStrip.length ? 'true' : undefined}
							/>
						))}
					</div>
				</div>
			</div>
		</section>
	)}

	<section class="aud-section aud-section--muted">
		<div class="shell">
			<h2 class="aud-section__heading">Our Value Proposition</h2>
			<div class="aud-value-grid">
				{valueProps.map((v) => (
					<article class="aud-value-card">
						<h3 class="aud-value-card__title">{v.title}</h3>
						<p class="aud-value-card__body">{v.body}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	{clientLogos.length > 0 && (
		<section class="aud-section">
			<div class="shell">
				<h2 class="aud-section__heading">Our Clients</h2>
				<div class="aud-logo-marquee">
					<div class="aud-logo-track aud-logo-track--clients">
						{clientsDoubled.map((logo, idx) => (
							<img
								class="aud-logo"
								src={logo.src}
								alt={idx < clientLogos.length ? logo.label : ''}
								aria-hidden={idx >= clientLogos.length ? 'true' : undefined}
							/>
						))}
					</div>
				</div>
			</div>
		</section>
	)}

	<section class="aud-pivot">
		<div class="shell">
			<h2 class="aud-pivot__heading">Let's Work Together!</h2>
			<div class="aud-pivot__pills">
				<a class="aud-pivot__pill" href="/schools/">Schools</a>
				<a class="aud-pivot__pill" href="/individuals/">Individuals</a>
				<a class="aud-pivot__pill" href="/courses-professionals/">Browse Courses</a>
			</div>
		</div>
	</section>

	{cards.length > 0 && (
		<section class="aud-courses">
			<div class="shell">
				<h2 class="aud-courses__heading">Professional Courses</h2>
				<div class="aud-courses__grid">
					{cards.map((card: any) => (
						<ProgrammeCard
							slug={card.slug}
							title={card.title}
							heroImage={card.heroImage}
							audienceLabel={card.audienceLabel}
							audienceId={card.audienceId}
							audienceIds={card.audienceIds}
							domainIds={card.domainIds}
							platformIds={card.platformIds}
							duration={card.duration}
							shortDescription={card.shortDescription}
							searchText={card.searchText}
							badgeHref={card.badgeHref}
						/>
					))}
				</div>
			</div>
		</section>
	)}

	<CtaBanner />
</ContentLayout>

<style>
	.aud-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: clamp(380px, 52vh, 560px);
		overflow: clip;
		background: #0a0a0a;
	}

	.aud-hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.aud-hero__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.55) 100%);
	}

	.aud-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: inherit;
		padding: clamp(4rem, 8vw, 6rem) 0 clamp(2.5rem, 4vw, 3.5rem);
		gap: 0.75rem;
	}

	.aud-hero__title {
		font-family: 'Oswald', sans-serif;
		font-size: clamp(2rem, 4.5vw, 3.2rem);
		font-weight: 500;
		line-height: 1.05;
		text-transform: uppercase;
		color: #fff;
		margin: 0;
		max-width: 22ch;
		text-wrap: balance;
	}

	.aud-hero__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.92);
		margin: 0;
		max-width: 48ch;
	}

	.aud-section {
		padding: 3rem 0;
	}

	.aud-section--muted {
		background: #fafafa;
	}

	.aud-section__heading {
		font-family: 'Oswald', sans-serif;
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(23, 23, 23);
		margin: 0 0 1.5rem;
	}

	.aud-value-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.aud-value-card {
		background: #fff;
		border: 1px solid rgb(229, 229, 229);
		border-radius: 18px;
		padding: 1.5rem;
	}

	.aud-value-card__title {
		font-family: 'Fragment Mono', monospace;
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(240, 93, 87);
		margin: 0 0 0.75rem;
	}

	.aud-value-card__body {
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin: 0;
	}

	@media (max-width: 899px) {
		.aud-value-grid {
			grid-template-columns: 1fr;
		}
	}

	.aud-logo-marquee {
		width: 100%;
		overflow: hidden;
		mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
	}

	.aud-logo-track {
		display: flex;
		width: max-content;
		align-items: center;
		gap: clamp(1rem, 2.5vw, 2rem);
		will-change: transform;
	}

	.aud-logo-track--partners {
		animation: aud-logo-marquee 30s linear infinite;
	}

	.aud-logo-track--clients {
		animation: aud-logo-marquee 55s linear infinite;
	}

	.aud-logo {
		max-height: 74px;
		max-width: 140px;
		width: auto;
		height: auto;
		object-fit: contain;
		flex: 0 0 auto;
	}

	.aud-logo--partner {
		max-height: 60px;
	}

	@keyframes aud-logo-marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.aud-logo-track--partners,
		.aud-logo-track--clients {
			animation: none;
		}
	}

	.aud-pivot {
		padding: 3rem 0;
	}

	.aud-pivot__heading {
		font-family: 'Oswald', sans-serif;
		font-size: 1.6rem;
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(51, 51, 51);
		text-align: center;
		margin: 0 0 1.25rem;
	}

	.aud-pivot__pills {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
	}

	.aud-pivot__pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 40px;
		padding: 10px 20px;
		border-radius: 30px;
		background: rgb(240, 93, 87);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
		color: #fff;
		font-family: 'Rubik', sans-serif;
		font-size: 0.85rem;
		text-decoration: none;
		transition: opacity 0.15s;
	}

	.aud-pivot__pill:hover {
		opacity: 0.85;
	}

	.aud-courses {
		padding: 1rem 0 3rem;
	}

	.aud-courses__heading {
		font-family: 'Oswald', sans-serif;
		font-size: 1.6rem;
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(51, 51, 51);
		margin: 0 0 1.5rem;
	}

	.aud-courses__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
	}

	@media (max-width: 1199px) {
		.aud-courses__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 809px) {
		.aud-courses__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
