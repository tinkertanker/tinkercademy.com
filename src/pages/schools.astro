---
/**
 * /schools — Astro-native rebuild.
 *
 * Sections:
 *   1. Hero
 *   2. Programmes for Schools (intro)
 *   3. School delivery proof points
 *   4. Our School Clients (logo strip)
 *   5. Code for Fun (feature)
 *   6. Infocomm LEARN Roadmap (feature)
 *   7. Let's Work Together! pivot pills
 *   8. School Courses (programme cards)
 *   9. Closing CTA banner
 */
import CtaBanner from '../components/CtaBanner.astro';
import LogoCarouselSection from '../components/LogoCarouselSection.astro';
import ProgrammeCard from '../components/ProgrammeCard.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getSiteData, getStaticPage } from '../lib/data.js';
import { getSchoolClientLogoItems } from '../lib/logos';
import {
	buildProgrammeCardOverrides,
	getProgrammesBySlugs,
	toProgrammeCardData,
} from '../lib/programmes.ts';
import { HOME_FLAGSHIP_IMAGES } from '../lib/site-media.js';

const page = getStaticPage('/schools');
if (!page) return Astro.redirect('/404');

const site = getSiteData();
const canonical = 'https://tinkercademy.com/schools/';

const heroImage = '/images/banners/schools.webp';
const heroTitle = page.hero_title ?? 'Code, Tinker, and Make with Us.';
const heroLead = 'Hands-on coding, AI, and digital making programmes for MOE schools.';

const features = [
	{
		title: 'Code For Fun',
		body: 'As one of the earliest Code For Fun initiators under Code@SG, we help primary and secondary students learn computational thinking, microcontroller-based digital making, and AI through fully subsidised hands-on programmes for eligible schools.',
		url: 'https://codeforfun.sg/',
		image: HOME_FLAGSHIP_IMAGES['Code For Fun'],
	},
	{
		title: 'Infocomm LEARN Roadmap',
		body: 'Working with IMDA, industry partners, and training partners, we offer fully-funded Infocomm Club training for primary, secondary, and junior college students across app development, UI/UX, game development, AI, and digital making.',
		url: 'https://infocommclub.sg',
		image: HOME_FLAGSHIP_IMAGES['IMDA LEARN Roadmap'],
	},
];

const schoolClientLogos = getSchoolClientLogoItems(site.externalLogos);
const schoolProofPoints = [
	{
		value: '800+',
		label: 'teachers trained in micro:bit and digital making',
	},
	{
		value: '200+',
		label: 'schools reached through Digital Maker teacher training',
	},
	{
		value: '60,800',
		label: 'micro:bits placed in schools through the Digital Maker Programme',
	},
];

const cardOverrides = buildProgrammeCardOverrides(page.course_cards ?? []);
const cardSlugs = (page.course_cards ?? []).map((card: any) => card.slug);
const cards = (await getProgrammesBySlugs(cardSlugs)).map((programme) =>
	toProgrammeCardData(programme, cardOverrides.get(programme.slug)),
);
---

<ContentLayout
	title="Courses for schools — Tinkercademy"
	description="Coding, AI, and digital making programmes for MOE primary, secondary, and junior college schools — Code For Fun, the Infocomm LEARN Roadmap, and bespoke curricula."
	canonical={canonical}
	image={heroImage}
>
	<section class="aud-hero">
		{heroImage && (
			<img class="aud-hero__bg" src={heroImage} alt="" loading="eager" fetchpriority="high" />
		)}
		<div class="aud-hero__scrim"></div>
		<div class="aud-hero__content shell">
			<h1 class="aud-hero__title">{heroTitle}</h1>
			<p class="aud-hero__lead">{heroLead}</p>
		</div>
	</section>

	<section class="sch-intro">
		<div class="shell">
			<h2 class="sch-intro__heading">Programmes for Schools</h2>
			<p class="sch-intro__body">
				We offer a variety of courses for schools. As one of the first vendors for the
				<a href="https://codeforfun.sg/" target="_blank" rel="noopener">Code For Fun programme</a>,
				and an active training partner for the
				<a href="https://infocommclub.sg" target="_blank" rel="noopener">Infocomm LEARN Roadmap</a>,
				we have delivered hands-on lessons and multi-year tracks across primary,
				secondary, and junior college levels.
			</p>
		</div>
	</section>

	<section class="sch-proof">
		<div class="shell sch-proof__grid">
			{schoolProofPoints.map((point) => (
				<div class="sch-proof__item">
					<strong class="sch-proof__value">{point.value}</strong>
					<span class="sch-proof__label">{point.label}</span>
				</div>
			))}
		</div>
	</section>

	<LogoCarouselSection
		title="Our School Clients"
		logos={schoolClientLogos}
		muted={true}
		minItems={30}
		secondsPerLogo={4}
	/>

	<section class="sch-features">
		<div class="shell sch-features__grid">
			{features.map((feat) => (
				<article class="sch-feature">
					<a class="sch-feature__link" href={feat.url} target="_blank" rel="noopener">
						<img class="sch-feature__image" src={feat.image} alt={feat.title} loading="lazy" />
						<div class="sch-feature__body-wrap">
							<h3 class="sch-feature__title">
								{feat.title}
								<svg class="sch-feature__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M7 17L17 7M17 7H7M17 7V17"/>
								</svg>
							</h3>
							<p class="sch-feature__body">{feat.body}</p>
						</div>
					</a>
				</article>
			))}
		</div>
	</section>

	<section class="aud-pivot">
		<div class="shell">
			<h2 class="aud-pivot__heading">Let's Work Together!</h2>
			<div class="aud-pivot__pills">
				<a class="aud-pivot__pill" href="/professionals/">Professionals</a>
				<a class="aud-pivot__pill" href="/individuals/">Individuals</a>
				<a class="aud-pivot__pill" href="/courses-schools/">Browse Courses</a>
			</div>
		</div>
	</section>

	{cards.length > 0 && (
		<section class="aud-courses">
			<div class="shell">
				<h2 class="aud-courses__heading">School Courses</h2>
				<div class="aud-courses__grid">
					{cards.map((card: any) => (
						<ProgrammeCard
							slug={card.slug}
							title={card.title}
							heroImage={card.heroImage}
							audienceLabel={card.audienceLabel}
							audienceId={card.audienceId}
							audienceIds={card.audienceIds}
							domainIds={card.domainIds}
							platformIds={card.platformIds}
							duration={card.duration}
							shortDescription={card.shortDescription}
							searchText={card.searchText}
							badgeHref={card.badgeHref}
						/>
					))}
				</div>
			</div>
		</section>
	)}

	<CtaBanner />
</ContentLayout>

<style>
	.aud-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: clamp(380px, 52vh, 560px);
		overflow: clip;
		background: #0a0a0a;
	}

	.aud-hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.aud-hero__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.55) 100%);
	}

	.aud-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: inherit;
		padding: clamp(4rem, 8vw, 6rem) 0 clamp(2.5rem, 4vw, 3.5rem);
		gap: 0.75rem;
	}

	.aud-hero__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 1.05;
		color: #fff;
		margin: 0;
		max-width: 22ch;
	}

	.aud-hero__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.92);
		margin: 0;
		max-width: 48ch;
	}

	.sch-intro {
		padding: 3rem 0 1rem;
	}

	.sch-intro__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0 0 0.75rem;
	}

	.sch-intro__body {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin: 0;
		max-width: 60rem;
	}

	.sch-intro__body a {
		color: var(--accent-dark);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	.sch-proof {
		padding: 1rem 0 2rem;
	}

	.sch-proof__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.sch-proof__item {
		border-left: 3px solid rgb(240, 93, 87);
		padding: 0.15rem 1rem;
	}

	.sch-proof__value {
		display: block;
		font-family: 'IBM Plex Serif', Georgia, serif;
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 500;
		line-height: 1;
		color: rgb(23, 23, 23);
	}

	.sch-proof__label {
		display: block;
		margin-top: 0.45rem;
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		line-height: var(--body-line-height);
		color: rgb(71, 71, 71);
	}

	.sch-features {
		padding: 2rem 0 3rem;
	}

	.sch-features__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.sch-feature {
		background: #fafafa;
		border: 1px solid rgb(229, 229, 229);
		border-radius: 8px;
		overflow: hidden;
		transition:
			transform 0.16s ease,
			box-shadow 0.16s ease;
	}

	.sch-feature:has(.sch-feature__link:hover) {
		transform: translateY(-2px);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
	}

	.sch-feature__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.sch-feature__link,
	.sch-feature__link:hover,
	.sch-feature__link:focus,
	.sch-feature__link * {
		text-decoration: none;
	}

	.sch-feature__image {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		background: #fff;
		display: block;
	}

	.sch-feature__body-wrap {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1.5rem;
	}

	.sch-feature__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.35rem;
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.sch-feature__arrow {
		flex: 0 0 auto;
		color: rgb(240, 93, 87);
	}

	.sch-feature__body {
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin: 0;
		flex: 1;
	}

	@media (max-width: 809px) {
		.sch-proof__grid {
			grid-template-columns: 1fr;
		}

		.sch-features__grid {
			grid-template-columns: 1fr;
		}
	}

	.aud-pivot {
		padding: 3rem 0;
	}

	.aud-pivot__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.6rem;
		font-weight: 500;
		color: rgb(51, 51, 51);
		text-align: center;
		margin: 0 0 1.25rem;
	}

	.aud-pivot__pills {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
	}

	.aud-pivot__pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 40px;
		padding: 10px 20px;
		border-radius: 30px;
		background: var(--accent-dark);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
		color: #fff;
		font-family: 'Rubik', sans-serif;
		font-size: 0.85rem;
		text-decoration: none;
	}

	.aud-pivot__pill:hover {
		background: rgb(154, 44, 39);
	}

	.aud-courses {
		padding: 1rem 0 3rem;
	}

	.aud-courses__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.6rem;
		font-weight: 500;
		color: rgb(51, 51, 51);
		margin: 0 0 1.5rem;
	}

	.aud-courses__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
	}

	@media (max-width: 1199px) {
		.aud-courses__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 809px) {
		.aud-courses__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
