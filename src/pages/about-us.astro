---
/**
 * /about-us — layout and copy aligned with live tinkercademy.com (Framer).
 */
import CtaBanner from '../components/CtaBanner.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getStaticPage } from '../lib/data.js';
import { localiseFramerImage } from '../lib/media.js';
import { parse as parseYaml } from 'yaml';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const page = getStaticPage('/about-us');
if (!page) return Astro.redirect('/404');

const canonical = new URL('/about-us/', 'https://tinkercademy.com').toString();

type Block = { tag?: string; text?: string };
const blocks: Block[] = (page.blocks ?? []) as Block[];
const blockText = (pred: (b: Block) => boolean) => blocks.find(pred)?.text ?? '';

const heroTitle =
	page.hero_title ??
	blockText((b) => Boolean(b.tag === 'h1' && b.text?.includes('coders and tinkerers'))) ??
	'';
const heroSubtitle =
	blockText((b) => Boolean(b.tag === 'h4')) ||
	'We bring an unparalleled depth of experience in education and technology to our classes and curriculum.';
const introBody =
	blockText((b) => Boolean(b.tag === 'p' && b.text?.includes('Tinkertanker Pte Ltd'))) || '';
const partnersBlurb =
	blockText((b) => Boolean(b.tag === 'p' && b.text?.includes('industry leaders'))) ||
	'We collaborate with industry leaders and educational institutions to drive innovation in learning. Our partners make it possible for us to create impactful solutions that empower educators and students alike.';
const clientsBlurb =
	blockText((b) => Boolean(b.tag === 'p' && b.text?.includes('had the privilege'))) ||
	'We’ve had the privilege of teaching, and working with, many preschools, primary schools, secondary schools, IP schools, junior colleges, tertiary institutions, and companies. Here’s a random sample of our clients:';
const teamIntro =
	blockText((b) => Boolean(b.tag === 'p' && b.text?.startsWith('Tinkercademy comprises'))) ||
	'Tinkercademy comprises a team of dedicated education specialists from top universities worldwide. With our extensive training in technology, design, and educational pedagogy, combined with years of experience creating real-world apps and electronics, we bring an unparalleled breadth and depth of technology education to our classes and curriculum.';

const heroBgSrc = localiseFramerImage(page.hero_image);

/* ── Load team data from YAML ── */
interface TeamMember {
	name: string;
	role: string;
	bio: string;
	photo: string;
	linkedin?: string;
}
const teamYaml = readFileSync(
	resolve(process.cwd(), 'src/data/team.yaml'),
	'utf-8'
);
const team: TeamMember[] = parseYaml(teamYaml);

/* ── Certification logos (row 1: cert badges; row 2: Apple programme) ── */
const certLogosRow1 = [
	'/images/ccAm2I4TKCuYyi1NVJdIrvzAw.png',
	'/images/WswqYSt0BjIpB4AvjMlsljQ0JM.png',
	'/images/gNg7rhp5eIX1new2SYkG6XIwg9Q.png',
];
const certLogosRow2 = [
	'/images/apple-logo-certified-trainer.png',
	'/images/apple-logo-professional-learning-specialist.png',
	'/images/apple-logo-consultants-network.svg',
];

/* ── Partner marks (circular row on live) ── */
const partnerLogos = [
	'/images/ccAm2I4TKCuYyi1NVJdIrvzAw.png',
	'/images/Rl2dNu7CjKUj50GoHP4FX8cpA.png',
	'/images/icLJqUI2otyj00sfJ4Dvlfxbo.webp',
	'/images/partners/apple-consultants-network.png',
	'/images/Sq1AjGYrdMNfVm23qQ2XUHv90Cg.png',
];
const partnerLogosMarquee = [...partnerLogos, ...partnerLogos];

/* ── Client logo strip images ── */
const clientLogos = [
	'/images/xHwcdydT3oqZNLuEPhUYed1o.gif',
	'/images/vwIzyDKnGvimoriXB6IVZqsE6U.jpg',
	'/images/khARVmoBLCZ3wl54aq5QXzPdq8.jpg',
	'/images/HEWUMM0ts0EHYszokOs3GXdUE.png',
	'/images/ZYZcVNiPEg6tMjHGhU520Ord5uI.webp',
	'/images/BDt3R80YV6FiInYlrnHOw8DQ.svg',
	'/images/W5TrPI4TQ7ldyHjx1tFRClDkVI.png',
	'/images/EeQgsZhGeo5B8SsOriPf6iEbpU.webp',
];
const clientLogosMarquee = [...clientLogos, ...clientLogos];

const stats = [
	{ number: '50+', description: 'Primary and Secondary Schools We\'ve Taught at for IMDA Infocomm Club' },
	{ number: '160+', description: 'Preschools We\'ve Developed Curriculum for in the Playmaker Programme' },
	{ number: '3000+', description: 'Students We\'ve Reached Through the Code@SG Movement' },
];

const tinkertankerIntroSrc = '/images/hbuTZqmS4AOlBdh6Ydrkt9tN4o.png';

const INTRO_FALLBACK_PLAIN =
	'Tinkertanker Pte Ltd is a technology and education company of tinkerers and teachers. We run Tinkercademy, where we teach coding and digital making to students of all ages, in a wide variety of fields such as micro:bit, iOS, Python, Arduino, Node, cyber-security, Unity, and more. We also curate and sell educational technology toys at our Get Hacking online store, and build our own tech apps and products, e.g. GuestDay, an iPad-based guest registration service; an IC Photo app for Singaporeans to take useful selfies; and Spickify, now Helpling Singapore.';

function buildIntroHtml(raw: string): string {
	const base = raw || INTRO_FALLBACK_PLAIN;
	return base
		.replace(
			/^Tinkertanker Pte Ltd/,
			'<a href="http://tinkertanker.com/" target="_blank" rel="noopener">Tinkertanker Pte Ltd</a>'
		)
		.replace(
			/Get Hacking/g,
			'<a href="http://gethacking.com/" target="_blank" rel="noopener">Get Hacking</a>'
		)
		.replace(
			/GuestDay/g,
			'<a href="http://guestday.com/" target="_blank" rel="noopener">GuestDay</a>'
		)
		.replace(
			/IC Photo/g,
			'<a href="https://apps.apple.com/sg/app/ic-photo-singapore/id483078253" target="_blank" rel="noopener">IC Photo</a>'
		)
		.replace(
			/Helpling Singapore/g,
			'<a href="http://helpling.com.sg/" target="_blank" rel="noopener">Helpling Singapore</a>'
		);
}

const heroTitleHtml = heroTitle
	.replace(
		/\b(coders|builders|tinkerers|teachers)\b/gi,
		(_wordMatch: string, word: string) => `<span class="about-hero__accent">${word}</span>`,
	)
	.replace(/\n/g, '<br />');
---

<>
<ContentLayout
	title="About us — Tinkercademy"
	description="Tinkercademy is a team of coders and tinkerers teaching coding, making, and digital technology to schools, companies, and the public in Singapore."
	canonical={canonical}
	image={page.hero_image ?? undefined}
>
	{/* ═══════ 1. Hero (full-bleed image + centred type) ═════════════════ */}
	<section class="about-hero">
		<img class="about-hero__bg" src={heroBgSrc} alt="" loading="eager" fetchpriority="high" />
		<div class="about-hero__scrim"></div>
		<div class="about-hero__content shell">
			<h1 class="about-hero__title" set:html={heroTitleHtml} />
			<p class="about-hero__subtitle">{heroSubtitle}</p>
		</div>
	</section>

	{/* ═══════ 2. Intro ═════════════════════════════════════════════════ */}
	<section class="about-intro">
		<div class="shell about-intro__inner">
			<img
				class="about-intro__logo"
				src={tinkertankerIntroSrc}
				alt="Tinkertanker"
				loading="eager"
			/>
			<div class="about-intro__text">
				<p set:html={buildIntroHtml(introBody)} />
			</div>
		</div>
	</section>

	{/* ═══════ 3. Certifications ════════════════════════════════════════ */}
	<section class="about-certs">
		<div class="shell">
			<h2 class="about-certs__heading">We are certified</h2>
			<div class="about-certs__row">
				{[...certLogosRow1, ...certLogosRow2].map((src) => (
					<img class="about-certs__logo" src={src} alt="" loading="lazy" />
				))}
			</div>
		</div>
	</section>

	{/* ═══════ 4. Partners ══════════════════════════════════════════════ */}
	<section class="about-section">
		<div class="shell">
			<h2 class="about-section__heading">Partners</h2>
			<p class="about-section__body">{partnersBlurb}</p>
			<div class="about-logo-marquee about-logo-marquee--partners">
				<div class="about-logo-track about-logo-track--partners">
					{partnerLogosMarquee.map((src, idx) => (
						<div class="about-partners__disc">
							<img class="about-partners__logo" src={src} alt={idx < partnerLogos.length ? 'Partner logo' : ''} aria-hidden={idx >= partnerLogos.length ? 'true' : undefined} />
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	{/* ═══════ 5. Our Clients ═══════════════════════════════════════════ */}
	<section class="about-section">
		<div class="shell">
			<h2 class="about-section__heading">Our Clients</h2>
			<p class="about-section__body">{clientsBlurb}</p>
			<div class="about-logo-marquee about-logo-marquee--clients">
				<div class="about-logo-track about-logo-track--clients">
					{clientLogosMarquee.map((src, idx) => (
						<img class="about-clients__logo" src={src} alt={idx < clientLogos.length ? 'Client logo' : ''} aria-hidden={idx >= clientLogos.length ? 'true' : undefined} />
					))}
				</div>
			</div>
		</div>
	</section>

	{/* ═══════ 6. Stats (dark gradient) ═════════════════════════════════ */}
	<section class="about-stats">
		<div class="shell about-stats__grid">
			{stats.map((stat) => (
				<div class="about-stat">
					<span class="about-stat__number">{stat.number}</span>
					<p class="about-stat__label">{stat.description}</p>
				</div>
			))}
		</div>
	</section>

	{/* ═══════ 7. Our Team ══════════════════════════════════════════════ */}
	<section class="about-team">
		<div class="shell">
			<h2 class="about-section__heading">Our Team</h2>
			<p class="about-section__body">{teamIntro}</p>

			<div class="about-team__grid">
				{team.map((member) => (
					<div class="team-card">
						<img
							class="team-card__photo"
							src={member.photo}
							alt={member.name}
							loading="lazy"
						/>
						<div class="team-card__body">
							<h3 class="team-card__name">
								{member.linkedin ? (
									<a href={member.linkedin} target="_blank" rel="noopener">{member.name}</a>
								) : (
									member.name
								)}
							</h3>
							<p class="team-card__role">{member.role}</p>
							<p class="team-card__bio">{member.bio}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<CtaBanner />
</ContentLayout>

<style>
	/* ─── Hero (full-bleed, matches site hero pattern) ─────────────────── */
	.about-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: 480px;
		overflow: clip;
		background: #161111;
	}

	.about-hero__bg {
		position: absolute;
		inset: var(--hero-scene-inset);
		width: auto;
		height: var(--hero-scene-height);
		max-width: none;
		object-fit: contain;
		object-position: right top;
	}

	@media (min-width: 810px) and (max-width: 1199px) {
		.about-hero__bg {
			inset: 0;
			width: 100%;
			height: 100%;
			max-width: 100%;
			object-fit: cover;
			object-position: center 40%;
		}
	}

	.about-hero__scrim {
		position: absolute;
		inset: 0;
		background: var(--hero-desktop-scrim);
	}

	@media (max-width: 809px) {
		.about-hero {
			min-height: 420px;
			--hero-scene-height: 60%;
			--hero-scene-inset: -19% 50% auto auto;
		}

		.about-hero__scrim {
			background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.72) 100%);
		}
	}

	.about-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: inherit;
		padding: clamp(4rem, 9vw, 6.75rem) 0 clamp(3rem, 5vw, 4rem);
		gap: 1.1rem;
	}

	.about-hero__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 1;
		color: #fff;
		margin: 0;
		max-width: var(--hero-title-max-width);
		text-wrap: balance;
		text-shadow: var(--hero-title-glow);
	}

	.about-hero__accent {
		color: rgb(240, 93, 87);
	}

	.about-hero__subtitle {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.92);
		margin: 0;
		max-width: 48ch;
	}

	/* ─── Intro ────────────────────────────────────────────── */
	.about-intro {
		padding: 3rem 0;
	}

	.about-intro__inner {
		display: flex;
		align-items: flex-start;
		gap: 2.5rem;
	}

	.about-intro__logo {
		width: 112px;
		height: 112px;
		flex-shrink: 0;
		border-radius: 50%;
		object-fit: cover;
	}

	.about-intro__text {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height-tight);
		color: rgb(51, 51, 51);
	}

	.about-intro__text p {
		margin: 0;
	}

	.about-intro__text a {
		color: rgb(240, 93, 87);
		text-decoration: none;
	}

	.about-intro__text a:hover {
		text-decoration: underline;
	}

	@media (max-width: 809px) {
		.about-intro__inner {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 1.5rem;
		}

		.about-intro__logo {
			width: 96px;
			height: 96px;
		}
	}

	/* ─── Certifications (dark) ─────────────────────────────── */
	.about-certs {
		padding: 3rem 0;
		background: linear-gradient(180deg, rgb(84, 84, 84) 0%, rgb(24, 24, 26) 100%);
	}

	.about-certs__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.5rem;
		font-weight: 500;
		color: #fff;
		margin: 0 0 2rem;
		text-align: center;
	}

	.about-certs__row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: clamp(1rem, 2.5vw, 2rem);
	}

	.about-certs__logo {
		width: clamp(88px, 10vw, 132px);
		height: clamp(56px, 6vw, 84px);
		object-fit: contain;
	}

	@media (max-width: 809px) {
		.about-certs__logo {
			width: 96px;
			height: 56px;
		}
	}

	/* ─── Generic section ──────────────────────────────────── */
	.about-section {
		padding: 3rem 0;
	}

	.about-section__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.5rem;
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0 0 0.75rem;
		text-align: center;
	}

	.about-section__body {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height-tight);
		color: rgb(51, 51, 51);
		margin: 0 auto 1.5rem;
		max-width: 800px;
		text-align: center;
	}

	/* ─── Partner logos (discs) ────────────────────────────── */
	.about-logo-marquee {
		width: 100%;
		overflow: hidden;
		mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
	}

	.about-logo-track {
		display: flex;
		width: max-content;
		align-items: center;
		will-change: transform;
	}

	.about-logo-track--partners {
		gap: clamp(1.25rem, 3vw, 2.25rem);
		animation: about-logo-marquee 26s linear infinite;
	}

	.about-logo-track--clients {
		gap: 1.5rem;
		animation: about-logo-marquee 40s linear infinite;
	}

	.about-partners__disc {
		width: 112px;
		height: 112px;
		border-radius: 50%;
		background: rgb(245, 245, 245);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.about-partners__logo {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		opacity: 1;
		filter: none;
	}

	/* ─── Client logos ─────────────────────────────────────── */
	.about-clients__logo {
		max-width: 100%;
		height: auto;
		max-height: 74px;
		width: auto;
		object-fit: contain;
		flex: 0 0 auto;
	}

	/* ─── Stats (dark gradient) ────────────────────────────── */
	.about-stats {
		padding: 4rem 0;
		background: linear-gradient(180deg, rgb(84, 84, 84) 0%, rgb(0, 0, 0) 100%);
	}

	.about-stats__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		text-align: center;
	}

	.about-stat__number {
		display: block;
		font-family: 'IBM Plex Serif', Georgia, serif;
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 600;
		color: rgb(240, 93, 87);
		line-height: 1;
		margin-bottom: 0.75rem;
	}

	.about-stat__label {
		font-family: 'Rubik', sans-serif;
		font-size: 14px;
		line-height: var(--body-line-height);
		color: rgba(255, 255, 255, 0.75);
		margin: 0;
	}

	@media (max-width: 809px) {
		.about-stats__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	/* ─── Team ─────────────────────────────────────────────── */
	.about-team {
		padding: 3rem 0;
	}

	.about-team__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 2rem;
	}

	.team-card {
		background: #fafafa;
		border: 1px solid #e3e3e3;
		border-radius: 10px;
		overflow: hidden;
		text-align: center;
	}

	.team-card__photo {
		width: 100%;
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: center 22%;
		display: block;
	}

	.team-card__body {
		padding: 0.9rem 0.8rem 1rem;
	}

	.team-card__name {
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		font-weight: 600;
		color: rgb(23, 23, 23);
		margin: 0 0 0.25rem;
	}

	.team-card__name a {
		color: inherit;
		text-decoration: none;
	}

	.team-card__name a:hover {
		color: rgb(240, 93, 87);
	}

	.team-card__role {
		font-family: 'Rubik', sans-serif;
		font-size: 0.68rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.035em;
		color: var(--accent-dark);
		margin: 0 0 0.75rem;
	}

	.team-card__bio {
		font-family: 'Rubik', sans-serif;
		font-size: 12px;
		line-height: var(--body-line-height);
		color: rgb(110, 110, 110);
		margin: 0;
	}

	@media (max-width: 900px) {
		.about-team__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.about-team__grid {
			grid-template-columns: 1fr;
		}
	}

	@keyframes about-logo-marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-logo-track--partners,
		.about-logo-track--clients {
			animation: none;
		}
	}
</style>
</>
