---
import { readdirSync, statSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import ContentLayout from '../../layouts/ContentLayout.astro';
import reviewItems from '../../data/hero-image-review.json';
import decisionList from '../../data/hero-image-decisions.json';

type ReviewItem = {
	id: string;
	targetType: string;
	title: string;
	route: string;
	currentImage: string;
	candidateImage?: string;
	candidateStatus?: string;
	candidateNotes?: string;
	priority: 'replace' | 'review' | 'keep';
	family: string;
	issue: string;
	concept: string;
	prompt: string;
};

type DecisionEntry = {
	id: string;
	image?: string;
	keep?: boolean;
	alternates?: string[];
};

type ResolvedDecision = {
	kind: 'pick' | 'keep';
	image: string | null;
	alternates: string[];
};

type CandidateSource = 'cdx' | 'cdx-icon' | 'v3' | 'seed' | 'sticker' | 'other';
type Candidate = {
	publicPath: string;
	label: string;
	source: CandidateSource;
};

const heroReviewDir = join(process.cwd(), 'public', 'images', 'generated', 'hero-review');
const seedDir = join(heroReviewDir, 'seed');
const stickerDir = join(heroReviewDir, 'stickers');

function safeReadDir(dir: string): string[] {
	try {
		return readdirSync(dir);
	} catch {
		return [];
	}
}

const sortOrder: Record<CandidateSource, number> = {
	cdx: 0,
	'cdx-icon': 1,
	v3: 2,
	seed: 3,
	sticker: 4,
	other: 5,
};

const stickerAliases: Record<string, string[]> = {
	home: ['sticker-home_'],
	'about-us': ['sticker-about-us_'],
	schools: ['sticker-schools_'],
	individuals: ['sticker-individuals_'],
	professionals: ['sticker-professionals_'],
	'infocomm-club': ['sticker-infocomm-club_'],
};

function listCandidates(item: ReviewItem): Candidate[] {
	const candidates: Candidate[] = [];

	// Per-id directory: usually contains v2_*.jpg, v3_*.jpg
	const itemDir = join(heroReviewDir, item.id);
	const itemFiles = safeReadDir(itemDir);
	for (const f of itemFiles) {
		const full = join(itemDir, f);
		try {
			if (!statSync(full).isFile()) continue;
		} catch {
			continue;
		}
		if (!/\.(jpe?g|png|webp)$/i.test(f)) continue;
		let source: CandidateSource = 'other';
		let label = f;
		if (f.match(/^cdx-icon[_-]/i)) {
			source = 'cdx-icon';
			label = `cdx-icon ${f.replace(/^cdx-icon[_-]?/i, '').replace(/\.[a-z]+$/i, '')}`;
		} else if (f.match(/^cdx[_-]/i)) {
			source = 'cdx';
			label = `cdx ${f.replace(/^cdx[_-]?/i, '').replace(/\.[a-z]+$/i, '')}`;
		} else if (f.match(/^v3[_-]/i)) {
			source = 'v3';
			label = `v3 ${f.replace(/^v3[_-]?/i, '').replace(/\.[a-z]+$/i, '')}`;
		} else {
			// Skip unknown / legacy prefixes (r2, v2, icon were retired)
			continue;
		}
		candidates.push({
			publicPath: `/images/generated/hero-review/${item.id}/${f}`,
			label,
			source,
		});
	}

	// Seed dir
	const seedPrefixes = [`${item.id}-v1_`, `${item.id}-v2_`, `${item.id}_`];
	for (const f of safeReadDir(seedDir)) {
		if (!/\.(jpe?g|png|webp)$/i.test(f)) continue;
		const matchesPrefix = seedPrefixes.some((p) => f.startsWith(p));
		const seedShortAliases: Record<string, string[]> = {
			'imda-learn-flagship': ['imda-learn-v1_', 'imda-learn-v2_'],
			'ri-futurecreate-maker-programme-2025': ['ri-futurecreate-v1_', 'ri-futurecreate-v2_'],
		};
		const aliasMatch = (seedShortAliases[item.id] ?? []).some((p) => f.startsWith(p));
		if (!matchesPrefix && !aliasMatch) continue;
		candidates.push({
			publicPath: `/images/generated/hero-review/seed/${f}`,
			label: `seed ${f.replace(/\.[a-z]+$/i, '')}`,
			source: 'seed',
		});
	}

	// Stickers (only for placements that have them)
	const stickerPrefixes = stickerAliases[item.id] ?? [];
	if (stickerPrefixes.length > 0) {
		for (const f of safeReadDir(stickerDir)) {
			if (!/\.(jpe?g|png|webp)$/i.test(f)) continue;
			if (!stickerPrefixes.some((p) => f.startsWith(p))) continue;
			candidates.push({
				publicPath: `/images/generated/hero-review/stickers/${f}`,
				label: `sticker ${f.replace(/^sticker-[^_]+_/, '').replace(/\.[a-z]+$/i, '')}`,
				source: 'sticker',
			});
		}
	}

	candidates.sort((a, b) => {
		const oa = sortOrder[a.source];
		const ob = sortOrder[b.source];
		if (oa !== ob) return oa - ob;
		return a.publicPath.localeCompare(b.publicPath);
	});

	return candidates;
}

function listOrphanStickers(): Candidate[] {
	const knownPrefixes = new Set(Object.values(stickerAliases).flat());
	const orphans: Candidate[] = [];
	for (const f of safeReadDir(stickerDir)) {
		if (!/\.(jpe?g|png|webp)$/i.test(f)) continue;
		if ([...knownPrefixes].some((p) => f.startsWith(p))) continue;
		orphans.push({
			publicPath: `/images/generated/hero-review/stickers/${f}`,
			label: f.replace(/\.[a-z]+$/i, ''),
			source: 'sticker',
		});
	}
	orphans.sort((a, b) => a.publicPath.localeCompare(b.publicPath));
	return orphans;
}

const productionOrigin = 'https://tinkercademy.com';
const routePath = (route: string) => (route === '/' ? '/' : `${route.replace(/\/$/, '')}/`);

const screenshotsDir = join(process.cwd(), 'public', 'images', 'generated', 'hero-page-screenshots');
const decisionsById = new Map<string, ResolvedDecision>(
	(decisionList as DecisionEntry[]).map((entry) => [
		entry.id,
		{
			kind: entry.keep ? 'keep' : 'pick',
			image: entry.image ?? null,
			alternates: entry.alternates ?? [],
		},
	]),
);

const items = (reviewItems as ReviewItem[]).map((item) => {
	const decision = decisionsById.get(item.id) ?? null;
	const screenshotFile = `${item.id}.webp`;
	const screenshot = existsSync(join(screenshotsDir, screenshotFile))
		? `/images/generated/hero-page-screenshots/${screenshotFile}`
		: null;
	return {
		...item,
		localPath: routePath(item.route),
		productionUrl: new URL(routePath(item.route), productionOrigin).toString(),
		candidates: listCandidates(item),
		decision,
		screenshot,
	};
});

const totalCandidates = items.reduce((sum, item) => sum + item.candidates.length, 0);
const itemsWithCandidates = items.filter((i) => i.candidates.length > 0).length;
const families = [...new Set(items.map((i) => i.family))].sort();
const targetTypes = [...new Set(items.map((i) => i.targetType))].sort();
const priorities = ['replace', 'review'];
const orphanStickers = listOrphanStickers();

const totalDecisions = items.filter((i) => i.decision).length;
const totalKept = items.filter((i) => i.decision?.kind === 'keep').length;
const totalNew = items.filter((i) => i.decision?.kind === 'pick' && i.decision?.image).length;
const totalScreenshots = items.filter((i) => i.screenshot).length;
---

<ContentLayout
	title="Hero Image Proposals — Tinkercademy"
	description="Side-by-side picker for proposed hero image refresh candidates."
	canonical="https://tinkercademy.com/review/hero-proposals/"
	image="/images/generated/schools-code-for-fun-hero-elecfreaks-board.jpg"
>
	<section class="proposal-hero">
		<div class="proposal-shell proposal-hero__inner">
			<p class="proposal-hero__eyebrow">Internal hero refresh</p>
			<h1 class="proposal-hero__title">Hero Image Proposals</h1>
			<p class="proposal-hero__lead">
				{totalDecisions} decisions applied across {items.length} placements: <strong>{totalNew} new heroes</strong> swapped in, <strong>{totalKept} kept current</strong>. Page screenshots ({totalScreenshots}/{items.length}) show how each major page looks with the picked image live. Picks live in <code>src/data/hero-image-decisions.json</code>; rerun <code>scripts/apply-hero-picks.py</code> to push edits to the live site data.
			</p>
			<div class="proposal-hero__actions">
				<a href="#applied">Jump to applied picks</a>
				<a href="#board">Picker board</a>
				<a href="/review/hero-images/">Original prompt board</a>
				<a href="https://tinkercademy.com" target="_blank" rel="noreferrer">Production site</a>
			</div>
		</div>
	</section>

	<section id="applied" class="proposal-applied">
		<div class="proposal-shell">
			<header class="proposal-applied__head">
				<h2>Applied picks — page previews</h2>
				<p>One card per placement. The screenshot reflects the live dev server with the new hero in place. Run <code>scripts/screenshot-pages.sh</code> after any pick change to refresh thumbnails.</p>
			</header>
			<div class="proposal-applied__grid">
				{items.map((item) => {
					const decision = item.decision;
					const isPick = decision?.kind === 'pick' && decision.image;
					const isKeep = decision?.kind === 'keep';
					const isUndecided = !decision;
					const heroForLabel = isPick ? decision!.image! : item.currentImage;
					const badgeLabel = isPick ? 'New hero' : isKeep ? 'Kept current' : 'No decision';
					const badgeClass = isPick
						? 'applied-card__badge--pick'
						: isKeep
							? 'applied-card__badge--keep'
							: 'applied-card__badge--none';
					return (
						<article
							class:list={[
								'applied-card',
								isPick && 'applied-card--pick',
								isKeep && 'applied-card--keep',
								isUndecided && 'applied-card--none',
							]}
							data-id={item.id}
						>
							<header class="applied-card__head">
								<div>
									<p class="applied-card__meta">{item.targetType.replace('-', ' ')} · {item.family}</p>
									<h3>{item.title}</h3>
									<p class="applied-card__route"><a href={item.localPath} target="_blank" rel="noreferrer">{item.localPath}</a></p>
								</div>
								<span class:list={['applied-card__badge', badgeClass]}>{badgeLabel}</span>
							</header>
							<div class="applied-card__shot">
								{item.screenshot ? (
									<a href={item.localPath} target="_blank" rel="noreferrer" title="Open page in new tab">
										<img src={item.screenshot} alt={`${item.title} page screenshot`} loading="lazy" />
									</a>
								) : (
									<div class="applied-card__missing">No screenshot yet — run scripts/screenshot-pages.sh</div>
								)}
							</div>
							<div class="applied-card__hero">
								<figure>
									<div class="applied-card__hero-frame">
										<img src={heroForLabel} alt={`${isPick ? 'Picked' : 'Current'} hero for ${item.title}`} loading="lazy" />
									</div>
									<figcaption>
										<span>{isPick ? 'Picked hero' : isKeep ? 'Current hero (kept)' : 'Current hero (no decision)'}</span>
										<a href={heroForLabel} target="_blank" rel="noreferrer">Open</a>
									</figcaption>
								</figure>
							</div>
							{decision?.alternates && decision.alternates.length > 0 && (
								<div class="applied-card__alts">
									<p class="applied-card__alts-label">Kept alternates</p>
									<div class="applied-card__alts-grid">
										{decision.alternates.map((alt) => (
											<figure>
												<div class="applied-card__alt-frame">
													<img src={alt} alt={`Alternate hero for ${item.title}`} loading="lazy" />
												</div>
												<figcaption>
													<a href={alt} target="_blank" rel="noreferrer">{alt.split('/').pop()}</a>
												</figcaption>
											</figure>
										))}
									</div>
								</div>
							)}
						</article>
					);
				})}
			</div>
		</div>
	</section>

	<section id="board" class="proposal-board" data-proposal-board>
		<div class="proposal-shell">
			<div class="proposal-toolbar" aria-label="Filters">
				<label class="proposal-search">
					<span>Search</span>
					<input data-search type="search" placeholder="Title, route, concept" />
				</label>

				<div class="proposal-filter-group" data-filter-group="priority">
					<span class="proposal-filter-label">Priority</span>
					<button type="button" class="is-active" data-filter-value="all">All</button>
					{priorities.map((priority) => (
						<button type="button" data-filter-value={priority}>{priority}</button>
					))}
				</div>

				<div class="proposal-filter-group" data-filter-group="targetType">
					<span class="proposal-filter-label">Placement</span>
					<button type="button" class="is-active" data-filter-value="all">All</button>
					{targetTypes.map((targetType) => (
						<button type="button" data-filter-value={targetType}>{targetType.replace('-', ' ')}</button>
					))}
				</div>

				<label class="proposal-select">
					<span>Family</span>
					<select data-family-filter>
						<option value="all">All families</option>
						{families.map((family) => <option value={family}>{family}</option>)}
					</select>
				</label>

				<div class="proposal-filter-group" data-filter-group="hasCandidates">
					<span class="proposal-filter-label">Candidates</span>
					<button type="button" class="is-active" data-filter-value="all">All</button>
					<button type="button" data-filter-value="with">With proposals</button>
					<button type="button" data-filter-value="without">Missing</button>
				</div>
			</div>

			<aside class="proposal-summary" aria-label="Decision summary">
				<div>
					<h2>Decisions</h2>
					<p><span data-pick-count>0</span> of {items.length} picked · <span data-skip-count>0</span> kept current</p>
				</div>
				<div class="proposal-summary__actions">
					<button type="button" data-clear-decisions>Clear</button>
					<button type="button" data-copy-decisions>Copy manifest</button>
				</div>
				<textarea data-decision-output readonly spellcheck="false" aria-label="Decision manifest"></textarea>
			</aside>

			<div class="proposal-list">
				{items.map((item) => (
					<article
						class:list={['proposal-item', `proposal-item--${item.priority}`]}
						data-proposal
						data-id={item.id}
						data-priority={item.priority}
						data-target-type={item.targetType}
						data-family={item.family}
						data-has-candidates={item.candidates.length > 0 ? 'with' : 'without'}
						data-search={`${item.title} ${item.route} ${item.issue} ${item.concept}`.toLowerCase()}
					>
						<header class="proposal-item__head">
							<div>
								<p class="proposal-item__meta">{item.targetType.replace('-', ' ')} · {item.family} · <span class="proposal-item__priority">{item.priority}</span></p>
								<h2>{item.title}</h2>
								<p class="proposal-item__route"><a href={item.localPath} target="_blank" rel="noreferrer">{item.localPath}</a></p>
							</div>
							<div class="proposal-item__decision" role="group" aria-label="Decision">
								<button type="button" data-keep-current>Keep current</button>
								<button type="button" data-clear-pick>Skip</button>
							</div>
						</header>

						<div class="proposal-item__media">
							<figure class="proposal-item__current" data-pick-target="current">
								<div class="proposal-item__media-frame">
									<img src={item.currentImage} alt="" loading="lazy" />
								</div>
								<figcaption>
									<span>Current</span>
									<a href={item.currentImage} target="_blank" rel="noreferrer">Open</a>
								</figcaption>
							</figure>

							{item.candidates.length === 0 ? (
								<p class="proposal-item__missing">No round-2 candidates generated yet.</p>
							) : (
								<div class="proposal-item__candidates">
									{item.candidates.map((c) => (
										<figure
											class="proposal-item__candidate"
											data-pick-candidate={c.publicPath}
											data-source={c.source}
										>
											<div class="proposal-item__media-frame">
												<img src={c.publicPath} alt="" loading="lazy" />
											</div>
											<figcaption>
												<span class:list={['proposal-item__source', `proposal-item__source--${c.source}`]}>{c.source}</span>
												<span class="proposal-item__label">{c.label}</span>
												<button type="button" data-pick-button data-pick-source={c.publicPath}>Pick</button>
												<a href={c.publicPath} target="_blank" rel="noreferrer">Open</a>
											</figcaption>
										</figure>
									))}
								</div>
							)}
						</div>

						<details class="proposal-item__details">
							<summary>Issue, concept &amp; prompt</summary>
							<p><strong>Issue:</strong> {item.issue}</p>
							<p><strong>Concept:</strong> {item.concept}</p>
							<p class="proposal-item__prompt"><strong>Original prompt (round-2 envelope wraps this with bright SG-classroom modifiers and a placement-specific editor):</strong> {item.prompt}</p>
							{item.candidateNotes && (
								<p><strong>Earlier seed note:</strong> {item.candidateNotes}</p>
							)}
						</details>
					</article>
				))}
			</div>

			{orphanStickers.length > 0 && (
				<section class="proposal-extras" aria-label="Logo and icon explorations">
					<h2>Logo &amp; icon explorations</h2>
					<p>Sticker-style takes on the Tinkercademy mark. Not tied to any placement — review for inspiration / brand updates.</p>
					<div class="proposal-extras__grid">
						{orphanStickers.map((c) => (
							<figure class="proposal-extras__item">
								<div class="proposal-item__media-frame">
									<img src={c.publicPath} alt="" loading="lazy" />
								</div>
								<figcaption>
									<span class="proposal-item__source proposal-item__source--sticker">sticker</span>
									<span class="proposal-item__label">{c.label}</span>
									<a href={c.publicPath} target="_blank" rel="noreferrer">Open</a>
								</figcaption>
							</figure>
						))}
					</div>
				</section>
			)}
		</div>
	</section>
</ContentLayout>

<script is:inline>
	(function () {
		const board = document.querySelector('[data-proposal-board]');
		if (!board) return;

		const items = Array.from(board.querySelectorAll('[data-proposal]'));
		const searchInput = board.querySelector('[data-search]');
		const familySelect = board.querySelector('[data-family-filter]');
		const decisionOutput = board.querySelector('[data-decision-output]');
		const pickCount = board.querySelector('[data-pick-count]');
		const skipCount = board.querySelector('[data-skip-count]');

		const filterState = {
			priority: 'all',
			targetType: 'all',
			family: 'all',
			hasCandidates: 'all',
			query: '',
		};

		const storageKey = 'tinkercademy-hero-proposals-decisions';
		const decisions = JSON.parse(localStorage.getItem(storageKey) || '{}');

		function normalise(v) {
			return String(v || '').toLowerCase().trim();
		}

		function itemMatches(item) {
			return (
				(filterState.priority === 'all' || item.dataset.priority === filterState.priority) &&
				(filterState.targetType === 'all' || item.dataset.targetType === filterState.targetType) &&
				(filterState.family === 'all' || item.dataset.family === filterState.family) &&
				(filterState.hasCandidates === 'all' || item.dataset.hasCandidates === filterState.hasCandidates) &&
				(!filterState.query || item.dataset.search.includes(filterState.query))
			);
		}

		function applyFilters() {
			items.forEach((item) => {
				item.hidden = !itemMatches(item);
			});
		}

		function syncDecisionState() {
			let picks = 0;
			let skips = 0;
			items.forEach((item) => {
				const decision = decisions[item.dataset.id];
				item.classList.toggle('is-picked', !!decision && decision.kind === 'candidate');
				item.classList.toggle('is-keep', decision?.kind === 'keep');
				item.querySelectorAll('[data-pick-candidate]').forEach((fig) => {
					fig.classList.toggle('is-picked', decision?.kind === 'candidate' && decision.image === fig.dataset.pickCandidate);
				});
				const currentFig = item.querySelector('[data-pick-target="current"]');
				if (currentFig) currentFig.classList.toggle('is-picked', decision?.kind === 'keep');
				if (decision?.kind === 'candidate') picks += 1;
				else if (decision?.kind === 'keep') skips += 1;
			});
			pickCount.textContent = String(picks);
			skipCount.textContent = String(skips);
			decisionOutput.value = items
				.map((item) => {
					const d = decisions[item.dataset.id];
					if (!d) return null;
					if (d.kind === 'keep') return `${item.dataset.id}: keep current`;
					return `${item.dataset.id}: ${d.image}`;
				})
				.filter(Boolean)
				.join('\n');
			localStorage.setItem(storageKey, JSON.stringify(decisions));
		}

		function setDecision(id, decision) {
			if (!decision) delete decisions[id];
			else decisions[id] = decision;
			syncDecisionState();
		}

		board.querySelectorAll('[data-filter-group]').forEach((group) => {
			group.querySelectorAll('button[data-filter-value]').forEach((button) => {
				button.addEventListener('click', () => {
					group.querySelectorAll('button').forEach((peer) => peer.classList.remove('is-active'));
					button.classList.add('is-active');
					filterState[group.dataset.filterGroup] = button.dataset.filterValue;
					applyFilters();
				});
			});
		});

		searchInput.addEventListener('input', () => {
			filterState.query = normalise(searchInput.value);
			applyFilters();
		});

		familySelect.addEventListener('change', () => {
			filterState.family = familySelect.value;
			applyFilters();
		});

		items.forEach((item) => {
			item.querySelectorAll('[data-pick-button]').forEach((btn) => {
				btn.addEventListener('click', () => {
					setDecision(item.dataset.id, { kind: 'candidate', image: btn.dataset.pickSource });
				});
			});
			const keepBtn = item.querySelector('[data-keep-current]');
			if (keepBtn) keepBtn.addEventListener('click', () => setDecision(item.dataset.id, { kind: 'keep' }));
			const clearBtn = item.querySelector('[data-clear-pick]');
			if (clearBtn) clearBtn.addEventListener('click', () => setDecision(item.dataset.id, null));
		});

		board.querySelector('[data-clear-decisions]').addEventListener('click', () => {
			Object.keys(decisions).forEach((k) => delete decisions[k]);
			syncDecisionState();
		});

		board.querySelector('[data-copy-decisions]').addEventListener('click', async (event) => {
			const button = event.currentTarget;
			await navigator.clipboard.writeText(decisionOutput.value);
			const original = button.textContent;
			button.textContent = 'Copied';
			window.setTimeout(() => { button.textContent = original; }, 1200);
		});

		applyFilters();
		syncDecisionState();
	})();
</script>

<style>
	.proposal-shell {
		width: min(1280px, calc(100% - 32px));
