---
/**
 * /tinker-x — Saturday open makerspace sessions with a mentor.
 */
import CtaBanner from '../components/CtaBanner.astro';
import ContentLayout from '../layouts/ContentLayout.astro';

const canonical = 'https://tinkercademy.com/tinker-x/';

// Illustrated in the same palette as "What's in the room", rather than the
// shared T Krobot banner system. The site theme picks the day or dusk art.
const hero = {
	day: '/images/tinker-x/hero-day.webp',
	dusk: '/images/tinker-x/hero-dusk.webp',
	width: 1600,
	height: 900,
};

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=59+Jalan+Pemimpin+%2304-01+Singapore+577218';

const facts = [
	{ label: 'When', value: 'Saturdays, 10am–4pm', note: 'Book a day, then arrive any time.' },
	{ label: 'Where', value: '59 Jalan Pemimpin, #04‑01', note: 'Singapore 577218', href: mapsUrl },
	{ label: 'How long', value: '2–3 hours', note: 'What most members stay for.' },
	{ label: 'Cost', value: 'First session free', note: 'Then $50 a session.' },
];

const steps = [
	{
		title: 'Talk',
		body: 'Tell Akmal what you want to make, or what you\'re curious about. If you\'re not sure yet, that\'s the first conversation.',
	},
	{
		title: 'Point',
		body: 'He points you to a tutorial, our course notes, a kit from the library, or the right machine.',
	},
	{
		title: 'Build',
		body: 'You work on it. He checks in now and then, and you ask when you\'re stuck.',
	},
	{
		title: 'Reflect',
		body: 'Before you leave, you talk through what you learnt and what comes next.',
	},
];

const mentor = {
	name: 'Akmal',
	photo: '/images/Pu1dBwUoLq1avwW9evSZnAQ.jpg',
	bio: 'Cornell grad (CS & EE) and former MOE Physics and Maths teacher. Co-founded Tinkercademy and runs Tinker X every Saturday. Spends the rest of the week vibe coding side projects, building electronics, and 3D printing and laser cutting on the same machines you\'ll use.',
};

const habits = [
	{ title: 'Curiosity:', body: 'wanting to know why the sensor reads nonsense, not just making it stop.' },
	{ title: 'Grit:', body: 'staying with a problem through the fourth failed attempt.' },
	{ title: 'Systematic troubleshooting:', body: 'changing one thing at a time and testing each change.' },
	{ title: 'Reflective practice:', body: 'looking back at what worked, what didn\'t, and what to try next.' },
	{ title: 'Documentation:', body: 'writing the project up so someone else could build it.' },
];

const practices = [
	{ title: 'Deciding', body: 'what to build, and cutting it down to something they can finish.' },
	{ title: 'Developing judgement', body: 'about when and how to use AI: what to hand over, and what to work out themselves.' },
	{ title: 'Asking good questions', body: 'of a mentor, a datasheet, or an AI.' },
	{ title: 'Checking the AI\'s work', body: 'instead of trusting it: testing, reading the code, asking why.' },
	{ title: 'Explaining', body: 'what they built and how it works, out loud, to a person.' },
];

const projects = [
	{
		name: 'Aidan',
		title: 'Berlin clock',
		body: 'A clock that tells the time in rows of coloured LEDs, run by a Raspberry Pi Pico. He debugged it until the lights came on in the right order.',
		image: '/images/tinker-x/project-berlin-clock.webp',
		url: 'https://ghost.tk.sg/berlin-clock/',
	},
	{
		name: 'Raphael',
		title: 'Arduino coffee machine',
		body: 'Learnt to solder while wiring an Arduino into a Gaggia coffee machine.',
		image: '/images/tinker-x/project-coffee-machine.webp',
		url: 'https://ghost.tk.sg/arduino-powered-coffee-machine/',
	},
	{
		name: 'Dhruv',
		title: 'Word clock',
		body: 'Worked out the hardware and wrote the code for a word clock, with no instructions to follow.',
		image: '/images/tinker-x/project-word-clock.webp',
		url: 'https://ghost.tk.sg/word-clock/',
	},
	{
		name: 'Pin Hua',
		title: 'Laser-cut alarm clock',
		body: 'Designed the housing in Inkscape and laser cut it, fixing the file each time the pieces didn\'t fit.',
		image: '/images/tinker-x/project-alarm-clock.webp',
		url: 'https://ghost.tk.sg/alarm-clock/',
	},
	{
		name: 'Kevin',
		title: 'Class sign',
		body: 'An engraved, LED-lit sign for his classroom door.',
		image: '/images/tinker-x/project-class-sign.webp',
		url: 'https://ghost.tk.sg/class-sign/',
	},
	{
		name: 'Kavi',
		title: 'Minecraft city builder',
		body: 'Programmed an agent in Minecraft: Education Edition to build a city for him.',
		image: '/images/tinker-x/project-minecraft.webp',
		url: 'https://ghost.tk.sg/minecraft/',
	},
];

const room = [
	{
		title: 'Laser cutter',
		body: 'Cuts and engraves wood and acrylic. Most enclosures and signs start here.',
		image: '/images/tinker-x/room-laser.webp',
	},
	{
		title: 'Electronics library',
		body: 'Hundreds of labelled boxes of boards, sensors, motors, LEDs and cables.',
		image: '/images/tinker-x/room-parts.webp',
	},
	{
		title: 'Electronics bench',
		body: 'Soldering stations, hand tools, a bench power supply and an oscilloscope.',
		image: '/images/tinker-x/room-bench.webp',
	},
	{
		title: '3D printers',
		body: 'For printing enclosures, mounts and custom parts.',
		image: '/images/tinker-x/room-printer-k1.webp',
	},
	{
		title: 'Materials and woodwork',
		body: 'Sheet materials and the hand and power tools to cut, shape and join them.',
		image: '/images/tinker-x/room-materials.webp',
	},
	{
		title: 'Books',
		body: 'Reference books and magazines on programming, electronics and making.',
		image: '/images/tinker-x/room-books.webp',
	},
];

// Two steps rather than tier cards: there are no packages to compare, so
// the panel shows the path (free, then per Saturday) and what each day includes.
const pricingSteps = [
	{
		label: 'Your first Saturday',
		price: 'Free',
		note: 'Write in and we\'ll find a Saturday that suits you.',
		ctaLabel: 'Book a free trial',
		ctaUrl: '/contact-us/',
		primary: true,
	},
	{
		label: 'Every Saturday after',
		price: '$50',
		unit: 'a day',
		note: 'Book each Saturday online, whenever you want to come.',
		ctaLabel: 'Book a day pass',
		ctaUrl: 'https://tidycal.com/tinkerx/day-pass',
		primary: false,
	},
];

const included = [
	'A mentor in the room all day',
	'The laser cutter, 3D printers and electronics bench, after a safety briefing',
	'The parts library, kits and our course notes',
	'AI tools, and a laptop to borrow if you need one',
	'Stay as long as you like, 10am–4pm',
];

const faqs = [
	{
		question: 'How old does my child need to be?',
		answer:
			'There\'s no minimum age. Most members are in secondary school, and the youngest who get a lot out of it are around 11 or 12.',
	},
	{
		question: 'Do they need coding experience?',
		answer: 'No. Beginners start with a guided project, and experienced members bring their own.',
	},
	{
		question: 'What if they don\'t know what to build?',
		answer:
			'That\'s the first conversation of every session. We\'ll suggest something based on what they like and what past members have made.',
	},
	{
		question: 'Do they need a laptop?',
		answer: 'Bring one if you can. We can lend one if not.',
	},
	{
		question: 'Do parents stay?',
		answer: 'Your choice. Stay, drop them off, or let them come on their own.',
	},
	{
		question: 'How does booking work?',
		answer:
			'Book a Saturday, then arrive any time between 10am and 4pm that day. Most people stay 2–3 hours.',
	},
	{
		question: 'Can adults join?',
		answer: 'Yes. Tinker X isn\'t only for kids.',
	},
	{
		question: 'How is this different from an enrichment class?',
		answer:
			'There\'s no fixed syllabus. Members pick a project and learn what they need to finish it, with help when they get stuck.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: { '@type': 'Answer', text: faq.answer },
	})),
};

const isExternal = (url: string) => url.startsWith('http');
---

<ContentLayout
	title="Tinker X — Saturday makerspace sessions — Tinkercademy"
	description="Open makerspace sessions every Saturday in Singapore. Build your own projects with a mentor, a laser cutter, 3D printers, an electronics library and AI tools. First session free."
	canonical={canonical}
	image={hero.day}
	preloadHero={{ src: hero.day }}
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<section class="tx-hero">
		<img
			class="tx-hero__art tx-hero__art--day"
			src={hero.day}
			alt=""
			width={hero.width}
			height={hero.height}
			fetchpriority="high"
		/>
		<img
			class="tx-hero__art tx-hero__art--dusk"
			src={hero.dusk}
			alt=""
			width={hero.width}
			height={hero.height}
			loading="lazy"
		/>
		<div class="tx-hero__content shell">
			<p class="tx-hero__eyebrow">Saturdays, 10am–4pm · Jalan Pemimpin</p>
			<h1 class="tx-hero__title">Tinker X</h1>
			<p class="tx-hero__lead">
				An open makerspace for kids (and grown-ups) who want to build their own projects. Drop
				in on a Saturday, pick something to make, and work on it with a mentor in the room and
				AI tools on hand.
			</p>
			<div class="tx-hero__actions">
				<a class="tx-btn tx-btn--primary" href="/contact-us/">Try a free session</a>
				<a class="tx-btn tx-btn--ghost" href="#pricing">See prices</a>
			</div>
		</div>
	</section>

	<section class="tx-facts" aria-label="Session details">
		<div class="shell">
			<dl class="tx-facts__grid">
				{facts.map((fact) => (
					<div class="tx-fact">
						<dt>{fact.label}</dt>
						<dd class="tx-fact__value">
							{fact.href ? (
								<a href={fact.href} target="_blank" rel="noopener noreferrer">{fact.value}</a>
							) : (
								fact.value
							)}
						</dd>
						<dd class="tx-fact__note">{fact.note}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<section class="tx-section">
		<div class="shell">
			<h2 class="tx-h2">How a Saturday works</h2>
			<ol class="tx-steps">
				{steps.map((step, idx) => (
					<li class="tx-step">
						<span class="tx-step__num" aria-hidden="true">{idx + 1}</span>
						<h3 class="tx-step__title">{step.title}</h3>
						<p>{step.body}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="tx-section tx-section--muted">
		<div class="shell tx-mentor">
			<img class="tx-mentor__photo" src={mentor.photo} alt={mentor.name} loading="lazy" />
			<div>
				<p class="tx-kicker">Your mentor</p>
				<h2 class="tx-h2">{mentor.name}</h2>
				<p class="tx-mentor__bio">{mentor.bio}</p>
			</div>
		</div>
	</section>

	<section class="tx-section">
		<div class="shell tx-split tx-split--reverse">
			<div class="tx-split__text">
				<h2 class="tx-h2">Making real things, and getting them to work</h2>
				<p>
					Members build what they want to build, not what they're told to. There's no curriculum and
					no set project, so one member makes a word clock while another wires an Arduino into a
					coffee machine. Choosing a project, planning it and seeing it through are things most
					students never get to practise in a classroom.
				</p>
				<p>
					Physical computing is code that does something in the room: it lights an LED, turns a
					motor, reads a sensor, or sounds an alarm at 7am. Digital making covers the rest of the
					project, like designing a case on a laptop, then laser cutting it from plywood or 3D printing it.
				</p>
				<p>
					Real things don't behave like a screen. Parts don't fit, wires come loose, and a sensor
					reads nonsense until you find out why. So a good part of every Saturday goes into
					troubleshooting: checking one thing at a time, measuring instead of guessing, and trying again.
				</p>
				<p>
					For a curious kid, that's the fun part. Each problem is a puzzle, and they pick up the
					theory (Ohm's law, loops, tolerances) because the project won't work without it.
				</p>
			</div>
			<aside class="tx-split__card">
				<h3>What making builds</h3>
				<ul>
					{habits.map((item) => (
						<li><strong>{item.title}</strong> {item.body}</li>
					))}
				</ul>
				<p class="tx-split__note">
					These habits are what a strong maker portfolio shows. MIT, Tufts and Columbia accept maker
					portfolios with applications, and MIT
					<a href="https://mitadmissions.org/apply/firstyear/portfolios-additional-material/" target="_blank" rel="noopener noreferrer">tells applicants</a>
					it's "more interested in your build process than your end results." Members write up each
					project on the Tinker X blog, so they have a record to build one from.
				</p>
			</aside>
		</div>
	</section>

	<section class="tx-section tx-section--muted">
		<div class="shell tx-split">
			<div class="tx-split__text">
				<h2 class="tx-h2">Building with AI, thinking for yourself</h2>
				<p>
					Agentic coding tools (Claude Code, Codex, Cursor) can now build a working app from a
					paragraph of instructions. Professional developers use them every day, and so do our
					members. We're still working out, session by session, where they help a learner and
					where they get in the way.
				</p>
				<p>
					What we've seen so far: the AI will happily write code a 13-year-old can't read, and fix
					a bug they never understood. So we let it handle the parts that would stall a project (a
					library they've never used, an error message that makes no sense) and keep the thinking
					with the member.
				</p>
				<p>
					Before ChatGPT, I was the one answering those questions. AI answers most of them now. It
					won't notice you've been stuck on the same bug for 40 minutes. It won't tell you the
					project you picked is really three projects. And it won't ask, at the end of the day,
					what you actually learnt.
				</p>
			</div>
			<aside class="tx-split__card">
				<h3>What members practise</h3>
				<ul>
					{practices.map((item) => (
						<li><strong>{item.title}</strong> {item.body}</li>
					))}
				</ul>
			</aside>
		</div>
	</section>

	<section class="tx-section">
		<div class="shell">
			<h2 class="tx-h2">What members have built</h2>
			<p class="tx-sub">A few past projects, each written up by the member who made it.</p>
			<div class="tx-projects">
				{projects.map((project) => (
					<a class="tx-project" href={project.url} target="_blank" rel="noopener">
						<img src={project.image} alt={`${project.title} by ${project.name}`} loading="lazy" width="1000" height="750" />
						<div class="tx-project__text">
							<h3>{project.title}</h3>
							<p class="tx-project__name">{project.name}</p>
							<p>{project.body}</p>
						</div>
					</a>
				))}
			</div>
			<p class="tx-more">
				More past projects on the <a href="https://ghost.tk.sg/" target="_blank" rel="noopener">Tinker X blog</a>.
			</p>
		</div>
	</section>

	<section class="tx-section tx-section--muted">
		<div class="shell">
			<h2 class="tx-h2">What's in the room</h2>
			<p class="tx-sub">
				Members can use everything here (with a safety briefing for the machines), plus our
				course notes and a library of kits.
			</p>
			<div class="tx-room">
				{room.map((item, idx) => (
					<figure class:list={['tx-room__item', idx === 0 && 'tx-room__item--feature']}>
						<img src={item.image} alt={`Illustration of the ${item.title.toLowerCase()}`} loading="lazy" width="1200" height="900" />
						<figcaption>
							<strong>{item.title}</strong>
							<span>{item.body}</span>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>

	<section class="tx-section" id="pricing">
		<div class="shell">
			<h2 class="tx-h2">Try it free, then pay per session</h2>
			<p class="tx-sub">
				No membership and no packages. You pay only for the Saturdays you come.
			</p>
			<div class="tx-price">
				<ol class="tx-price__steps">
					{pricingSteps.map((step, idx) => (
						<li class="tx-price__step">
							<span class="tx-price__num" aria-hidden="true">{idx + 1}</span>
							<div class="tx-price__body">
								<h3 class="tx-price__label">{step.label}</h3>
								<p class="tx-price__amount">
									{step.price}
									{step.unit && <span class="tx-price__unit">{step.unit}</span>}
								</p>
								<p class="tx-price__note">{step.note}</p>
								<a
									class:list={['tx-price__cta', !step.primary && 'tx-price__cta--ghost']}
									href={step.ctaUrl}
									target={isExternal(step.ctaUrl) ? '_blank' : undefined}
									rel={isExternal(step.ctaUrl) ? 'noopener noreferrer' : undefined}
								>
									{step.ctaLabel}
								</a>
							</div>
						</li>
					))}
				</ol>
				<div class="tx-price__included">
					<h3>Every session includes</h3>
					<ul>
						{included.map((item) => <li>{item}</li>)}
					</ul>
					<p class="tx-price__fine">
						Prices in SGD. If cost is a barrier, see <a href="#scholars">Tinker X Scholars</a>.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="tx-section tx-section--muted">
		<div class="shell">
			<h2 class="tx-h2">Questions parents ask</h2>
			<div class="tx-faq">
				{faqs.map((faq) => (
					<details class="tx-faq__item">
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="tx-section tx-section--tight">
		<div class="shell">
			<div class="tx-scholars" id="scholars">
				<img
					class="tx-scholars__art"
					src="/images/tinker-x/scholars-mentor.webp"
					alt="Illustration of an older student showing a younger one how to solder"
					width="1200"
					height="900"
					loading="lazy"
				/>
				<div>
					<h2>Tinker X Scholars</h2>
					<p>
						If cost is what's stopping a student who already builds things, we offer heavily
						subsidised membership. Send us a portfolio at
						<a href="mailto:hello@tinkercademy.com">hello@tinkercademy.com</a> (effort counts more
						than polish). In return, scholars help newer members or find another way to use their skills for the community.
					</p>
				</div>
			</div>
		</div>
	</section>

	<CtaBanner
		text="Come down on a Saturday and build something. Your first session is free."
		ctas={[
			{ label: 'Book a free trial', url: '/contact-us/' },
			{ label: 'See prices', url: '#pricing' },
		]}
	/>
</ContentLayout>

<style>
	/* ── Hero ── */
	.tx-hero {
		--hero-bg: #f4ede2;
		--hero-ink: #2b2724;
		--hero-ink-soft: rgba(43, 39, 36, 0.78);
		--hero-btn-bg: #2b2724;
		--hero-btn-fg: #f4eee3;
		--hero-btn-line: rgba(43, 39, 36, 0.45);
		--hero-btn-hover: rgba(43, 39, 36, 0.08);
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: clamp(480px, 38vw, 600px);
		overflow: clip;
		background: var(--hero-bg);
	}

	.tx-hero__art {
		position: absolute;
		top: 0;
		right: 0;
		height: 100%;
		width: auto;
		max-width: none;
		mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
	}

	.tx-hero__art--dusk {
		display: none;
	}

	.tx-hero__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: inherit;
		padding: 3.5rem 0;
		gap: 0.75rem;
	}

	.tx-hero__eyebrow {
		font-family: 'Rubik', sans-serif;
		font-size: 0.82rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--hero-ink-soft);
		margin: 0;
	}

	.tx-hero__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 1;
		color: var(--hero-ink);
		margin: 0;
	}

	/* The shared red title glow is tuned for dark heroes; dark theme restores it. */
	.tx-hero__title {
		animation: none;
		text-shadow: none;
	}

	.tx-hero__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: var(--hero-ink-soft);
		margin: 0;
		max-width: min(34rem, 38vw);
	}

	.tx-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 0.5rem;
	}

	.tx-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		padding: 0.65rem 1.15rem;
		border-radius: 999px;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.92rem;
		font-weight: 500;
		transition: background 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
	}

	.tx-btn--primary {
		background: var(--hero-btn-bg);
		color: var(--hero-btn-fg);
		border: 1px solid var(--hero-btn-bg);
	}

	.tx-btn--primary:hover {
		opacity: 0.86;
	}

	.tx-btn--ghost {
		border: 1px solid var(--hero-btn-line);
		color: var(--hero-ink);
	}

	.tx-btn--ghost:hover {
		border-color: var(--hero-ink);
		background: var(--hero-btn-hover);
	}

	.tx-btn:focus-visible {
		outline: 2px solid var(--hero-ink);
		outline-offset: 3px;
	}

	/* Dark theme (explicit toggle, or system preference with no toggle set) */
	:global(:root[data-theme='dark']) .tx-hero {
		--hero-bg: #2a2622;
		--hero-ink: #fff;
