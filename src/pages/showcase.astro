---
/**
 * /showcase — Astro-native rebuild: student + intern spotlights.
 */
import CtaBanner from '../components/CtaBanner.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getStaticPage } from '../lib/data.js';
import { localiseFramerImage } from '../lib/media.js';

const page = getStaticPage('/showcase');
if (!page) return Astro.redirect('/404');

const canonical = 'https://tinkercademy.com/showcase/';

const heroImage = localiseFramerImage(page.hero_image ?? '');
const heroTitle =
	page.hero_title ?? 'Apps, bots, circuits\nand the makers behind them.';

type Block = { tag?: string; text?: string };
const blocks: Block[] = (page.blocks ?? []) as Block[];
const heroLead =
	blocks.find((b) => b.tag === 'h4' && (b.text ?? '').includes('bright minds'))?.text ??
	"Meet the bright minds who've learned, built, and grown with us, from classroom projects to professional success.";

const heroTitleHtml = heroTitle
	.replace(
		/\b(makers)\b/gi,
		(_match: string, word: string) => `<span class="sc-hero__accent">${word}</span>`,
	)
	.replace(/\n/g, '<br />');

const buildLogUrl = '/blog/';

const jiaChenImage = '/images/yYM9MCFxtou9IT7a8ENaXgPmUY.png';

const internTestimonials = [
	{
		name: 'Raynold',
		role: 'Software Development Intern, 2017',
		quote:
			'This internship was so much than just a programming task. As the project owner, I went through all stages of product development. From the idea generation, discussion with end users, development, live demonstrations to troubleshooting and maintenance.',
	},
	{
		name: 'Colin',
		role: 'Machine Learning & Data Science Intern, 2017',
		quote:
			'Being at Tinkertanker gave me the drive and motivation to push through the courses on a very tight schedule, thanks to the mentors who were there to provide not just answers, but the right questions and resources to find out myself.',
	},
	{
		name: 'Joelle',
		role: 'Computer Engineering Intern, 2017',
		quote:
			'I am really happy to have worked on several projects that were put to life. It was a little nerve-wrecking and mind boggling but I\'m glad everything turned out okay. Through this experience, I have learnt how to appreciate and enjoy the building process apart from looking at the end product.',
	},
	{
		name: 'Mark',
		role: 'Teaching & Curriculum Design Intern, 2023',
		quote:
			'Due to the nature of Tinkertanker as a tech education company, it has a wealth of resources you can make use of to expand your technical knowledge. It\'s a different experience from the traditional software engineering job, and I appreciate its role in broadening my horizons.',
	},
	{
		name: 'Enric',
		role: 'Computer Science Intern, 2023',
		quote:
			'All in all, interning at Tinkertanker was a very enriching experience. I was able to take part in the teaching of classes and even try out many different coding languages and programs such as VMs. And all of these have helped me improve and grow as a Computer Science undergraduate.',
	},
	{
		name: 'Yun Xuan',
		role: 'Software Development Intern, 2024',
		quote:
			'Overall, all these experiences have made my internship a thoroughly enjoyable and educational experience. I believe it provided me with a diverse set of skills and insights that I will carry forward in my professional journey. I am very grateful to everyone who helped make this enriching experience possible.',
	},
];

const jiaChenQuote =
	'Meet Jia Chen, a young visionary from Singapore whose journey into the world of technology began with childhood exploration and the transformative power of mobile apps. Inspired by the seamless fusion of science and technology, Jia Chen embarked on a swift learning curve, mastering the Swift programming language and unveiling his debut iOS app on the App Store at a remarkably young age. An Information Technology diploma graduate from Ngee Ann Polytechnic, Jia Chen\'s creative process is seamlessly integrated into the Apple ecosystem, from sketching app designs on iPad to bringing them to life with Xcode on Mac. With six apps already gracing the App Store and two Swift Student Challenge triumphs under his belt, Jia Chen epitomises the next generation of creators and innovators.';

const blogArticles = [
	{
		title: 'Reframing my thoughts on website builders',
		link: '/blog/2024/reframing-my-thoughts-on-website-builders/',
		author: 'nyx',
		date: 'Jul 30, 2024',
		excerpt:
			"Recently, I joined Tinkertanker as an intern and as part of my role I spent a half-dozen hours daily prodding and poking around at a spectacular website builder - 'Framer'.",
		featureImage: '/blog-media/bbc0b8466b0612e25a1bad09a4435fcbfb02be51d94de71f84527126b1ecfe0b.jpg',
	},
	{
		title: 'Now That AI Can Generate Code, Should the Everyday Student Stop Learning How to Code?',
		link: '/blog/2024/now-that-ai-can-generate-code-should-the-everyday-student-stop-learning-how-to-code/',
		author: 'Tinkercademy',
		date: 'May 8, 2024',
		excerpt:
			"Picture this: a world where coding is as effortless as conversing in English, where programming becomes akin to a casual chat with computers. According to Jensen Huang, CEO of NVIDIA, this isn't a mere fantasy, it will soon be a reality for us all - thanks to AI.",
		featureImage: '/blog-media/330a8bb214ed43be57f0db7c7d132097b59906e2a97a52c4181ddc8a32bd08d7.jpg',
	},
	{
		title: 'Orange v/s PyCaret v/s Scikit: A Comparison of Beginner Machine Learning Libraries',
		link: '/blog/2024/orange-v-s-pycaret-v-s-scikit-a-comparison-of-beginner-machine-learning-libraries/',
		author: 'ng mh',
		date: 'Mar 22, 2024',
		excerpt:
			'TLDR: A discussion on which of these 3 Data Science/Machine Learning libraries you should pick for your next data science / machine learning project.',
		featureImage: '/blog-media/1f1671f5d2e1801d9da94a59c88fc4426264007c2751fc120fcf55e11dbe1ace.png',
	},
	{
		title: 'What is it like to build games on Unity?',
		link: '/blog/2024/what-is-it-like-to-build-games-on-unity/',
		author: 'Tinkercademy',
		date: 'Feb 2, 2024',
		excerpt:
			"Between 20th to 24th November, a group of 14 to 18-year-olds, entered the computer labs of St Patricks' School, carrying laptops, water bottles and an eager mind for learning a new, much-coveted skill - Game Development in Unity.",
		featureImage: '/blog-media/37dc8e72b73b9b45e47af97b6b4870ae17f524dd9fde238da099cbe96ae28f0c.gif',
	},
	{
		title: 'What We Learnt from our Latest Sew & Code Camp',
		link: '/blog/2024/what-we-learnt-from-our-latest-sew-and-code-camp/',
		author: 'Tinkercademy',
		date: 'Feb 2, 2024',
		excerpt:
			'During the recent December holidays, we organised a unique coding camp - one that had a distinctly different flavour from our regular camps. Compared to those, this camp was a hybrid of coding and sewing.',
		featureImage: '/blog-media/d480c299cc5fcb6d95d3b764fff2f2353095c5cc3deb98331741e7dc6b4868eb.jpg',
	},
	{
		title: 'Having fun with Automata and LittleBits!',
		link: '/blog/2023/having-fun-with-automata-and-littlebits/',
		author: 'Toh yixue',
		date: 'Nov 20, 2023',
		excerpt:
			'I have always been fascinated with the idea of Automata. A quick Pinterest search will yield you countless amazing examples of these, made out of wood, paper, metal and more...',
		featureImage: '/blog-media/22e4d4940fc050daf03b212d4a2fcd31fa567cb88c9799815500d9a56360486a.jpg',
	},
	{
		title: 'Using Python and Pandas to generate useful reports out of CSV files, part 2',
		link: '/blog/2023/using-python-and-pandas-to-generate-useful-reports-out-of-csv-files-part-2/',
		author: 'Ong Yi Shen',
		date: 'Oct 13, 2023',
		excerpt:
			'Continuing with part 1, I will continue to use the cleaned data from the CSV to create a more detailed report, this time I want to create a report for each individual teacher, with aggregated statistics for each teaching group.',
		featureImage: '/blog-media/f5d737e7c6d3cdd53c1d005b46461edb51c3d398b7028ed0ace7b37691da0f88.png',
	},
	{
		title: 'Using Python and Pandas to generate useful reports out of CSV files, part 1',
		link: '/blog/2023/using-python-and-pandas-to-generate-useful-reports-out-of-csv-files-part-1/',
		author: 'Ong Yi Shen',
		date: 'Oct 10, 2023',
		excerpt:
			'Below, Ong Yi Shen, our intern from Nanyang Technological University (NTU) tackles this task as he uses a variety of Python tricks to clean, analyse and report data obtained from CSV files.',
		featureImage: '/blog-media/f5d737e7c6d3cdd53c1d005b46461edb51c3d398b7028ed0ace7b37691da0f88.png',
	},
	{
		title: 'Tinkertanker Internship: Bowling at Tinkertanker',
		link: '/blog/2023/tinkertanker-internship-bowling-at-tinkertanker/',
		author: 'Mark',
		date: 'Oct 6, 2023',
		excerpt:
			'Do you ever pour boiling soup into a cup and think to yourself, "Wow, this is taking really long to cool, if only my liquid was in a container of greater diameter, giving it more exposed surface area to lose heat from?"',
		featureImage: '/blog-media/4410ffb01d2d99f0fdc992f6762b488d4ecbb1d7c250e3f6e89b5a622dd39445.png',
	},
	{
		title: 'Internship Reflection: A dive into many new things',
		link: '/blog/2023/internship-reflection-a-dive-into-many-new-things/',
		author: 'Enric Tan',
		date: 'Oct 2, 2023',
		excerpt:
			'In my summer break as a year 1 student at NTU, I decided to take an internship with Tinkertanker to expose myself to more coding languages and learn more about Computer Sciences.',
		featureImage: '/blog-media/427ab4a3ad28fe54b8e9dc239ffc5781bc9f1ca4bfb70c90720e9c8deff1afa6.png',
	},
];
---

<ContentLayout
	title="Showcase — Tinkercademy"
	description="Meet the coders, tinkerers, and makers who've learned, built, and grown with Tinkercademy — from classroom projects to professional success."
	canonical={canonical}
	image={heroImage}
>
	<section class="sc-hero">
		{heroImage && (
			<img class="sc-hero__bg" src={heroImage} alt="" loading="eager" fetchpriority="high" />
		)}
		<div class="sc-hero__scrim"></div>
		<div class="sc-hero__content shell">
			<h1 class="sc-hero__title" set:html={heroTitleHtml} />
			<p class="sc-hero__lead">{heroLead}</p>
			<div class="sc-hero__actions">
				<a class="sc-hero__cta" href={buildLogUrl}>Build Log</a>
			</div>
		</div>
	</section>

	<section class="sc-section">
		<div class="shell">
			<h2 class="sc-section__heading">Our Projects</h2>
			<p class="sc-section__lead">
				We've built some pretty amazing things, together with our learners. Read more at
				<a href={buildLogUrl}>our blog</a>.
			</p>
			<div class="sc-carousel__track-wrapper">
			<div class="sc-carousel__track">
				{[...blogArticles, ...blogArticles].map((article, i) => (
					<a
						href={article.link}
						class="sc-carousel__card"
						aria-hidden={i >= blogArticles.length ? 'true' : undefined}
						tabindex={i >= blogArticles.length ? -1 : undefined}
					>
						<div class="sc-carousel__media">
							<img
								class="sc-carousel__img"
								src={article.featureImage}
								alt=""
								loading="lazy"
							/>
						</div>
						<div class="sc-carousel__body">
							<p class="sc-carousel__title">{article.title}</p>
							<p class="sc-carousel__excerpt">{article.excerpt}</p>
							<div class="sc-carousel__meta">
								<span class="sc-carousel__byline">
									{article.author} · {article.date}
								</span>
								<span class="sc-carousel__readmore">Read story →</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
		</div>
	</section>

	<section class="sc-section sc-section--muted">
		<div class="shell">
			<h2 class="sc-section__heading">Our Interns</h2>
			<p class="sc-section__lead">
				Through hands-on experience and mentorship, our interns work on real projects that shape
				the future of education and technology. Here are what they have to say about their
				experiences!
			</p>

			<div class="sc-interns">
				{internTestimonials.map((intern) => (
					<article class="sc-intern-card">
						<blockquote class="sc-intern-card__quote">
							<p>“{intern.quote}”</p>
						</blockquote>
						<footer class="sc-intern-card__meta">
							<span class="sc-intern-card__name">{intern.name}</span>
							<span class="sc-intern-card__role">{intern.role}</span>
						</footer>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="sc-spotlight">
		<div class="shell sc-spotlight__inner">
			<figure class="sc-spotlight__figure">
				<img src={jiaChenImage} alt="Jia Chen" />
				<figcaption>Image from apple.com</figcaption>
			</figure>
			<div class="sc-spotlight__content">
				<p class="sc-spotlight__eyebrow">Swift Accelerator Programme Trainer at Tinkertanker</p>
				<h2 class="sc-spotlight__title">Meet Jia Chen</h2>
				<p class="sc-spotlight__body">{jiaChenQuote}</p>
				<p class="sc-spotlight__source">
					As featured on Apple:
					<a
						href="https://www.apple.com/education/college-students/success-stories/yee/"
						target="_blank"
						rel="noopener"
					>apple.com</a>
				</p>
			</div>
		</div>
	</section>

	<section class="sc-buildlog">
		<div class="shell sc-buildlog__inner">
			<h2 class="sc-buildlog__heading">Learn more about what our alumni have done!</h2>
			<p class="sc-buildlog__body">
				We're building software, electronics, curriculum — and the next generation of coders,
				makers, and creators. Come check out our build log and contribute to it one day!
			</p>
			<a class="sc-buildlog__cta" href={buildLogUrl}>
				Build Log
			</a>
		</div>
	</section>

	<CtaBanner />
</ContentLayout>

<style>
	.sc-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: clamp(440px, 58vh, 620px);
		overflow: clip;
		background: #0a0a0a;
	}

	.sc-hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.sc-hero__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.35) 0%,
			rgba(0, 0, 0, 0.15) 40%,
			rgba(0, 0, 0, 0.7) 100%
		);
	}

	.sc-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: inherit;
		padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 5vw, 4rem);
		gap: 1.1rem;
	}

	.sc-hero__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 1;
		color: #fff;
		margin: 0;
		text-wrap: balance;
	}

	.sc-hero__accent {
		color: rgb(240, 93, 87);
	}

	.sc-hero__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.92);
		margin: 0;
		max-width: 48ch;
	}

	.sc-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.sc-hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		padding: 0.65rem 1.15rem;
		border-radius: 999px;
		background: var(--accent-dark);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.sc-hero__cta,
	.sc-hero__cta:visited,
	.sc-hero__cta:hover,
	.sc-hero__cta:active {
		color: #fff;
		text-decoration: none;
	}

	.sc-hero__cta:hover {
		background: rgb(154, 44, 39);
		transform: translateY(-1px);
	}

	.sc-section {
		padding: 3rem 0;
	}

	.sc-section--muted {
		background: #fafafa;
	}

	.sc-section__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0 0 0.75rem;
	}

	.sc-section__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: rgb(110, 110, 110);
		margin: 0 0 2rem;
		max-width: 60rem;
	}

	.sc-spotlight__inner {
		display: flex;
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3rem);
	}

	.sc-spotlight__figure {
		margin: 0;
		flex: 0 0 clamp(260px, 36vw, 420px);
		width: clamp(260px, 36vw, 420px);
	}

	.sc-spotlight__figure img {
		width: 100%;
		height: auto;
		border-radius: 14px;
		display: block;
	}

	.sc-spotlight__figure figcaption {
		font-family: 'Rubik', sans-serif;
		font-size: 0.76rem;
		color: rgba(255, 253, 248, 0.65);
		margin-top: 0.5rem;
		text-align: center;
	}

	.sc-spotlight__content {
		flex: 1;
		min-width: 0;
	}

	.sc-spotlight {
		padding: 3rem 0;
		background: linear-gradient(135deg, #342c68 0%, #453881 55%, #1a1640 100%);
		color: #fffdf8;
	}


	.sc-spotlight__eyebrow {
		font-family: 'Rubik', sans-serif;
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgba(255, 253, 248, 0.75);
		margin: 0 0 0.6rem;
	}

	.sc-spotlight__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.4rem, 2.4vw, 1.9rem);
		font-weight: 500;
		color: #fff;
		margin: 0 0 0.75rem;
	}

	.sc-spotlight__body {
		font-family: 'Rubik', sans-serif;
		font-size: 0.88rem;
		line-height: 1.55;
		margin: 0 0 1rem;
		color: rgba(255, 253, 248, 0.9);
	}

	.sc-spotlight__source {
		font-family: 'Rubik', sans-serif;
		font-size: 0.82rem;
		color: rgba(255, 253, 248, 0.72);
		margin: 0;
	}

	@media (max-width: 899px) {
		.sc-spotlight__inner {
			flex-direction: column;
			align-items: flex-start;
		}

		.sc-spotlight__figure {
			flex: none;
			width: 100%;
			max-width: 22rem;
			margin: 0 auto 1.5rem;
		}

		.sc-spotlight__title {
			font-size: clamp(1.6rem, 4.5vw, 2.2rem);
		}

		.sc-spotlight__body {
			font-size: var(--body-font-size);
			line-height: var(--body-line-height);
		}
	}

	.sc-spotlight__source a {
		color: rgb(240, 93, 87);
	}

	.sc-interns {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	@media (max-width: 1199px) {
		.sc-interns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 699px) {
		.sc-interns {
			grid-template-columns: 1fr;
		}
	}

	.sc-intern-card {
		background: #fff;
		border: 1px solid rgb(229, 229, 229);
		border-radius: 18px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.sc-intern-card__quote {
		margin: 0;
	}

	.sc-intern-card__quote p {
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin: 0;
	}

	.sc-intern-card__meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.sc-intern-card__name {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.05rem;
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(23, 23, 23);
	}

	.sc-intern-card__role {
		font-family: 'Rubik', sans-serif;
		font-size: 0.72rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.035em;
		color: var(--accent-dark);
	}

	.sc-buildlog {
		padding: 3rem 0;
	}


	.sc-buildlog__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.4rem, 2.6vw, 1.85rem);
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0 0 0.75rem;
	}

	.sc-buildlog__body {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin: 0 0 1.25rem;
	}

	.sc-buildlog__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 42px;
		padding: 0 1.2rem;
		border-radius: 999px;
		background: var(--accent-dark);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
	}

	.sc-buildlog__cta:hover {
		background: rgb(154, 44, 39);
	}

	/* ── Blog Carousel ── */
	.sc-carousel__track-wrapper {
		overflow: hidden;
		mask-image: linear-gradient(
			to right,
			transparent 0%,
			#000 3%,
			#000 97%,
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent 0%,
			#000 3%,
			#000 97%,
			transparent 100%
		);
	}

	.sc-carousel__track {
		display: flex;
		align-items: stretch;
		gap: 1.25rem;
