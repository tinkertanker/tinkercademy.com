---
/**
 * /showcase — Astro-native rebuild: student + intern spotlights.
 */
import CtaBanner from '../components/CtaBanner.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getStaticPage } from '../lib/data.js';
import { localiseFramerImage } from '../lib/media.js';

const page = getStaticPage('/showcase');
if (!page) return Astro.redirect('/404');

const canonical = 'https://tinkercademy.com/showcase/';

const heroImage = localiseFramerImage(page.hero_image ?? '');
const heroTitle =
	page.hero_title ?? 'Apps, bots, circuits\nand the makers behind them.';

type Block = { tag?: string; text?: string };
const blocks: Block[] = (page.blocks ?? []) as Block[];
const heroLead =
	blocks.find((b) => b.tag === 'h4' && (b.text ?? '').includes('bright minds'))?.text ??
	"Meet the bright minds who've learned, built, and grown with us, from classroom projects to professional success.";

const heroTitleHtml = heroTitle
	.replace(
		/\b(makers)\b/gi,
		(_match: string, word: string) => `<span class="sc-hero__accent">${word}</span>`,
	)
	.replace(/\n/g, '<br />');

const buildLogUrl = 'https://blog.tinkercademy.com/';

const jiaChenImage = '/images/yYM9MCFxtou9IT7a8ENaXgPmUY.png';

const internTestimonials = [
	{
		name: 'Raynold',
		role: 'Software Development Intern, 2017',
		quote:
			'This internship was so much than just a programming task. As the project owner, I went through all stages of product development. From the idea generation, discussion with end users, development, live demonstrations to troubleshooting and maintenance.',
	},
	{
		name: 'Colin',
		role: 'Machine Learning & Data Science Intern, 2017',
		quote:
			'Being at Tinkertanker gave me the drive and motivation to push through the courses on a very tight schedule, thanks to the mentors who were there to provide not just answers, but the right questions and resources to find out myself.',
	},
	{
		name: 'Joelle',
		role: 'Computer Engineering Intern, 2017',
		quote:
			'I am really happy to have worked on several projects that were put to life. It was a little nerve-wrecking and mind boggling but I\'m glad everything turned out okay. Through this experience, I have learnt how to appreciate and enjoy the building process apart from looking at the end product.',
	},
	{
		name: 'Mark',
		role: 'Teaching & Curriculum Design Intern, 2023',
		quote:
			'Due to the nature of Tinkertanker as a tech education company, it has a wealth of resources you can make use of to expand your technical knowledge. It\'s a different experience from the traditional software engineering job, and I appreciate its role in broadening my horizons.',
	},
	{
		name: 'Enric',
		role: 'Computer Science Intern, 2023',
		quote:
			'All in all, interning at Tinkertanker was a very enriching experience. I was able to take part in the teaching of classes and even try out many different coding languages and programs such as VMs. And all of these have helped me improve and grow as a Computer Science undergraduate.',
	},
	{
		name: 'Yun Xuan',
		role: 'Software Development Intern, 2024',
		quote:
			'Overall, all these experiences have made my internship a thoroughly enjoyable and educational experience. I believe it provided me with a diverse set of skills and insights that I will carry forward in my professional journey. I am very grateful to everyone who helped make this enriching experience possible.',
	},
];

const jiaChenQuote =
	'Meet Jia Chen, a young visionary from Singapore whose journey into the world of technology began with childhood exploration and the transformative power of mobile apps. Inspired by the seamless fusion of science and technology, Jia Chen embarked on a swift learning curve, mastering the Swift programming language and unveiling his debut iOS app on the App Store at a remarkably young age. An Information Technology diploma graduate from Ngee Ann Polytechnic, Jia Chen\'s creative process is seamlessly integrated into the Apple ecosystem, from sketching app designs on iPad to bringing them to life with Xcode on Mac. With six apps already gracing the App Store and two Swift Student Challenge triumphs under his belt, Jia Chen epitomises the next generation of creators and innovators.';

const blogArticles = [
	{
		title: 'Reframing my thoughts on website builders',
		link: 'https://blog.tinkercademy.com/reframing-my-thoughts-on-website-builders-ae71c2d219f9',
		author: 'nyx',
		featureImage: 'https://cdn-images-1.medium.com/max/1200/0*qd606i1y4J6v3R9D',
	},
	{
		title: 'Now That AI Can Generate Code, Should the Everyday Student Stop Learning How to Code?',
		link: 'https://blog.tinkercademy.com/now-that-ai-can-generate-code-should-the-everyday-student-stop-learning-how-to-code-d1ee2226c282',
		author: 'Tinkercademy',
		featureImage: 'https://cdn-images-1.medium.com/max/1200/0*5BMvVkb1hJOSizXw',
	},
	{
		title: 'Orange v/s PyCaret v/s Scikit: A Comparison of Beginner Machine Learning Libraries',
		link: 'https://blog.tinkercademy.com/orange-v-s-pycaret-v-s-scikit-a-comparison-of-beginner-machine-learning-libraries-2d79c0e43e3f',
		author: 'ng mh',
		featureImage: 'https://cdn-images-1.medium.com/max/1200/1*pMYyu_JLQQnpVI_Q6gIUkw.jpeg',
	},
	{
		title: 'What is it like to build games on Unity?',
		link: 'https://blog.tinkercademy.com/what-is-it-like-to-build-games-on-unity-13f41ea742ca',
		author: 'Tinkercademy',
		featureImage: 'https://cdn-images-1.medium.com/max/1200/1*Wl6wISZQxZdf8xiCbt-kMQ.gif',
	},
	{
		title: 'What We Learnt from our Latest Sew & Code Camp',
		link: 'https://blog.tinkercademy.com/what-we-learnt-from-our-latest-sew-code-camp-766d691d0db4',
		author: 'Tinkercademy',
		featureImage: 'https://cdn-images-1.medium.com/max/1200/0*_2u39aRT3kmpu5kR',
	},
	{
		title: 'Having fun with Automata and LittleBits!',
		link: 'https://blog.tinkercademy.com/having-fun-with-automata-and-littlebits-511b955fcf81',
		author: 'Toh yixue',
		featureImage: 'https://cdn-images-1.medium.com/max/1200/1*z7f7tj5e-7iIDtJYCS_oVw.jpeg',
	},
	{
		title: 'Using Python and Pandas to generate useful reports out of CSV files, part 2',
		link: 'https://blog.tinkercademy.com/using-python-and-pandas-to-generate-useful-reports-out-of-csv-files-part-2-6237608a433',
		author: 'Ong Yi Shen',
		featureImage: 'https://cdn-images-1.medium.com/max/1200/1*u1uv_VXeIXWsOSgJWCtjvg.png',
	},
	{
		title: 'Using Python and Pandas to generate useful reports out of CSV files, part 1',
		link: 'https://blog.tinkercademy.com/using-python-and-pandas-to-generate-useful-reports-out-of-csv-files-part-1-2582307b4382',
		author: 'Ong Yi Shen',
		featureImage: 'https://cdn-images-1.medium.com/max/1200/1*u1uv_VXeIXWsOSgJWCtjvg.png',
	},
	{
		title: 'Tinkertanker Internship: Bowling at Tinkertanker',
		link: 'https://blog.tinkercademy.com/tinkertanker-internship-bowling-at-tinkertanker-5c133e7a6403',
		author: 'Mark',
		featureImage: 'https://cdn-images-1.medium.com/max/1200/1*1qdioAOezsUKilmBjtguYA.png',
	},
	{
		title: 'Internship Reflection: A dive into many new things',
		link: 'https://blog.tinkercademy.com/internship-reflection-a-dive-into-many-new-things-7f24aadb1d1c',
		author: 'Enric Tan',
		featureImage: 'https://cdn-images-1.medium.com/max/1200/1*c7SM8Fz91vO4JAIvj-oIYg.png',
	},
];
---

<ContentLayout
	title="Showcase — Tinkercademy"
	description="Meet the coders, tinkerers, and makers who've learned, built, and grown with Tinkercademy — from classroom projects to professional success."
	canonical={canonical}
	image={heroImage}
>
	<section class="sc-hero">
		{heroImage && (
			<img class="sc-hero__bg" src={heroImage} alt="" loading="eager" fetchpriority="high" />
		)}
		<div class="sc-hero__scrim"></div>
		<div class="sc-hero__content shell">
			<h1 class="sc-hero__title" set:html={heroTitleHtml} />
			<p class="sc-hero__lead">{heroLead}</p>
			<div class="sc-hero__actions">
				<a class="sc-hero__cta" href={buildLogUrl} target="_blank" rel="noopener">Build Log</a>
			</div>
		</div>
	</section>

	<section class="sc-section">
		<div class="shell">
			<h2 class="sc-section__heading">Our Projects</h2>
			<p class="sc-section__lead">
				We've built some pretty amazing things, together with our learners. Read more at
				<a href="https://blog.tinkercademy.com" target="_blank" rel="noopener">our blog</a>.
			</p>
			<div class="sc-carousel__track-wrapper">
			<div class="sc-carousel__track">
				{blogArticles.map((article) => (
					<a
						href={article.link}
						target="_blank"
						rel="noopener"
						class="sc-carousel__card"
					>
						<img
							class="sc-carousel__img"
							src={article.featureImage}
							alt=""
							loading="lazy"
						/>
						<div class="sc-carousel__scrim"></div>
						<span class="sc-carousel__author">{article.author}</span>
						<span class="sc-carousel__title">{article.title}</span>
					</a>
				))}
				{blogArticles.map((article) => (
					<a
						href={article.link}
						target="_blank"
						rel="noopener"
						class="sc-carousel__card"
						aria-hidden="true"
						tabindex="-1"
					>
						<img
							class="sc-carousel__img"
							src={article.featureImage}
							alt=""
							loading="lazy"
						/>
						<div class="sc-carousel__scrim"></div>
						<span class="sc-carousel__author">{article.author}</span>
						<span class="sc-carousel__title">{article.title}</span>
					</a>
				))}
			</div>
		</div>
		</div>
	</section>

	<section class="sc-section sc-section--muted">
		<div class="shell">
			<h2 class="sc-section__heading">Our Interns</h2>
			<p class="sc-section__lead">
				Through hands-on experience and mentorship, our interns work on real projects that shape
				the future of education and technology. Here are what they have to say about their
				experiences!
			</p>

			<div class="sc-interns">
				{internTestimonials.map((intern) => (
					<article class="sc-intern-card">
						<blockquote class="sc-intern-card__quote">
							<p>“{intern.quote}”</p>
						</blockquote>
						<footer class="sc-intern-card__meta">
							<span class="sc-intern-card__name">{intern.name}</span>
							<span class="sc-intern-card__role">{intern.role}</span>
						</footer>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="sc-spotlight">
		<div class="shell sc-spotlight__inner">
			<figure class="sc-spotlight__figure">
				<img src={jiaChenImage} alt="Jia Chen" loading="lazy" />
				<figcaption>Image from apple.com</figcaption>
			</figure>
			<p class="sc-spotlight__eyebrow">Swift Accelerator Programme Trainer at Tinkertanker</p>
			<h2 class="sc-spotlight__title">Meet Jia Chen</h2>
			<p class="sc-spotlight__body">{jiaChenQuote}</p>
			<p class="sc-spotlight__source">
				As featured on Apple:
				<a
					href="https://www.apple.com/education/college-students/success-stories/yee/"
					target="_blank"
					rel="noopener"
				>apple.com</a>
			</p>
		</div>
	</section>

	<section class="sc-buildlog">
		<div class="shell sc-buildlog__inner">
			<h2 class="sc-buildlog__heading">Learn more about what our alumni have done!</h2>
			<p class="sc-buildlog__body">
				We're building software, electronics, curriculum — and the next generation of coders,
				makers, and creators. Come check out our build log and contribute to it one day!
			</p>
			<a class="sc-buildlog__cta" href={buildLogUrl} target="_blank" rel="noopener">
				Build Log
			</a>
		</div>
	</section>

	<CtaBanner />
</ContentLayout>

<style>
	.sc-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: clamp(440px, 58vh, 620px);
		overflow: clip;
		background: #0a0a0a;
	}

	.sc-hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.sc-hero__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.35) 0%,
			rgba(0, 0, 0, 0.15) 40%,
			rgba(0, 0, 0, 0.7) 100%
		);
	}

	.sc-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: inherit;
		padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 5vw, 4rem);
		gap: 1.1rem;
	}

	.sc-hero__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		font-size: clamp(2.4rem, 6vw, 4.5rem);
		font-weight: 500;
		line-height: 1;
		color: #fff;
		margin: 0;
		text-wrap: balance;
	}

	.sc-hero__accent {
		color: rgb(240, 93, 87);
	}

	.sc-hero__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.92);
		margin: 0;
		max-width: 48ch;
	}

	.sc-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.sc-hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		padding: 0.65rem 1.15rem;
		border-radius: 999px;
		background: var(--accent-dark);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.sc-hero__cta,
	.sc-hero__cta:visited,
	.sc-hero__cta:hover,
	.sc-hero__cta:active {
		color: #fff;
		text-decoration: none;
	}

	.sc-hero__cta:hover {
		background: rgb(154, 44, 39);
		transform: translateY(-1px);
	}

	.sc-section {
		padding: 3rem 0;
	}

	.sc-section--muted {
		background: #fafafa;
	}

	.sc-section__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(23, 23, 23);
		margin: 0 0 0.75rem;
	}

	.sc-section__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: rgb(110, 110, 110);
		margin: 0 0 2rem;
		max-width: 60rem;
	}

	.sc-spotlight__figure {
		margin: 0 0 1.5rem;
		max-width: 32rem;
	}

	.sc-spotlight__figure img {
		width: 100%;
		height: auto;
		border-radius: 14px;
		display: block;
	}

	.sc-spotlight__figure figcaption {
		font-family: 'Rubik', sans-serif;
		font-size: 0.82rem;
		color: rgba(255, 253, 248, 0.65);
		margin-top: 0.5rem;
		text-align: center;
	}

	.sc-spotlight {
		padding: 3rem 0;
		background: linear-gradient(135deg, #342c68 0%, #453881 55%, #1a1640 100%);
		color: #fffdf8;
	}


	.sc-spotlight__eyebrow {
		font-family: 'Rubik', sans-serif;
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgba(255, 253, 248, 0.75);
		margin: 0 0 0.75rem;
	}

	.sc-spotlight__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		font-size: clamp(1.8rem, 3.6vw, 2.6rem);
		font-weight: 500;
		text-transform: uppercase;
		color: #fff;
		margin: 0 0 1rem;
	}

	.sc-spotlight__body {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		margin: 0 0 1.25rem;
		color: rgba(255, 253, 248, 0.9);
	}

	.sc-spotlight__source {
		font-family: 'Rubik', sans-serif;
		font-size: 0.9rem;
		color: rgba(255, 253, 248, 0.72);
		margin: 0;
	}

	.sc-spotlight__source a {
		color: rgb(240, 93, 87);
	}

	.sc-interns {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	@media (max-width: 1199px) {
		.sc-interns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 699px) {
		.sc-interns {
			grid-template-columns: 1fr;
		}
	}

	.sc-intern-card {
		background: #fff;
		border: 1px solid rgb(229, 229, 229);
		border-radius: 18px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.sc-intern-card__quote {
		margin: 0;
	}

	.sc-intern-card__quote p {
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin: 0;
	}

	.sc-intern-card__meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.sc-intern-card__name {
		font-family: 'IBM Plex Serif', Georgia, serif;
		font-size: 1.05rem;
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(23, 23, 23);
	}

	.sc-intern-card__role {
		font-family: 'Rubik', sans-serif;
		font-size: 0.72rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.035em;
		color: var(--accent-dark);
	}

	.sc-buildlog {
		padding: 3rem 0;
	}


	.sc-buildlog__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		font-size: clamp(1.4rem, 2.6vw, 1.85rem);
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(23, 23, 23);
		margin: 0 0 0.75rem;
	}

	.sc-buildlog__body {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin: 0 0 1.25rem;
	}

	.sc-buildlog__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 42px;
		padding: 0 1.2rem;
		border-radius: 999px;
		background: var(--accent-dark);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
	}

	.sc-buildlog__cta:hover {
		background: rgb(154, 44, 39);
	}

	/* ── Blog Carousel ── */
	.sc-carousel__track-wrapper {
		overflow: hidden;
		mask-image: linear-gradient(
			to right,
			transparent 0%,
			#000 3%,
			#000 97%,
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent 0%,
			#000 3%,
			#000 97%,
			transparent 100%
		);
	}

	.sc-carousel__track {
		display: flex;
		gap: 1rem;
		width: max-content;
		animation: sc-carousel-scroll 75s linear infinite;
		padding: 0 calc(3% + 1rem);
	}

	.sc-carousel__track-wrapper:hover .sc-carousel__track {
		animation-play-state: paused;
	}

	@keyframes sc-carousel-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.sc-carousel__card {
		flex-shrink: 0;
		width: 340px;
		aspect-ratio: 4 / 3;
		border-radius: 14px;
		overflow: hidden;
		position: relative;
		text-decoration: none;
		background: rgb(245, 245, 245);
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
	}

	.sc-carousel__card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
	}

	.sc-carousel__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.sc-carousel__card:hover .sc-carousel__img {
		transform: scale(1.06);
	}

	.sc-carousel__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.05) 0%,
			rgba(0, 0, 0, 0) 45%,
			rgba(0, 0, 0, 0.55) 100%
		);
		pointer-events: none;
	}

	.sc-carousel__author {
		position: absolute;
		top: 0.75rem;
		left: 0.85rem;
		font-family: 'Rubik', sans-serif;
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.035em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.9);
		background: rgba(0, 0, 0, 0.45);
		padding: 0.25rem 0.6rem;
		border-radius: 6px;
		opacity: 0;
		transform: translateY(-6px);
		transition: opacity 0.3s ease, transform 0.3s ease;
		pointer-events: none;
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.sc-carousel__card:hover .sc-carousel__author {
		opacity: 1;
		transform: translateY(0);
	}

	.sc-carousel__title {
		position: absolute;
		bottom: 0;
		right: 0;
		max-width: 78%;
		font-family: 'Rubik', sans-serif;
		font-size: 0.82rem;
