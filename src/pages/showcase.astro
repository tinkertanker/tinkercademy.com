---
/**
 * /showcase — Astro-native rebuild: student + intern spotlights.
 */
import CtaBanner from '../components/CtaBanner.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { blogHref, blogStoryPath, formatBlogDate, getBlogStories } from '../lib/blog';
import { getStaticPage } from '../lib/data.js';
import { localiseFramerImage } from '../lib/media.js';
import { openSourceTools } from '../lib/open-source';

const page = getStaticPage('/showcase');
if (!page) return Astro.redirect('/404');

const canonical = 'https://tinkercademy.com/showcase/';

const heroImage = localiseFramerImage(page.hero_image ?? '');
const heroTitle =
	page.hero_title ?? 'Apps, bots, circuits\nand the makers behind them.';

type Block = { tag?: string; text?: string };
const blocks: Block[] = (page.blocks ?? []) as Block[];
const heroLead =
	blocks.find((b) => b.tag === 'h4' && (b.text ?? '').includes('bright minds'))?.text ??
	"Meet the bright minds who've learned, built, and grown with us, from classroom projects to professional success.";

const heroTitleHtml = heroTitle
	.replace(
		/\b(makers)\b/gi,
		(_match: string, word: string) => `<span class="sc-hero__accent">${word}</span>`,
	)
	.replace(/\n/g, '<br />');

const buildLogUrl = '/blog/';

const jiaChenImage = '/images/yYM9MCFxtou9IT7a8ENaXgPmUY.png';

const internTestimonials = [
	{
		name: 'Raynold',
		role: 'Software Development Intern, 2017',
		quote:
			'This internship was so much than just a programming task. As the project owner, I went through all stages of product development. From the idea generation, discussion with end users, development, live demonstrations to troubleshooting and maintenance.',
	},
	{
		name: 'Colin',
		role: 'Machine Learning & Data Science Intern, 2017',
		quote:
			'Being at Tinkertanker gave me the drive and motivation to push through the courses on a very tight schedule, thanks to the mentors who were there to provide not just answers, but the right questions and resources to find out myself.',
	},
	{
		name: 'Joelle',
		role: 'Computer Engineering Intern, 2017',
		quote:
			'I am really happy to have worked on several projects that were put to life. It was a little nerve-wrecking and mind boggling but I\'m glad everything turned out okay. Through this experience, I have learnt how to appreciate and enjoy the building process apart from looking at the end product.',
	},
	{
		name: 'Mark',
		role: 'Teaching & Curriculum Design Intern, 2023',
		quote:
			'Due to the nature of Tinkertanker as a tech education company, it has a wealth of resources you can make use of to expand your technical knowledge. It\'s a different experience from the traditional software engineering job, and I appreciate its role in broadening my horizons.',
	},
	{
		name: 'Enric',
		role: 'Computer Science Intern, 2023',
		quote:
			'All in all, interning at Tinkertanker was a very enriching experience. I was able to take part in the teaching of classes and even try out many different coding languages and programs such as VMs. And all of these have helped me improve and grow as a Computer Science undergraduate.',
	},
	{
		name: 'Yun Xuan',
		role: 'Software Development Intern, 2024',
		quote:
			'Overall, all these experiences have made my internship a thoroughly enjoyable and educational experience. I believe it provided me with a diverse set of skills and insights that I will carry forward in my professional journey. I am very grateful to everyone who helped make this enriching experience possible.',
	},
];

const jiaChenQuote =
	'Meet Jia Chen, a young visionary from Singapore whose journey into the world of technology began with childhood exploration and the transformative power of mobile apps. Inspired by the seamless fusion of science and technology, Jia Chen embarked on a swift learning curve, mastering the Swift programming language and unveiling his debut iOS app on the App Store at a remarkably young age. An Information Technology diploma graduate from Ngee Ann Polytechnic, Jia Chen\'s creative process is seamlessly integrated into the Apple ecosystem, from sketching app designs on iPad to bringing them to life with Xcode on Mac. With six apps already gracing the App Store and two Swift Student Challenge triumphs under his belt, Jia Chen epitomises the next generation of creators and innovators.';

const blogArticles = (await getBlogStories()).slice(0, 10).map((story) => {
	const excerpt = [story.data.subtitle, story.data.description]
		.find((value) => value && value.trim() !== story.data.title.trim());
	return {
		title: story.data.title,
		link: blogHref(blogStoryPath(story)),
		author: story.data.author.name,
		date: formatBlogDate(story.data.publishedAt, story.data.publishedAtPrecision),
		excerpt,
		featureImage: story.data.heroImage,
	};
});

const featuredOpenSourceTools = openSourceTools.slice(0, 4);
---

<ContentLayout
	title="Showcase — Tinkercademy"
	description="Meet the coders, tinkerers, and makers who've learned, built, and grown with Tinkercademy — from classroom projects to professional success."
	canonical={canonical}
	image={heroImage}
>
	<section class="sc-hero">
		{heroImage && (
			<img class="sc-hero__bg" src={heroImage} alt="" loading="eager" fetchpriority="high" />
		)}
		<div class="sc-hero__scrim"></div>
		<div class="sc-hero__content shell">
			<h1 class="sc-hero__title" set:html={heroTitleHtml} />
			<p class="sc-hero__lead">{heroLead}</p>
			<div class="sc-hero__actions">
				<a class="sc-hero__cta" href={buildLogUrl}>Build Log</a>
			</div>
		</div>
	</section>

	<section class="sc-section">
		<div class="shell">
			<h2 class="sc-section__heading">Latest from the Build Log</h2>
			<p class="sc-section__lead">
				What we're building, what we're learning, and the people doing both.
				<a href={buildLogUrl}>Read all stories</a>.
			</p>
			<div class="sc-carousel__track-wrapper">
			<div class="sc-carousel__track">
				{[...blogArticles, ...blogArticles].map((article, i) => (
					<a
						href={article.link}
						class="sc-carousel__card"
						aria-hidden={i >= blogArticles.length ? 'true' : undefined}
						tabindex={i >= blogArticles.length ? -1 : undefined}
					>
						<div class="sc-carousel__media">
							{article.featureImage && (
								<img
									class="sc-carousel__img"
									src={article.featureImage}
									alt=""
									loading="lazy"
								/>
							)}
						</div>
						<div class="sc-carousel__body">
							<p class="sc-carousel__title">{article.title}</p>
							{article.excerpt && <p class="sc-carousel__excerpt">{article.excerpt}</p>}
							<div class="sc-carousel__meta">
								<span class="sc-carousel__byline">
									{article.author} · {article.date}
								</span>
								<span class="sc-carousel__readmore">Read story →</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
		</div>
	</section>

	<section class="sc-section sc-section--muted">
		<div class="shell">
			<h2 class="sc-section__heading">Open source, built by us</h2>
			<p class="sc-section__lead">
				Small, practical tools we built for real work, then shared for anyone to use.
				<a href="/open-source/">Explore every project</a>.
			</p>
			<div class="sc-projects">
				{featuredOpenSourceTools.map((tool) => (
					<article class="sc-project-card">
						<div class="sc-project-card__media">
							{tool.image && <img src={tool.image} alt="" loading="lazy" />}
						</div>
						<div class="sc-project-card__body">
							<h3 class="sc-project-card__name">
								<a href={tool.primaryHref} target="_blank" rel="noopener">{tool.name}</a>
							</h3>
							<p class="sc-project-card__tagline">{tool.tagline}</p>
							<ul class="sc-project-card__tags" aria-label={`${tool.name} details`}>
								<li class="sc-project-card__tag sc-project-card__tag--platform">{tool.platform}</li>
								<li class="sc-project-card__tag">{tool.builtWith}</li>
								<li class="sc-project-card__tag">{tool.access}</li>
							</ul>
						</div>
						<footer class="sc-project-card__footer">
							<a href={tool.primaryHref} target="_blank" rel="noopener">
								{tool.primaryLabel} ↗
							</a>
						</footer>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="sc-section">
		<div class="shell">
			<h2 class="sc-section__heading">Our Interns</h2>
			<p class="sc-section__lead">
				Through hands-on experience and mentorship, our interns work on real projects that shape
				the future of education and technology. Here are what they have to say about their
				experiences!
			</p>

			<div class="sc-interns">
				{internTestimonials.map((intern) => (
					<article class="sc-intern-card">
						<blockquote class="sc-intern-card__quote">
							<p>“{intern.quote}”</p>
						</blockquote>
						<footer class="sc-intern-card__meta">
							<span class="sc-intern-card__name">{intern.name}</span>
							<span class="sc-intern-card__role">{intern.role}</span>
						</footer>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="sc-spotlight">
		<div class="shell sc-spotlight__inner">
			<figure class="sc-spotlight__figure">
				<img src={jiaChenImage} alt="Jia Chen" />
				<figcaption>Image from apple.com</figcaption>
			</figure>
			<div class="sc-spotlight__content">
				<p class="sc-spotlight__eyebrow">Swift Accelerator Programme Trainer at Tinkertanker</p>
				<h2 class="sc-spotlight__title">Meet Jia Chen</h2>
				<p class="sc-spotlight__body">{jiaChenQuote}</p>
				<p class="sc-spotlight__source">
					As featured on Apple:
					<a
						href="https://www.apple.com/education/college-students/success-stories/yee/"
						target="_blank"
						rel="noopener"
					>apple.com</a>
				</p>
			</div>
		</div>
	</section>

	<CtaBanner />
</ContentLayout>

<style>
	.sc-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: clamp(440px, 58vh, 620px);
		overflow: clip;
		background: #0a0a0a;
	}

	.sc-hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.sc-hero__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.35) 0%,
			rgba(0, 0, 0, 0.15) 40%,
			rgba(0, 0, 0, 0.7) 100%
		);
	}

	.sc-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: inherit;
		padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 5vw, 4rem);
		gap: 1.1rem;
	}

	.sc-hero__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 1;
		color: #fff;
		margin: 0;
		text-wrap: balance;
	}

	.sc-hero__accent {
		color: rgb(240, 93, 87);
	}

	.sc-hero__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.92);
		margin: 0;
		max-width: 48ch;
	}

	.sc-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.sc-hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		padding: 0.65rem 1.15rem;
		border-radius: 999px;
		background: var(--accent-dark);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.sc-hero__cta,
	.sc-hero__cta:visited,
	.sc-hero__cta:hover,
	.sc-hero__cta:active {
		color: #fff;
		text-decoration: none;
	}

	.sc-hero__cta:hover {
		background: rgb(154, 44, 39);
		transform: translateY(-1px);
	}

	.sc-section {
		padding: 3rem 0;
	}

	.sc-section--muted {
		background: #fafafa;
	}

	.sc-section__heading {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0 0 0.75rem;
	}

	.sc-section__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: rgb(110, 110, 110);
		margin: 0 0 2rem;
		max-width: 60rem;
	}

	.sc-section__lead a {
		color: var(--accent-dark);
		font-weight: 500;
		text-underline-offset: 3px;
	}

	.sc-projects {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.sc-project-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid rgb(229, 229, 229);
		border-radius: 14px;
		background: #fff;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	.sc-project-card:hover {
		transform: translateY(-4px);
		border-color: rgb(240, 93, 87);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
	}

	.sc-project-card__media {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-bottom: 1px solid rgb(235, 235, 235);
		background: rgb(245, 245, 245);
	}

	.sc-project-card__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.sc-project-card:hover .sc-project-card__media img {
		transform: scale(1.04);
	}

	.sc-project-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.1rem 1.1rem 0.75rem;
	}

	.sc-project-card__name {
		margin: 0;
		font-family: 'IBM Plex Serif', Georgia, serif;
		font-size: 1.22rem;
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.025em;
	}

	.sc-project-card__name a {
		color: rgb(23, 23, 23);
		text-decoration: none;
	}

	.sc-project-card__tagline {
		margin: 0;
		font-family: 'Rubik', sans-serif;
		font-size: 0.85rem;
		line-height: 1.45;
		color: rgb(90, 90, 90);
	}

	.sc-project-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: auto 0 0;
		padding: 0.7rem 0 0;
		list-style: none;
	}

	.sc-project-card__tag {
		padding: 0.25rem 0.5rem;
		border-radius: 6px;
		background: #f3f3f3;
		color: rgb(95, 95, 95);
		font-family: 'Rubik', sans-serif;
		font-size: 0.66rem;
	}

	.sc-project-card__tag--platform {
		background: rgba(240, 93, 87, 0.1);
		color: var(--accent-dark);
	}

	.sc-project-card__footer {
		padding: 0 1.1rem 1.1rem;
	}

	.sc-project-card__footer a {
		color: var(--accent-dark);
		font-family: 'Rubik', sans-serif;
		font-size: 0.8rem;
		font-weight: 500;
		text-decoration: none;
	}

	.sc-project-card__footer a:hover,
	.sc-project-card__name a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 999px) {
		.sc-projects {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 599px) {
		.sc-projects {
			grid-template-columns: 1fr;
		}
	}

	.sc-spotlight__inner {
		display: flex;
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3rem);
	}

	.sc-spotlight__figure {
		margin: 0;
		flex: 0 0 clamp(260px, 36vw, 420px);
		width: clamp(260px, 36vw, 420px);
	}

	.sc-spotlight__figure img {
		width: 100%;
		height: auto;
		border-radius: 14px;
		display: block;
	}

	.sc-spotlight__figure figcaption {
		font-family: 'Rubik', sans-serif;
		font-size: 0.76rem;
		color: rgba(255, 253, 248, 0.65);
		margin-top: 0.5rem;
		text-align: center;
	}

	.sc-spotlight__content {
		flex: 1;
		min-width: 0;
	}

	.sc-spotlight {
		padding: 3rem 0;
		background: linear-gradient(135deg, #342c68 0%, #453881 55%, #1a1640 100%);
		color: #fffdf8;
	}


	.sc-spotlight__eyebrow {
		font-family: 'Rubik', sans-serif;
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgba(255, 253, 248, 0.75);
		margin: 0 0 0.6rem;
	}

	.sc-spotlight__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.4rem, 2.4vw, 1.9rem);
		font-weight: 500;
		color: #fff;
		margin: 0 0 0.75rem;
	}

	.sc-spotlight__body {
		font-family: 'Rubik', sans-serif;
		font-size: 0.88rem;
		line-height: 1.55;
		margin: 0 0 1rem;
		color: rgba(255, 253, 248, 0.9);
	}

	.sc-spotlight__source {
		font-family: 'Rubik', sans-serif;
		font-size: 0.82rem;
		color: rgba(255, 253, 248, 0.72);
		margin: 0;
	}

	@media (max-width: 899px) {
		.sc-spotlight__inner {
			flex-direction: column;
			align-items: flex-start;
		}

		.sc-spotlight__figure {
			flex: none;
			width: 100%;
			max-width: 22rem;
			margin: 0 auto 1.5rem;
		}

		.sc-spotlight__title {
			font-size: clamp(1.6rem, 4.5vw, 2.2rem);
		}

		.sc-spotlight__body {
			font-size: var(--body-font-size);
			line-height: var(--body-line-height);
		}
	}

	.sc-spotlight__source a {
		color: rgb(240, 93, 87);
	}

	.sc-interns {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	@media (max-width: 1199px) {
		.sc-interns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 699px) {
		.sc-interns {
			grid-template-columns: 1fr;
		}
	}

	.sc-intern-card {
		background: #fff;
		border: 1px solid rgb(229, 229, 229);
		border-radius: 18px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.sc-intern-card__quote {
		margin: 0;
	}

	.sc-intern-card__quote p {
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin: 0;
	}

	.sc-intern-card__meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.sc-intern-card__name {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.05rem;
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(23, 23, 23);
	}

	.sc-intern-card__role {
		font-family: 'Rubik', sans-serif;
		font-size: 0.72rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.035em;
		color: var(--accent-dark);
	}

	/* ── Blog Carousel ── */
	.sc-carousel__track-wrapper {
		overflow: hidden;
		mask-image: linear-gradient(
			to right,
			transparent 0%,
			#000 3%,
			#000 97%,
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent 0%,
			#000 3%,
			#000 97%,
			transparent 100%
		);
	}

	.sc-carousel__track {
		display: flex;
		align-items: stretch;
		gap: 1.25rem;
		width: max-content;
		animation: sc-carousel-scroll 90s linear infinite;
		padding: 0 calc(3% + 1rem);
	}

	.sc-carousel__track-wrapper:hover .sc-carousel__track {
		animation-play-state: paused;
	}

	@keyframes sc-carousel-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.sc-carousel__card {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		width: 320px;
		border-radius: 14px;
		overflow: hidden;
		text-decoration: none;
		background: #fff;
		border: 1px solid rgb(229, 229, 229);
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease,
			border-color 0.35s ease;
	}

	.sc-carousel__card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
		border-color: rgb(240, 93, 87);
	}

	.sc-carousel__media {
		height: 120px;
		overflow: hidden;
		background: rgb(245, 245, 245);
	}

	.sc-carousel__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.sc-carousel__card:hover .sc-carousel__img {
		transform: scale(1.06);
	}

	.sc-carousel__body {
		display: flex;
		flex-direction: column;
