---
import { render } from 'astro:content';
import ContactForm from '../../components/ContactForm.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import ProgrammeSeriesNav from '../../components/ProgrammeSeriesNav.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { createProgrammeFilterHref } from '../../lib/programme-filters.ts';
import { getAllProgrammes, getProgrammeBySlug } from '../../lib/programmes.ts';
import { getResponsiveImage } from '../../lib/responsive-images.js';
import { clipDescription } from '../../lib/seo.ts';

export async function getStaticPaths() {
	const programmes = await getAllProgrammes();

	return programmes.map((programme) => ({
		params: { slug: programme.slug },
	}));
}

const programme = await getProgrammeBySlug(Astro.params.slug ?? '');
if (!programme) return Astro.redirect('/404');

const { Content } = await render(programme.entry);
const canonical = new URL(`/programmes/${programme.slug}/`, 'https://tinkercademy.com').toString();

/* ─── Page title ────────────────────────────────────────────────────
   Programme markdown files ship a long `seoTitle` of the form:
     "<Programme name> - Tinkercademy: Coding and Making for …"
   which is longer than Google's SERP cutoff. Normalise to our convention
   (<Programme> — Tinkercademy) and clip long programme names so the full
   string stays under Google's ~60-char title cutoff. */
const TITLE_SUFFIX = ' — Tinkercademy';
const TITLE_MAX_BASE = 60 - TITLE_SUFFIX.length;
const titleBase = programme.title.length > TITLE_MAX_BASE
	? `${programme.title.slice(0, TITLE_MAX_BASE - 1).trimEnd()}…`
	: programme.title;
const pageTitle = `${titleBase}${TITLE_SUFFIX}`;

/* ─── Meta description ──────────────────────────────────────────────
   Authored `seoDescription` wins; otherwise we derive a short summary
   from `cardBlurb`, clipped on the nearest sentence/word boundary below
   160 chars so Google's SERP doesn't truncate mid-word. */
const metaDescription =
	programme.seoDescription ?? clipDescription(programme.cardBlurb);

/* ─── Meta info ──────────────────────────────────────────────────── */
const audiences = programme.audiences ?? [];
const domains = programme.domains ?? [];
const domainLabels = domains.map((domain) => domain.label);
const platforms = programme.platforms ?? [];
const duration = programme.duration ?? '';
const primaryAudience = programme.primaryAudience;
const enquiryLabel = programme.signUpLabel ?? 'Enquire now';
const typeLabel =
	primaryAudience?.id === 'businesses' || primaryAudience?.id === 'public'
		? 'Corporate training'
		: domainLabels[0] ?? primaryAudience?.label ?? '';

/* Structured data: Course + Breadcrumb */
const SITE_BASE = 'https://tinkercademy.com';
const audienceTypeName =
	primaryAudience?.id === 'businesses' || primaryAudience?.id === 'public'
		? 'BusinessAudience'
		: primaryAudience?.id === 'teachers' || primaryAudience?.id === 'students'
			? 'EducationalAudience'
			: undefined;
const courseSchema: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'Course',
	name: programme.title,
	description: metaDescription,
	url: canonical,
	provider: {
		'@type': 'Organization',
		name: 'Tinkercademy',
		sameAs: SITE_BASE,
	},
	inLanguage: 'en',
};
if (programme.heroImage) {
	courseSchema.image = new URL(programme.heroImage, SITE_BASE).toString();
}
if (audienceTypeName && primaryAudience?.label) {
	courseSchema.audience = {
		'@type': audienceTypeName,
		audienceType: primaryAudience.label,
	};
}
if (domainLabels.length > 0) {
	courseSchema.about = domainLabels;
}

const seriesCourses = programme.series
	? (await getAllProgrammes())
			.filter((item) => programme.series?.courses.some((course) => course.slug === item.slug))
			.sort((left, right) => {
				const order = programme.series?.courses.map((course) => course.slug) ?? [];
				return order.indexOf(left.slug) - order.indexOf(right.slug);
			})
			.map((item) => ({
				code: item.series?.code ?? '',
				slug: item.slug,
				title: item.title,
				href: `/programmes/${item.slug}/`,
				current: item.slug === programme.slug,
			}))
	: [];

const heroResponsive = getResponsiveImage(programme.heroImage);
const heroPreload = heroResponsive
	? { src: heroResponsive.src, srcset: heroResponsive.srcset, sizes: '100vw' }
	: null;

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_BASE}/` },
		{ '@type': 'ListItem', position: 2, name: 'All courses', item: `${SITE_BASE}/courses-all/` },
		{ '@type': 'ListItem', position: 3, name: programme.title, item: canonical },
	],
};
---

<ContentLayout
	title={pageTitle}
	description={metaDescription}
	canonical={canonical}
	image={programme.heroImage ?? undefined}
	preloadHero={heroPreload}
>
	{/* ════════ Hero: full-bleed image with dark overlay + text ════════ */}
	<section class="prog-hero">
		{programme.heroImage && (
			<img
				class="prog-hero__bg"
				src={heroResponsive?.src ?? programme.heroImage}
				srcset={heroResponsive?.srcset}
				sizes={heroResponsive?.srcset ? '100vw' : undefined}
				width={heroResponsive?.width}
				height={heroResponsive?.height}
				alt=""
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		)}
		<div class="prog-hero__overlay" />
		<div class="prog-hero__text shell">
			{programme.series && (
				<p class="prog-hero__kicker">
					<span class="prog-hero__kicker-code">{programme.series.code}</span>
					<span class="prog-hero__kicker-sep" aria-hidden="true">·</span>
					<span>{programme.series.label}</span>
				</p>
			)}
			<h1 class="prog-hero__title">{programme.title}</h1>
			{duration && <p class="prog-hero__duration">{duration}</p>}
			<div class="prog-hero__actions">
				<a class="prog-hero__cta" href="#enquire">{enquiryLabel}</a>
				<a
					class="prog-hero__cta prog-hero__cta--secondary"
					href="mailto:hello@tk.sg"
				>
					Email us
				</a>
			</div>
		</div>
	</section>

	{seriesCourses.length > 0 && (
		<section class="prog-series">
			<div class="shell">
				<ProgrammeSeriesNav label={programme.series?.label ?? 'Series'} courses={seriesCourses} />
			</div>
		</section>
	)}

	{/* ════════ Meta bar ═════════════════════════════════════════════ */}
	<section class="prog-meta">
		<div class="shell prog-meta__inner">
			{audiences.length > 0 && (
				<div class="prog-meta__group">
					<span class="prog-meta__label">Audiences:</span>
					<div class="prog-meta__tags">
						{audiences.map((aud) => (
							<a
								class:list={[
									'prog-meta__tag',
									(aud.id === 'businesses' || aud.id === 'public') && 'prog-meta__tag--blue',
								]}
								href={createProgrammeFilterHref({ audience: aud.id })}
							>
								{aud.label}
							</a>
						))}
					</div>
				</div>
			)}
			{duration && (
				<div class="prog-meta__group">
					<span class="prog-meta__label">Duration:</span>
					<span class="prog-meta__value">{duration}</span>
				</div>
			)}
			{typeLabel && (
				<div class="prog-meta__group">
					<span class="prog-meta__label">Type:</span>
					<span class="prog-meta__value">{typeLabel}</span>
				</div>
			)}
		</div>
	</section>

	{/* ════════ Facts + content + enquiry form sidebar ═══════════════ */}
	<div class="prog-main shell">
		<div class="prog-main__body">
			{(domainLabels.length > 0 || platforms.length > 0) && (
				<section class="prog-facts">
					<div class="prog-facts__inner">
						{domainLabels.length > 0 && (
							<div class="prog-facts__group">
								<h2 class="prog-facts__heading">Domains</h2>
								<div class="prog-facts__chips">
									{domains.map((domain) => (
										<a
											class="prog-facts__chip"
											href={createProgrammeFilterHref({ domain: domain.id })}
										>
											{domain.label}
										</a>
									))}
								</div>
							</div>
						)}
						{platforms.length > 0 && (
							<div class="prog-facts__group">
								<h2 class="prog-facts__heading">Platforms</h2>
								<div class="prog-facts__chips">
									{platforms.map((platform) => (
										<a
											class="prog-facts__chip prog-facts__chip--platform"
											href={createProgrammeFilterHref({ platform: platform.id })}
										>
											{platform.icon && (
												<img
													class="prog-facts__icon"
													src={platform.icon}
													alt=""
													loading="lazy"
												/>
											)}
											<span>{platform.label}</span>
										</a>
									))}
								</div>
							</div>
						)}
					</div>
				</section>
			)}

			<article class="prog-body prose">
				<Content />
			</article>
		</div>

		<aside class="prog-aside">
			<ContactForm
				id="enquire"
				heading="Submit Enquiry"
				prefillCourse={programme.title}
			/>
		</aside>
	</div>

	<CtaBanner />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</ContentLayout>

<style>
	/* ─── Hero ──────────────────────────────────────────────── */
	.prog-hero {
		position: relative;
		width: 100%;
		min-height: clamp(340px, 50vh, 480px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
	}

	.prog-hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 30%;
		z-index: 0;
	}

	.prog-hero__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.35) 0%,
			rgba(0, 0, 0, 0.55) 100%
		);
		z-index: 1;
	}

	.prog-hero__text {
		position: relative;
		z-index: 2;
		padding-top: 100px;
		padding-bottom: 48px;
	}

	.prog-hero__kicker {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0 0 0.65rem;
		font-family: 'Rubik', sans-serif;
		font-size: 0.92rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: rgba(255, 255, 255, 0.88);
	}

	.prog-hero__kicker-code {
		font-family: 'Fragment Mono', ui-monospace, monospace;
		letter-spacing: 0.04em;
	}

	.prog-hero__kicker-sep {
		opacity: 0.7;
	}

	.prog-hero__title {
		font-family: 'Lora Ampersand', 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 1.05;
		color: #fff;
		margin: 0;
		max-width: 18ch;
	}

	.prog-hero__duration {
		margin: 0.75rem 0 0;
		font-family: 'Rubik', sans-serif;
		font-size: 1rem;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.88);
	}

	.prog-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1rem;
	}

	.prog-hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.1rem;
		border-radius: 999px;
		/* accent-dark, not accent: white 15px text needs 4.5:1 (WCAG AA) */
		background: var(--accent-dark);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.92rem;
		font-weight: 500;
		box-shadow: 0 12px 28px rgba(240, 93, 87, 0.28);
	}

	.prog-hero__cta--secondary {
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.7);
		box-shadow: none;
	}

	.prog-hero__cta--secondary:hover {
		background: rgba(255, 255, 255, 0.12);
	}

	.prog-series {
		background: #fff;
		border-bottom: 1px solid #e3e3e3;
	}

	/* ─── Meta bar (live: pill audiences, inline meta) ─────── */
	.prog-meta {
		padding: 0;
		border-bottom: 1px solid #e3e3e3;
		background: #fff;
	}

	.prog-meta__inner {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2.5rem;
		align-items: center;
		padding: 1.1rem 0;
	}

	.prog-meta__group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.prog-meta__label {
		font-family: 'Rubik', sans-serif;
		font-size: 13px;
		font-weight: 400;
		color: rgb(90, 90, 90);
		margin: 0;
		white-space: nowrap;
	}

	.prog-meta__tags {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
	}

	.prog-meta__tag {
		display: inline-flex;
		align-items: center;
		min-height: 24px; /* WCAG touch-target minimum */
		padding: 5px 10px;
		border-radius: 6px;
		font-family: 'Rubik', sans-serif;
		font-size: 12px;
		font-weight: 500;
		color: #fff;
		line-height: 1;
		background: var(--accent-dark);
		text-decoration: none;
	}

	.prog-meta__tag--blue {
		background: #0071c1;
	}

	.prog-meta__tag:hover {
		background: rgb(154, 44, 39);
	}

	.prog-meta__value {
		font-family: 'Rubik', sans-serif;
		font-size: 13px;
		font-weight: 500;
		color: rgb(51, 51, 51);
	}

	.prog-facts {
		padding: 0;
		margin-bottom: 1.5rem;
	}

	.prog-facts__inner {
		display: grid;
		gap: 1.25rem;
	}

	.prog-facts__group {
		display: grid;
		gap: 0.75rem;
	}

	.prog-facts__heading {
		margin: 0;
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.05rem;
		font-weight: 500;
		color: rgb(51, 51, 51);
	}

	.prog-facts__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.prog-facts__chip {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem 0.85rem;
		border-radius: 999px;
		background: rgb(247, 247, 247);
		border: 1px solid rgba(0, 0, 0, 0.08);
		font-family: 'Rubik', sans-serif;
		font-size: 0.82rem;
		line-height: 1.2;
		color: rgb(61, 61, 61);
		text-decoration: none;
	}

	.prog-facts__chip--platform {
		background: rgba(0, 153, 255, 0.06);
	}

	.prog-facts__chip:hover {
		border-color: rgba(240, 93, 87, 0.28);
		color: rgb(240, 93, 87);
	}

	.prog-facts__icon {
		width: 18px;
		height: 18px;
		object-fit: contain;
		flex-shrink: 0;
	}

	/* ─── Main layout: facts + content + enquiry aside ─────── */
	.prog-main {
		padding: 1.5rem 0 2.5rem;
		display: grid;
		gap: 2rem;
	}

	.prog-main__body {
		min-width: 0;
	}

	@media (min-width: 960px) {
		.prog-main {
			grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
			gap: 2.5rem;
			align-items: start;
		}

		.prog-aside {
			position: sticky;
			top: 1.5rem;
		}
	}

	/* ─── Content body ─────────────────────────────────────── */
	.prog-body {
		min-width: 0;
	}

	.prog-body :global(h2) {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: 1.35rem;
		font-weight: 500;
		color: rgb(51, 51, 51);
		margin: 0 0 0.75rem;
	}

	.prog-body :global(h3) {
		font-family: 'Rubik', sans-serif;
		letter-spacing: 0;
		font-size: 1.05rem;
		font-weight: 300;
		color: var(--accent-dark);
		margin: 1.35rem 0 0.5rem;
	}

	.prog-body :global(h4),
	.prog-body :global(h5) {
		font-family: 'Rubik', sans-serif;
		letter-spacing: 0;
		font-size: 1rem;
		font-weight: 500;
		color: rgb(51, 51, 51);
		margin: 1.15rem 0 0.5rem;
	}

	.prog-body :global(p) {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin: 0 0 0.75rem;
	}

	.prog-body :global(ul),
	.prog-body :global(ol) {
		padding-left: 1.25rem;
		margin: 0 0 0.75rem;
	}

	.prog-body :global(li) {
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
		margin-bottom: 0.35rem;
	}

	.prog-body :global(a) {
		color: var(--accent-dark);
	}

	.prog-body :global(strong) {
		font-weight: 600;
	}

	/* ─── Tables (fees, schedules, etc.) ────────────────────── */
	/* Constrain the wrapping <figure> so wide tables scroll locally
	   instead of expanding the page and causing horizontal overflow. */
	.prog-body :global(figure) {
		margin: 0 0 1rem;
		overflow-x: auto;
		max-width: 100%;
	}

	.prog-body :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-family: 'Rubik', sans-serif;
		font-size: 0.92rem;
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
	}

	.prog-body :global(th),
	.prog-body :global(td) {
		padding: 0.5rem 0.65rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
		text-align: left;
		vertical-align: top;
	}

	.prog-body :global(th) {
		font-weight: 600;
	}

	/* Keep row-header cells visually distinct without a strong fill. */
	.prog-body :global(tr > th:first-child) {
		white-space: nowrap;
	}

	/* ─── Responsive ───────────────────────────────────────── */
	@media (max-width: 809px) {
		.prog-hero {
			min-height: 240px;
		}

		.prog-hero__text {
			padding-top: 60px;
			padding-bottom: 28px;
		}

		.prog-meta__inner {
			flex-direction: column;
			gap: 12px;
		}
	}
</style>
