---
import CtaBanner from '../../components/CtaBanner.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getSiteData } from '../../lib/data.js';
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import { getRouteDocument } from '../../lib/route-documents.js';

const SITE_ORIGIN = 'https://tinkercademy.com';

function shouldOpenInNewTab(href: string | null | undefined) {
	if (typeof href !== 'string' || !href.trim()) return false;

	const trimmedHref = href.trim();
	if (/^(mailto:|tel:)/i.test(trimmedHref)) return false;

	try {
		return new URL(trimmedHref, SITE_ORIGIN).origin !== SITE_ORIGIN;
	} catch {
		return false;
	}
}

export function getStaticPaths() {
	return getSiteData().programmes.map((programme: any) => ({
		params: { slug: programme.slug },
		props: { programme },
	}));
}

const { programme } = Astro.props as { programme: any };
const canonical = new URL(`/programmes/${programme.slug}`, 'https://tinkercademy.com').toString();

/* ─── Meta info ──────────────────────────────────────────────────── */
const audiences = programme.audiences ?? [];
const topicLabels = programme.topics?.map((t: any) => t.label) ?? [];
const domains = programme.domains ?? [];
const domainLabels = domains.length > 0 ? domains.map((domain: any) => domain.label) : topicLabels;
const platforms = programme.platforms ?? [];
const duration = programme.duration ?? '';
const primaryAudience = programme.audiences?.[0];
const signUpUrl = programme.sign_up_url ?? null;
const signUpLabel = programme.sign_up_label ?? 'Enquire now';
const signUpIsExternal = shouldOpenInNewTab(signUpUrl);
const routeDocument = getRouteDocument(`/programmes/${programme.slug}`);
const typeLabel =
	primaryAudience?.id === 'businesses' || primaryAudience?.id === 'public'
		? 'Corporate training'
		: topicLabels[0] ?? primaryAudience?.label ?? '';

const sections = (programme.sections ?? [])
	.map((section: any, index: number) => ({
		heading: section.heading ?? ['Course Overview', 'Lesson Outcomes', 'Details'][index] ?? `Section ${index + 1}`,
		html: section.html,
	}))
	.filter((section: any) => section.html);
---

{routeDocument ? (
	<DocumentLayout document={routeDocument} />
) : (
<>
<ContentLayout
	title={programme.seo?.title ?? programme.title}
	description={programme.seo?.description ?? programme.description ?? ''}
	canonical={canonical}
	image={programme.hero_image ?? undefined}
>
	{/* ════════ Hero: full-bleed image with dark overlay + text ════════ */}
	<section class="prog-hero">
		{programme.hero_image && (
			<img
				class="prog-hero__bg"
				src={programme.hero_image}
				alt={programme.title}
				loading="eager"
			/>
		)}
		<div class="prog-hero__overlay" />
		<div class="prog-hero__text shell">
			<p class="prog-hero__eyebrow">Content</p>
			<h1 class="prog-hero__title">{programme.title}</h1>
			{duration && <p class="prog-hero__duration">{duration}</p>}
			{signUpUrl && (
				<div class="prog-hero__actions">
					<a
						class="prog-hero__cta"
						href={signUpUrl}
						target={signUpIsExternal ? '_blank' : undefined}
						rel={signUpIsExternal ? 'noopener noreferrer' : undefined}
					>
						{signUpLabel}
					</a>
				</div>
			)}
		</div>
	</section>

	{/* ════════ Meta bar ═════════════════════════════════════════════ */}
	<section class="prog-meta">
		<div class="shell prog-meta__inner">
			{audiences.length > 0 && (
				<div class="prog-meta__group">
					<h4 class="prog-meta__label">Audiences:</h4>
					<div class="prog-meta__tags">
						{audiences.map((aud: any) => (
							<span
								class:list={[
									'prog-meta__tag',
									(aud.id === 'businesses' || aud.id === 'public') && 'prog-meta__tag--blue',
								]}
							>
								{aud.label}
							</span>
						))}
					</div>
				</div>
			)}
			{duration && (
				<div class="prog-meta__group">
					<h4 class="prog-meta__label">Duration:</h4>
					<span class="prog-meta__value">{duration}</span>
				</div>
			)}
			{typeLabel && (
				<div class="prog-meta__group">
					<h4 class="prog-meta__label">Type:</h4>
					<span class="prog-meta__value">{typeLabel}</span>
				</div>
			)}
		</div>
	</section>

	{(domainLabels.length > 0 || platforms.length > 0) && (
		<section class="prog-facts">
			<div class="shell prog-facts__inner">
				{domainLabels.length > 0 && (
					<div class="prog-facts__group">
						<h2 class="prog-facts__heading">Domains</h2>
						<div class="prog-facts__chips">
							{domainLabels.map((label: string) => (
								<span class="prog-facts__chip">{label}</span>
							))}
						</div>
					</div>
				)}
				{platforms.length > 0 && (
					<div class="prog-facts__group">
						<h2 class="prog-facts__heading">Platforms</h2>
						<div class="prog-facts__chips">
							{platforms.map((platform: any) => (
								<span class="prog-facts__chip prog-facts__chip--platform">
									{platform.icon && (
										<img
											class="prog-facts__icon"
											src={platform.icon}
											alt=""
											loading="lazy"
										/>
									)}
									<span>{platform.label}</span>
								</span>
							))}
						</div>
					</div>
				)}
			</div>
		</section>
	)}

	{/* ════════ Content sections with headings ═══════════════════════ */}
	<article class="prog-body shell prose">
		{sections.map((section: any) => (
			<div class="prog-section">
				<h2 class="prog-section__heading">{section.heading}</h2>
				<div set:html={section.html} />
			</div>
		))}
	</article>

	<CtaBanner />
</ContentLayout>

<style>
	/* ─── Hero ──────────────────────────────────────────────── */
	.prog-hero {
		position: relative;
		width: 100%;
		min-height: 380px;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
	}

	.prog-hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	.prog-hero__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.35) 0%,
			rgba(0, 0, 0, 0.55) 100%
		);
		z-index: 1;
	}

	.prog-hero__text {
		position: relative;
		z-index: 2;
		padding-top: 100px;
		padding-bottom: 48px;
	}

	.prog-hero__eyebrow {
		font-family: 'Rubik', sans-serif;
		font-size: 14px;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgba(255, 255, 255, 0.8);
		margin: 0 0 12px;
	}

	.prog-hero__title {
		font-family: 'Oswald', sans-serif;
		font-size: clamp(2rem, 4.5vw, 3.25rem);
		font-weight: 500;
		line-height: 1.05;
		text-transform: uppercase;
		color: #fff;
		margin: 0;
		max-width: 18ch;
	}

	.prog-hero__duration {
		margin: 0.75rem 0 0;
		font-family: 'Rubik', sans-serif;
		font-size: 1rem;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.88);
	}

	.prog-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1rem;
	}

	.prog-hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.1rem;
		border-radius: 999px;
		background: rgb(240, 93, 87);
		color: #fff;
		text-decoration: none;
		font-family: 'Rubik', sans-serif;
		font-size: 0.92rem;
		font-weight: 500;
		box-shadow: 0 12px 28px rgba(240, 93, 87, 0.28);
	}

	/* ─── Meta bar (live: pill audiences, inline meta) ─────── */
	.prog-meta {
		padding: 0;
		border-bottom: 1px solid #e3e3e3;
		background: #fff;
	}

	.prog-meta__inner {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2.5rem;
		align-items: center;
		padding: 1.1rem 0;
	}

	.prog-meta__group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.prog-meta__label {
		font-family: 'Rubik', sans-serif;
		font-size: 13px;
		font-weight: 400;
		color: rgb(90, 90, 90);
		margin: 0;
		white-space: nowrap;
	}

	.prog-meta__tags {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
	}

	.prog-meta__tag {
		display: inline-flex;
		align-items: center;
		padding: 5px 10px;
		border-radius: 6px;
		font-family: 'Rubik', sans-serif;
		font-size: 12px;
		font-weight: 500;
		color: #fff;
		line-height: 1;
		background: rgb(240, 93, 87);
	}

	.prog-meta__tag--blue {
		background: #0099ff;
	}

	.prog-meta__value {
		font-family: 'Rubik', sans-serif;
		font-size: 13px;
		font-weight: 500;
		color: rgb(51, 51, 51);
	}

	.prog-facts {
		padding: 1.5rem 0 0.5rem;
	}

	.prog-facts__inner {
		display: grid;
		gap: 1.25rem;
	}

	.prog-facts__group {
		display: grid;
		gap: 0.75rem;
	}

	.prog-facts__heading {
		margin: 0;
		font-family: 'Oswald', sans-serif;
		font-size: 1.05rem;
		font-weight: 500;
		text-transform: uppercase;
		color: rgb(51, 51, 51);
	}

	.prog-facts__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.prog-facts__chip {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem 0.85rem;
		border-radius: 999px;
		background: rgb(247, 247, 247);
		border: 1px solid rgba(0, 0, 0, 0.08);
		font-family: 'Rubik', sans-serif;
		font-size: 0.82rem;
		line-height: 1.2;
		color: rgb(61, 61, 61);
	}

	.prog-facts__chip--platform {
		background: rgba(0, 153, 255, 0.06);
	}

	.prog-facts__icon {
		width: 18px;
		height: 18px;
		object-fit: contain;
		flex-shrink: 0;
	}

	/* ─── Content body ─────────────────────────────────────── */
	.prog-body {
		padding-top: 2rem;
		padding-bottom: 2rem;
	}

	.prog-section {
		margin-bottom: 2rem;
	}

	.prog-section__heading {
		font-family: 'Oswald', sans-serif;
		font-size: 1.35rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: rgb(51, 51, 51);
		margin: 0 0 0.75rem;
	}

	.prog-section :global(p) {
		font-family: 'Rubik', sans-serif;
		font-size: 15px;
		line-height: 1.65;
		color: rgb(51, 51, 51);
		margin: 0 0 0.75rem;
	}

	.prog-section :global(ul) {
		padding-left: 1.25rem;
		margin: 0 0 0.75rem;
	}

	.prog-section :global(li) {
		font-family: 'Rubik', sans-serif;
		font-size: 15px;
		line-height: 1.65;
		color: rgb(51, 51, 51);
		margin-bottom: 0.35rem;
	}

	.prog-section :global(strong) {
		font-weight: 600;
	}

	/* ─── Responsive ───────────────────────────────────────── */
	@media (max-width: 809px) {
		.prog-hero {
			min-height: 240px;
		}

		.prog-hero__text {
			padding-top: 60px;
			padding-bottom: 28px;
		}

		.prog-meta__inner {
			flex-direction: column;
			gap: 12px;
		}
	}
</style>
</>
)}
