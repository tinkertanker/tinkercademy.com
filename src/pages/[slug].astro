---
import ContentBlocks from '../components/ContentBlocks.astro';
import BannerLayers from '../components/BannerLayers.astro';
import CourseGrid from '../components/CourseGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';
import HeroMedia from '../components/HeroMedia.astro';
import LogoCarouselSection from '../components/LogoCarouselSection.astro';
import PageHero from '../components/PageHero.astro';
import RichContent from '../components/RichContent.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getBannerAsset } from '../lib/banner-assets';
import { getSiteData, getNavPillsForPage } from '../lib/data.js';
import { getClientLogoItems, getPartnerLogoItems } from '../lib/logos';
import { getResponsiveImage } from '../lib/responsive-images.js';
import {
	buildProgrammeCardOverrides,
	getProgrammeFilterLabels,
	getProgrammesForSurface,
	toProgrammeCardData,
} from '../lib/programmes.ts';

export function getStaticPaths() {
	/* Pages with dedicated .astro files — exclude from the dynamic catch-all */
	const dedicatedPages = new Set([
		'about-us', 'contact-us', 'showcase', 'microbit', 'tinker-x', 'infocomm-club', 'professionals', 'schools', 'individuals',
	]);
	const site = getSiteData();
	return site.staticPages
		.filter((page: any) => page.path !== '/')
		.filter((page: any) => !page.path.startsWith('/programmes/') && !page.path.startsWith('/tutorials/'))
		.filter((page: any) => page.path.split('/').filter(Boolean).length === 1)
		.filter((page: any) => !dedicatedPages.has(page.slug))
		.map((page: any) => ({
			params: { slug: page.slug },
			props: { page },
		}));
}

const { page } = Astro.props as { page: any };
const site = getSiteData();
const canonicalPath = page.path.endsWith('/') ? page.path : `${page.path}/`;
const canonical = new URL(canonicalPath, 'https://tinkercademy.com').toString();

/* ─── Classify page type ────────────────────────────────────────────── */
const COURSE_LISTING_SLUGS = ['courses-all', 'courses-professionals', 'courses-schools'];
const isCourseListing = COURSE_LISTING_SLUGS.includes(page.slug);

/* ─── Data for course listing / audience pages ──────────────────────── */
const listingSurfaceBySlug = {
	'courses-all': 'all',
	'courses-professionals': 'professionals',
	'courses-schools': 'schools',
} as const;
const listingSurface = isCourseListing
	? listingSurfaceBySlug[page.slug as keyof typeof listingSurfaceBySlug]
	: 'all';
const cardOverrides = isCourseListing ? buildProgrammeCardOverrides(page.course_cards ?? []) : null;
const programmes = isCourseListing
	? (await getProgrammesForSurface(listingSurface)).map((programme) =>
			toProgrammeCardData(programme, cardOverrides?.get(programme.slug), {
				badgeBasePath: canonicalPath,
			}),
		)
	: [];
const navPills = isCourseListing
	? getNavPillsForPage(page)
	: [];
const filterLabels = isCourseListing ? getProgrammeFilterLabels() : null;
const partnerLogos = page.slug === 'courses-all' ? getPartnerLogoItems(site.externalLogos) : [];
const clientLogos = page.slug === 'courses-all' ? getClientLogoItems(site.externalLogos) : [];
const courseAllHeroImage = page.hero_image ?? '/images/banners/courses-all.webp';
const courseAllHero = getResponsiveImage(courseAllHeroImage);
const courseBanner = getBannerAsset(courseAllHeroImage);
const courseHeroPreload =
	page.slug === 'courses-all' && courseBanner
		? { src: courseBanner.background }
		: page.slug === 'courses-all' && courseAllHero
			? { src: courseAllHero.src, srcset: courseAllHero.srcset, sizes: '100vw' }
		: null;
const courseAllLead =
	'Hands-on coding, AI, app development, web, digital making, and tech productivity programmes for schools, professionals, corporate teams, and public learners.';
const courseAllHighlights = [
	{
		title: 'For Classrooms and Teams',
		body: 'Run a structured school programme, upskill a professional team, or bring hands-on technology learning to a public or community audience.',
	},
	{
		title: 'Across Modern Tech',
		body: 'Explore AI, data, app development, web, robotics, digital making, micro:bit, Arduino, Raspberry Pi, and other practical platforms.',
	},
	{
		title: 'Taught by Builders',
		body: 'Learn from coders, makers, and curriculum designers who build real projects and translate that practice into clear, usable lessons.',
	},
];

/* ─── Course listing page titles (the title field is a slug in the data) */
const COURSE_PAGE_TITLES: Record<string, string> = {
	'courses-all': 'All Courses',
	'courses-professionals': 'Professional Courses',
	'courses-schools': 'School Courses',
};
const displayTitle = isCourseListing
	? COURSE_PAGE_TITLES[page.slug] ?? page.title
	: page.title;

/* ─── Per-route SEO overrides ───────────────────────────────────────────
   Intentionally not sourced from `page.seo` — the imported Framer data
   uses the same default title and description on most routes, which is
   exactly the SEO mistake we're fixing here. Keyed by slug; extend as new
   catch-all pages are added. */
const SEO_OVERRIDES: Record<string, { title: string; description: string }> = {
	'courses-all': {
		title: 'All courses — Tinkercademy',
		description:
			'Browse every Tinkercademy programme in one place. Coding, AI, web and mobile development, digital making, and more — for schools, professionals, and individuals.',
	},
	'courses-professionals': {
		title: 'Professional courses — Tinkercademy',
		description:
			'Browse our professional training catalogue — AI, full-stack web, mobile, Unity, and digital making — delivered by expert instructors in Singapore.',
	},
	'courses-schools': {
		title: 'School courses — Tinkercademy',
		description:
			'Coding, AI, and digital making programmes for MOE primary, secondary, and junior college schools, including Code for Fun and the LEARN Roadmap.',
	},
};
const seoOverride = SEO_OVERRIDES[page.slug as string];
const seoTitle = seoOverride?.title ?? page.seo?.title ?? displayTitle;
const seoDescription =
	seoOverride?.description ?? page.seo?.description ?? page.description ?? '';

/* ─── Determine if content has rich types (image / richtext) ────────── */
const contentBlocks = page.content ?? [];
const hasRichContent = contentBlocks.some(
	(block: any) => block.type === 'image' || block.type === 'richtext',
);
---

<ContentLayout
	title={seoTitle}
	description={seoDescription}
	canonical={canonical}
	image={page.hero_image ?? undefined}
	preloadHero={courseHeroPreload}
>
	{isCourseListing ? (
		<>
			{isCourseListing && (
				<>
					<section class="course-hero">
						<BannerLayers src={courseAllHeroImage} />
						<div class="course-hero__scrim"></div>
						<div class="course-hero__content shell">
							<h1 class="course-hero__title">{displayTitle}</h1>
							{page.slug === 'courses-all' && <p class="course-hero__lead">{courseAllLead}</p>}
						</div>
					</section>
					<LogoCarouselSection
						title="Our Partners"
						logos={partnerLogos}
						minItems={24}
						secondsPerLogo={6}
					/>
					<section class="course-proof">
						<div class="shell">
							<div class="course-proof__intro">
								<h2>Courses That Meet Learners Where They Are</h2>
								<p>
									Our catalogue brings together the formats we deliver most often, from MOE
									classrooms to corporate workshops and public learning programmes.
								</p>
							</div>
							<div class="course-proof__grid">
								{courseAllHighlights.map((item) => (
									<article class="course-proof__item">
										<h3>{item.title}</h3>
										<p>{item.body}</p>
									</article>
								))}
							</div>
						</div>
					</section>
					<LogoCarouselSection
						title="Our Clients"
						logos={clientLogos}
						muted={true}
						minItems={30}
						secondsPerLogo={4}
					/>
				</>
			)}
			<CourseGrid
				programmes={programmes}
				pageTitle={displayTitle}
				navPills={navPills}
				pagePath={canonicalPath}
				filterLabels={filterLabels ?? undefined}
			/>
		</>
	) : (
		<>
			<PageHero title={displayTitle} lead={page.description} />
			{page.hero_image && (
				<HeroMedia src={page.hero_image} alt={displayTitle} compact={true} />
			)}
			{contentBlocks.length > 0 && (
				hasRichContent
					? <RichContent items={contentBlocks} />
					: <ContentBlocks blocks={contentBlocks} />
			)}
			<CtaBanner />
		</>
	)}
</ContentLayout>

<style>
	.course-hero {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		min-height: 480px;
		overflow: clip;
		background: #161111;
	}

	.course-hero__scrim {
		position: absolute;
		inset: 0;
		background: var(--hero-desktop-scrim);
	}

	.course-hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: inherit;
		padding: clamp(4rem, 8vw, 6rem) 0 clamp(2.75rem, 5vw, 4rem);
		gap: 0.9rem;
	}

	.course-hero__title {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: var(--page-title-font-size);
		font-weight: 500;
		line-height: 0.95;
		color: #fff;
		margin: 0;
		max-width: min(10ch, var(--hero-title-max-width));
		text-wrap: balance;
		text-shadow: var(--hero-title-glow);
	}

	.course-hero__lead {
		font-family: 'Rubik', sans-serif;
		font-size: var(--lead-font-size);
		line-height: var(--lead-line-height);
		color: rgba(255, 255, 255, 0.94);
		margin: 0;
		max-width: 52ch;
	}

	.course-proof {
		padding: 0.5rem 0 3.25rem;
	}

	.course-proof__intro {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr);
		gap: clamp(1.25rem, 4vw, 3rem);
		align-items: start;
		margin-bottom: 1.5rem;
	}

	.course-proof__intro h2 {
		font-family: 'IBM Plex Serif', Georgia, serif;
		letter-spacing: -0.03em;
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 500;
		color: rgb(23, 23, 23);
		margin: 0;
	}

	.course-proof__intro p {
		margin: 0;
		max-width: 60rem;
		font-family: 'Rubik', sans-serif;
		font-size: var(--body-font-size);
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
	}

	.course-proof__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.course-proof__item {
		border: 1px solid rgb(229, 229, 229);
		border-radius: 8px;
		background: #fff;
		padding: 1.25rem;
	}

	.course-proof__item h3 {
		font-family: 'Rubik', sans-serif;
		font-size: 0.78rem;
		letter-spacing: 0.03em;
		/* accent-dark, not accent: text on white needs 4.5:1 (WCAG AA) */
		color: var(--accent-dark);
		margin: 0 0 0.75rem;
	}

	.course-proof__item p {
		margin: 0;
		font-family: 'Rubik', sans-serif;
		font-size: 0.95rem;
		line-height: var(--body-line-height);
		color: rgb(51, 51, 51);
	}

	@media (max-width: 809px) {
		.course-hero {
			min-height: var(--hero-mobile-min-height);
		}

		.course-hero__scrim {
			background: var(--hero-mobile-scrim);
		}

		.course-hero__content {
			padding-block-start: var(--hero-mobile-content-top);
			padding-block-end: 2.5rem;
		}

		.course-proof__intro,
		.course-proof__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
