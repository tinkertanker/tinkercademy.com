---
import ContentBlocks from '../components/ContentBlocks.astro';
import CourseGrid from '../components/CourseGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';
import HeroMedia from '../components/HeroMedia.astro';
import PageHero from '../components/PageHero.astro';
import RichContent from '../components/RichContent.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { getSiteData, getNavPillsForPage } from '../lib/data.js';
import {
	buildProgrammeCardOverrides,
	getProgrammeFilterLabels,
	getProgrammesForSurface,
	toProgrammeCardData,
} from '../lib/programmes.ts';

export function getStaticPaths() {
	/* Pages with dedicated .astro files — exclude from the dynamic catch-all */
	const dedicatedPages = new Set([
		'about-us', 'contact-us', 'showcase', 'microbit', 'tinker-x', 'infocomm-club', 'professionals', 'schools', 'individuals',
	]);
	const site = getSiteData();
	return site.staticPages
		.filter((page: any) => page.path !== '/')
		.filter((page: any) => !page.path.startsWith('/programmes/') && !page.path.startsWith('/tutorials/'))
		.filter((page: any) => page.path.split('/').filter(Boolean).length === 1)
		.filter((page: any) => !dedicatedPages.has(page.slug))
		.map((page: any) => ({
			params: { slug: page.slug },
			props: { page },
		}));
}

const { page } = Astro.props as { page: any };
const canonical = new URL(page.path, 'https://tinkercademy.com').toString();

/* ─── Classify page type ────────────────────────────────────────────── */
const COURSE_LISTING_SLUGS = ['courses-all', 'courses-professionals', 'courses-schools'];
const isCourseListing = COURSE_LISTING_SLUGS.includes(page.slug);

/* ─── Data for course listing / audience pages ──────────────────────── */
const listingSurfaceBySlug = {
	'courses-all': 'all',
	'courses-professionals': 'professionals',
	'courses-schools': 'schools',
} as const;
const listingSurface = isCourseListing
	? listingSurfaceBySlug[page.slug as keyof typeof listingSurfaceBySlug]
	: 'all';
const cardOverrides = isCourseListing ? buildProgrammeCardOverrides(page.course_cards ?? []) : null;
const programmes = isCourseListing
	? (await getProgrammesForSurface(listingSurface)).map((programme) =>
			toProgrammeCardData(programme, cardOverrides?.get(programme.slug), {
				badgeBasePath: page.path,
			}),
		)
	: [];
const navPills = isCourseListing
	? getNavPillsForPage(page)
	: [];
const filterLabels = isCourseListing ? getProgrammeFilterLabels() : null;

/* ─── Course listing page titles (the title field is a slug in the data) */
const COURSE_PAGE_TITLES: Record<string, string> = {
	'courses-all': 'All Courses',
	'courses-professionals': 'Professional Courses',
	'courses-schools': 'School Courses',
};
const displayTitle = isCourseListing
	? COURSE_PAGE_TITLES[page.slug] ?? page.title
	: page.title;

/* ─── Per-route SEO overrides ───────────────────────────────────────────
   Intentionally not sourced from `page.seo` — the imported Framer data
   uses the same default title and description on most routes, which is
   exactly the SEO mistake we're fixing here. Keyed by slug; extend as new
   catch-all pages are added. */
const SEO_OVERRIDES: Record<string, { title: string; description: string }> = {
	'courses-all': {
		title: 'All courses — Tinkercademy',
		description:
			'Browse every Tinkercademy programme in one place. Coding, AI, web and mobile development, digital making, and more — for schools, professionals, and individuals.',
	},
	'courses-professionals': {
		title: 'Professional courses — Tinkercademy',
		description:
			'Browse our professional training catalogue — AI, full-stack web, mobile, Unity, and digital making — delivered by expert instructors in Singapore.',
	},
	'courses-schools': {
		title: 'School courses — Tinkercademy',
		description:
			'Coding, AI, and digital making programmes for MOE primary, secondary, and junior college schools, including Code for Fun and the LEARN Roadmap.',
	},
};
const seoOverride = SEO_OVERRIDES[page.slug as string];
const seoTitle = seoOverride?.title ?? page.seo?.title ?? displayTitle;
const seoDescription =
	seoOverride?.description ?? page.seo?.description ?? page.description ?? '';

/* ─── Determine if content has rich types (image / richtext) ────────── */
const contentBlocks = page.content ?? [];
const hasRichContent = contentBlocks.some(
	(block: any) => block.type === 'image' || block.type === 'richtext',
);
---

<ContentLayout
	title={seoTitle}
	description={seoDescription}
	canonical={canonical}
	image={page.hero_image ?? undefined}
>
	{isCourseListing ? (
		<CourseGrid
			programmes={programmes}
			pageTitle={displayTitle}
			navPills={navPills}
			pagePath={page.path}
			filterLabels={filterLabels ?? undefined}
		/>
	) : (
		<>
			<PageHero title={displayTitle} lead={page.description} />
			{page.hero_image && (
				<HeroMedia src={page.hero_image} alt={displayTitle} compact={true} />
			)}
			{contentBlocks.length > 0 && (
				hasRichContent
					? <RichContent items={contentBlocks} />
					: <ContentBlocks blocks={contentBlocks} />
			)}
			<CtaBanner />
		</>
	)}
</ContentLayout>
